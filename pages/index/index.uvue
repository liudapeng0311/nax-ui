<template>
	<scroll-view style="flex:1" scroll-y="true">
		<view class="nax-theme home" :class="themeExtraClass">
			<view class="home__header">
				<view class="home__header-text">
					<text class="home__title">nax-ui</text>
					<text class="home__desc">uni-app x 通用 UI 演示（主题：nax-ui-theme）</text>
				</view>
				<nax-button
					size="sm"
					:type="darkMode ? 'primary' : 'default'"
					:variant="darkMode ? 'solid' : 'secondary'"
					:label="themeToggleLabel"
					@click="toggleDarkMode"
				></nax-button>
			</view>

			<view class="home__section">
				<text class="home__section-title">基础组件</text>
				<view class="home__card" @click="goButton">
					<text class="home__card-name">按钮</text>
					<text class="home__card-tag">nax-button</text>
				</view>
				<view class="home__card home__card--gap" @click="goIcon">
					<text class="home__card-name">图标</text>
					<text class="home__card-tag">nax-icon</text>
				</view>
				<view class="home__card home__card--gap" @click="goTag">
					<text class="home__card-name">标签</text>
					<text class="home__card-tag">nax-tag</text>
				</view>
				<view class="home__card home__card--gap" @click="goBadge">
					<text class="home__card-name">徽标</text>
					<text class="home__card-tag">nax-badge</text>
				</view>
				<view class="home__card home__card--gap" @click="goAvatar">
					<text class="home__card-name">头像</text>
					<text class="home__card-tag">nax-avatar</text>
				</view>
				<view class="home__card home__card--gap" @click="goImage">
					<text class="home__card-name">图片</text>
					<text class="home__card-tag">nax-image</text>
				</view>
			</view>

			<view class="home__section home__section--gap">
				<text class="home__section-title">布局组件</text>
				<view class="home__card" @click="goSwiper">
					<text class="home__card-name">轮播</text>
					<text class="home__card-tag">nax-swiper</text>
				</view>
			</view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import { bindDemoThemePage, setDemoDarkMode } from '@/common/demo-theme.uts'

	// setup 同步读全局，避免首帧 false 白闪
	const darkMode = ref(bindDemoThemePage())

	const themeExtraClass = computed((): string => {
		if (darkMode.value) {
			return 'nax-theme-dark'
		}
		return ''
	})

	const themeToggleLabel = computed((): string => {
		if (darkMode.value) {
			return '浅色'
		}
		return '深色'
	})

	function toggleDarkMode() {
		const next = !darkMode.value
		darkMode.value = next
		setDemoDarkMode(next)
	}

	onShow(() => {
		darkMode.value = bindDemoThemePage()
	})

	function goButton() {
		uni.navigateTo({
			url: '/pages/components/button/index'
		})
	}

	function goIcon() {
		uni.navigateTo({
			url: '/pages/components/icon/index'
		})
	}

	function goTag() {
		uni.navigateTo({
			url: '/pages/components/tag/index'
		})
	}

	function goBadge() {
		uni.navigateTo({
			url: '/pages/components/badge/index'
		})
	}

	function goAvatar() {
		uni.navigateTo({
			url: '/pages/components/avatar/index'
		})
	}

	function goImage() {
		uni.navigateTo({
			url: '/pages/image/index'
		})
	}

	function goSwiper() {
		uni.navigateTo({
			url: '/pages/components/swiper/index'
		})
	}
</script>

<style>
	.home {
		padding: 20px;
		background-color: var(--nax-color-bg-secondary, #fafafc);
		flex: 1;
	}

	.home__header {
		flex-direction: row;
		align-items: flex-start;
		justify-content: space-between;
		margin-bottom: 20px;
	}

	.home__header-text {
		flex: 1;
		margin-right: 12px;
		flex-direction: column;
	}

	.home__title {
		font-size: 22px;
		color: var(--nax-color-text, #333639);
		font-weight: 600;
		margin-bottom: 6px;
	}

	.home__desc {
		font-size: 13px;
		color: var(--nax-color-text-secondary, #767c82);
	}

	.home__section {
		flex-direction: column;
	}

	.home__section--gap {
		margin-top: 20px;
	}

	.home__section-title {
		font-size: 13px;
		font-weight: 500;
		color: var(--nax-color-text-secondary, #767c82);
		margin-bottom: 8px;
	}

	.home__card {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding-top: 10px;
		padding-bottom: 10px;
		padding-left: 12px;
		padding-right: 12px;
		background-color: var(--nax-color-bg, #ffffff);
		border-radius: var(--nax-radius-md, 8px);
		border-width: 1px;
		border-style: solid;
		border-color: var(--nax-color-border, #e0e0e6);
	}

	.home__card--gap {
		margin-top: 8px;
	}

	.home__card-name {
		font-size: 14px;
		color: var(--nax-color-text, #333639);
		font-weight: 500;
	}

	.home__card-tag {
		font-size: 12px;
		color: var(--nax-color-text-secondary, #767c82);
	}
</style>

