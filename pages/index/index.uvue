<script setup lang="uts">
	import { bindDemoThemePage, setDemoDarkMode } from '@/common/demo-theme.uts'

	// setup 同步读全局，避免首帧 false 白闪
	const darkMode = ref(bindDemoThemePage())

	const themeExtraClass = computed((): string => {
		if (darkMode.value) {
			return 'nax-theme-dark'
		}
		return ''
	})

	const themeToggleLabel = computed((): string => {
		if (darkMode.value) {
			return '浅色'
		}
		return '深色'
	})

	function toggleDarkMode() {
		const next = !darkMode.value
		darkMode.value = next
		setDemoDarkMode(next)
	}

	onShow(() => {
		darkMode.value = bindDemoThemePage()
	})

	function goText() {
		uni.navigateTo({
			url: '/pages/components/text/index'
		})
	}

	function goButton() {
		uni.navigateTo({
			url: '/pages/components/button/index'
		})
