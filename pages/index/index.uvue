		/* #endif */
	}

	.stats__label {
		font-size: 12px;
		color: var(--nax-color-text-secondary, #767c82);
	}

	.stats__divider {
		width: 1px;
		height: 28px;
		background-color: var(--nax-color-divider, #f5f5f7);
	}

	.block {
		margin-bottom: 12px;
		border-radius: 5px;
		overflow: hidden;
	}

	.section {
		flex-direction: column;
		margin-bottom: 16px;
	}

	.section--last {
		margin-bottom: 8px;
	}

	.section__head {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 10px;
		padding-left: 2px;
		padding-right: 2px;
	}

	.section__title {
		font-size: 16px;
		font-weight: 600;
		color: var(--nax-color-text, #333639);
	}

