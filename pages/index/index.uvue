	}

	.scene-card__row {
		flex-direction: row;
		align-items: center;
		margin-bottom: 4px;
	}

	.scene-card__name {
		font-size: 15px;
		font-weight: 500;
		color: var(--nax-color-text, #333639);
		margin-right: 8px;
	}

	.scene-card__desc {
		font-size: 12px;
