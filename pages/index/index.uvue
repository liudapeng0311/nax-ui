		font-size: 12px;
		color: var(--nax-color-text-secondary, #767c82);
	}

	.hero__desc {
		font-size: 13px;
		line-height: 20px;
		color: var(--nax-color-text-secondary, #767c82);
		margin-bottom: 14px;
	}

	.hero__actions {
		flex-direction: row;
		align-items: center;
	}

	.hero__gap {
		width: 10px;
	}

	.stats {
		flex-direction: row;
		align-items: center;
		padding: 14px 8px;
		border-radius: 5px;
		background-color: var(--nax-color-bg, #ffffff);
		border-width: 1px;
		border-style: solid;
		border-color: var(--nax-color-border, #f0f0f3);
		margin-bottom: 12px;
	}

	.stats__item {
		flex: 1;
		flex-direction: column;
