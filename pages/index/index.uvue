<template>
	<view class="page-root nax-theme" :class="themeExtraClass">
		<nax-nav-bar
			title="nax-ui"
			:show-back="false"
			:border="false"
			type="primary"
			home-url="/pages/index/index"
		>
			<template #right>
				<view class="nav-action" @click="goMine">
					<nax-icon name="settings" size="20" color="#ffffff"></nax-icon>
				</view>
			</template>
		</nax-nav-bar>

		<scroll-view class="page-scroll" scroll-y="true">
			<view class="nax-theme page" :class="themeExtraClass">
				<!-- Hero -->
				<view class="hero">
					<view class="hero__top">
						<view class="hero__brand">
							<view class="hero__logo">
								<image class="hero__logo-img" src="/static/logo.png" mode="aspectFill"></image>
							</view>
							<view class="hero__titles">
								<text class="hero__name">nax-ui</text>
								<text class="hero__slogan">uni-app x 通用 UI 组件库</text>
							</view>
						</view>
						<nax-tag type="success" variant="solid" size="sm" round label="v1.0"></nax-tag>
					</view>
					<text class="hero__desc">蒸汽模式优先 · CSS 变量主题 · 多端一致体验</text>
					<view class="hero__actions">
						<nax-button type="primary" size="md" label="浏览组件" icon="category" @click="goCatalog"></nax-button>
						<view class="hero__gap"></view>
						<nax-button size="md" variant="secondary" label="场景示例" icon="star" @click="goScenes"></nax-button>
					</view>
				</view>

				<!-- Stats：数值统一用 string，避免鸿蒙 text 绑到非字符串/对象时整段 JSON 化 -->
				<view class="stats">
					<view class="stats__item">
						<text class="stats__num" :lines="1">{{ totalCountText }}</text>
						<text class="stats__label" :lines="1">组件</text>
					</view>
					<view class="stats__divider"></view>
					<view class="stats__item">
						<text class="stats__num" :lines="1">4</text>
						<text class="stats__label" :lines="1">分类</text>
					</view>
					<view class="stats__divider"></view>
					<view class="stats__item">
						<text class="stats__num" :lines="1">3</text>
						<text class="stats__label" :lines="1">场景</text>
					</view>
					<view class="stats__divider"></view>
					<view class="stats__item">
						<text class="stats__num" :lines="1">多端</text>
						<text class="stats__label" :lines="1">兼容</text>
					</view>
				</view>

				<!-- Notice -->
				<view class="block">
					<nax-notice-bar
						type="primary"
						:list="noticeList"
						:show-more="false"
					></nax-notice-bar>
				</view>

				<!-- Scenes preview：字段已在 script 预解析为 string，模板只绑字符串 -->
				<view class="section section--last">
					<view class="section__head">
						<text class="section__title">场景示例</text>
						<text class="section__more" @click="goScenes">更多</text>
					</view>
					<view
						v-for="(scene, sIndex) in sceneRows"
						:key="sIndex"
						class="scene-card"
						@click="onOpenScene(sIndex)"
					>
						<view class="scene-card__icon">
							<nax-icon :name="sceneIcon(sIndex)" size="22" color="#18a058"></nax-icon>
						</view>
						<view class="scene-card__body">
							<view class="scene-card__row">
								<text class="scene-card__name" :lines="1">{{ sceneTitle(sIndex) }}</text>
								<nax-tag type="primary" variant="light" size="sm" :label="sceneTag(sIndex)"></nax-tag>
							</view>
							<text class="scene-card__desc" :lines="2">{{ sceneDesc(sIndex) }}</text>
						</view>
						<nax-icon name="chevron-right" size="18" color="#e5e5ea"></nax-icon>
					</view>
				</view>
			</view>
		</scroll-view>

		<nax-tabbar
			:model-value="0"
			:list="tabList"
			@change="onTabChange"
		></nax-tabbar>
	</view>
</template>

<script setup lang="uts">
	import { bindDemoThemePage } from '@/common/demo-theme.uts'
	import {
		demoTabList,
		switchDemoTab,
		openDemoPage,
		demoCountByGroup,
		demoSceneList,
		demoReadString,
		hideDemoNativeTabBar
	} from '@/common/demo-catalog.uts'

	const darkMode = ref(bindDemoThemePage())

	const themeExtraClass = computed((): string => {
		if (darkMode.value) {
			return 'nax-theme-dark'
		}
		return ''
	})

	const tabList = demoTabList()
	// 鸿蒙：text 节点必须是 string；number 直接插值在部分机型会异常
	const totalCountText = demoCountByGroup('all').toString()
	const noticeList = [
		'主题色来自主题包 nax-ui-theme，主色 18a058。可在「我的」切换深色模式。',
		'组件均 CSS 变量主题，蒸汽模式优先，适配应用、鸿蒙、网页与小程序。'
	] as string[]

	// 预拆成平行 string 数组，模板不直接绑 any 对象，避免鸿蒙把对象 toString 成 JSON
	const sceneTitles = [] as string[]
	const sceneDescs = [] as string[]
	const sceneIcons = [] as string[]
	const sceneTags = [] as string[]
	const scenePaths = [] as string[]
	const rawScenes = demoSceneList()
	for (let i = 0; i < rawScenes.length; i++) {
		const item = rawScenes[i]
		let title = demoReadString(item, 'name')
		if (title.length == 0) {
			title = demoReadString(item, 'title')
		}
		sceneTitles.push(title)
		sceneDescs.push(demoReadString(item, 'desc'))
		sceneIcons.push(demoReadString(item, 'icon'))
		let tag = demoReadString(item, 'tag')
		if (tag.length == 0) {
			tag = '示例'
		}
		sceneTags.push(tag)
		scenePaths.push(demoReadString(item, 'path'))
	}
	// v-for 只需长度占位；真正文案走下面的 getter，保证返回 string
	const sceneRows = sceneTitles

	function sceneTitle(index : number) : string {
		if (index < 0 || index >= sceneTitles.length) {
			return ''
		}
		return sceneTitles[index]
	}

	function sceneDesc(index : number) : string {
		if (index < 0 || index >= sceneDescs.length) {
			return ''
		}
		return sceneDescs[index]
	}

	function sceneIcon(index : number) : string {
		if (index < 0 || index >= sceneIcons.length) {
			return 'star'
		}
		const name = sceneIcons[index]
		if (name.length == 0) {
			return 'star'
		}
		return name
	}

	function sceneTag(index : number) : string {
		if (index < 0 || index >= sceneTags.length) {
			return '示例'
		}
		return sceneTags[index]
	}

	function onOpenScene(index : number) {
		if (index < 0 || index >= scenePaths.length) {
			return
		}
		openDemoPage(scenePaths[index])
	}

	function goCatalog() {
		switchDemoTab(1)
	}

	function goScenes() {
		switchDemoTab(2)
	}

	function goMine() {
		switchDemoTab(3)
	}

	function onTabChange(index : number) {
		if (index == 0) {
			return
		}
		switchDemoTab(index)
	}

	onShow(() => {
		hideDemoNativeTabBar()
		darkMode.value = bindDemoThemePage()
	})
</script>

<style>
	.page-root {
		flex: 1;
		flex-direction: column;
		/* #ifndef APP-ANDROID || APP-IOS || APP-HARMONY */
		height: 100%;
		/* #endif */
		background-color: var(--nax-color-bg-secondary, #fafafc);
	}

	.page-scroll {
		flex: 1;
		height: 0;
	}

	.page {
		flex-direction: column;
		padding: 12px 16px 24px 16px;
		background-color: var(--nax-color-bg-secondary, #fafafc);
	}

	.nav-action {
		flex-direction: row;
		align-items: center;
		justify-content: center;
		padding-left: 8px;
		padding-right: 4px;
		height: 36px;
	}

	.hero {
		flex-direction: column;
		padding: 18px 16px 16px 16px;
		border-radius: 5px;
		background-color: var(--nax-color-bg, #ffffff);
		border-width: 1px;
		border-style: solid;
		border-color: var(--nax-color-border, #f0f0f3);
		margin-bottom: 12px;
	}

	.hero__top {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 12px;
	}

	.hero__brand {
		flex: 1;
		flex-direction: row;
		align-items: center;
	}

	.hero__logo {
		width: 44px;
		height: 44px;
		border-radius: 12px;
		overflow: hidden;
		flex-direction: row;
		align-items: center;
