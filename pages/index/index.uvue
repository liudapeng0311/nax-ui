<template>
	<view class="page-root nax-theme" :class="themeExtraClass" :style="pageRootStyle">
		<nax-nav-bar
			title="nax-ui"
			:show-back="false"
			:border="false"
			:type="navType"
			home-url="/pages/index/index"
			:fixed="chromeFixed"
			:placeholder="chromeFixed"
		>
			<template #right>
				<view class="nav-action" @click="goMine">
					<nax-icon name="settings" size="20" :color="navIconColor"></nax-icon>
				</view>
			</template>
		</nax-nav-bar>

		<view class="page-body" :class="darkClass('home-page--dark')" :style="pageBodyStyle">
			<scroll-view class="page-scroll" :class="darkClass('home-page--dark')" :style="pageScrollStyle">
				<view class="nax-theme page" :class="themeExtraClass">
					<!-- 首帧兜底：即使子组件异常，也能看到原生文本 -->
					<text v-if="!contentReady" class="boot-tip" :class="darkClass('home-boot--dark')">{{ bootTip }}</text>

					<view v-if="contentReady" class="hero" :class="darkClass('home-surface--dark')">
						<view class="hero__top">
							<view class="hero__brand">
								<view class="hero__logo" :class="darkClass('home-surface--dark')">
									<image class="hero__logo-img" src="/static/logo.png" mode="aspectFill"></image>
								</view>
								<view class="hero__titles">
									<text class="hero__name" :class="darkClass('home-text--dark')">nax-ui</text>
									<text class="hero__slogan" :class="darkClass('home-text-secondary--dark')">uni-app x 通用 UI 组件库</text>
								</view>
							</view>
							<nax-tag type="success" variant="solid" size="sm" round label="v1.0"></nax-tag>
						</view>
						<text class="hero__desc" :class="darkClass('home-text-secondary--dark')">蒸汽模式优先 · CSS 变量主题 · 多端一致体验</text>
						<view class="hero__actions">
							<nax-button type="primary" size="md" label="浏览组件" icon="category" @click="goCatalog"></nax-button>
							<view class="hero__gap"></view>
							<nax-button size="md" variant="secondary" label="场景示例" icon="star" @click="goScenes"></nax-button>
						</view>
					</view>

					<view v-if="contentReady" class="stats" :class="darkClass('home-surface--dark')">
						<view class="stats__item">
							<text class="stats__num" :max-lines="1" :class="darkClass('home-text-primary--dark')">{{ totalCountText }}</text>
							<text class="stats__label" :max-lines="1" :class="darkClass('home-text-secondary--dark')">组件</text>
						</view>
						<view class="stats__divider" :class="darkClass('home-divider--dark')"></view>
						<view class="stats__item">
							<text class="stats__num" :max-lines="1" :class="darkClass('home-text-primary--dark')">4</text>
							<text class="stats__label" :max-lines="1" :class="darkClass('home-text-secondary--dark')">分类</text>
						</view>
						<view class="stats__divider" :class="darkClass('home-divider--dark')"></view>
						<view class="stats__item">
							<text class="stats__num" :max-lines="1" :class="darkClass('home-text-primary--dark')">3</text>
							<text class="stats__label" :max-lines="1" :class="darkClass('home-text-secondary--dark')">场景</text>
						</view>
						<view class="stats__divider" :class="darkClass('home-divider--dark')"></view>
						<view class="stats__item">
							<text class="stats__num" :max-lines="1" :class="darkClass('home-text-primary--dark')">多端</text>
							<text class="stats__label" :max-lines="1" :class="darkClass('home-text-secondary--dark')">兼容</text>
						</view>
					</view>

					<!-- 通知条延后挂载：避免安卓首屏 measure/animate 拖垮整页 -->
					<view v-if="noticeReady" class="block">
						<nax-notice-bar
							type="primary"
							:list="noticeList"
							:show-more="false"
							scroll="vertical"
						></nax-notice-bar>
					</view>

					<view v-if="contentReady" class="section section--last">
						<view class="section__head">
							<text class="section__title" :class="darkClass('home-text--dark')">场景示例</text>
							<text class="section__more" :class="darkClass('home-text-primary--dark')" @click="goScenes">更多</text>
						</view>
						<view
							v-for="(scene, sIndex) in sceneList"
							:key="sIndex"
							class="scene-card"
							:class="darkClass('home-surface--dark')"
							@click="onOpenScene(scene)"
						>
							<view class="scene-card__icon" :class="darkClass('home-primary-soft--dark')">
								<nax-icon :name="itemIcon(scene)" size="22" :color="primaryIconColor"></nax-icon>
							</view>
							<view class="scene-card__body">
								<view class="scene-card__row">
									<text class="scene-card__name" :max-lines="1" :class="darkClass('home-text--dark')">{{ itemTitle(scene) }}</text>
									<nax-tag type="primary" variant="light" size="sm" :label="itemTag(scene)"></nax-tag>
								</view>
								<text class="scene-card__desc" :max-lines="2" :class="darkClass('home-text-secondary--dark')">{{ itemDesc(scene) }}</text>
							</view>
							<nax-icon name="chevron-right" size="18" :color="chevronIconColor"></nax-icon>
						</view>
					</view>
				</view>
			</scroll-view>
		</view>

		<nax-tabbar
			:model-value="0"
			:list="tabList"
			:fixed="chromeFixed"
			:placeholder="chromeFixed"
			@change="onTabChange"
		></nax-tabbar>
	</view>
</template>

<script setup lang="uts">
	import { bindDemoThemePage, demoDarkRef } from '@/common/demo-theme.uts'
	import {
		demoTabList,
		switchDemoTab,
		openDemoPage,
		demoCountByGroup,
		demoSceneList,
		demoReadString,
		hideDemoNativeTabBar
	} from '@/common/demo-catalog.uts'

	// 首屏避免 theme chrome API 异常中断 setup
	try {
		bindDemoThemePage()
	} catch (e) {
		// 保持默认
	}
	const darkMode = demoDarkRef

	const themeExtraClass = computed((): string => {
		if (darkMode.value) {
			return 'nax-theme-dark home-page--dark'
		}
		return ''
	})

	function darkClass(className : string) : string {
		if (darkMode.value) {
			return className
		}
		return ''
	}

	const navType = computed((): string => {
		if (darkMode.value) {
			return 'default'
		}
		return 'primary'
	})

	const navIconColor = computed((): string => {
		if (darkMode.value) {
			return '#ffffffd1'
		}
		return '#ffffff'
	})

	const primaryIconColor = computed((): string => {
		if (darkMode.value) {
			return '#63e2b7'
		}
		return '#18a058'
	})

	const chevronIconColor = computed((): string => {
		if (darkMode.value) {
			return '#ffffff73'
		}
		return '#e5e5ea'
	})

	// Android 首页用文档流；iOS/鸿蒙沿用 absolute 页壳
	const chromeFixed = ref(true)
	const pageRootStyle = ref('')
	const pageBodyStyle = ref('')
	const pageScrollStyle = ref('')
	const contentReady = ref(false)
	const noticeReady = ref(false)
	const bootTip = ref('首页加载中…')

	function refreshPageRootStyle() {
		// #ifdef MP-WEIXIN
		// 微信小程序 fixed 自定义组件可能被宿主裁剪，顶底栏改用文档流
		chromeFixed.value = false
		const winMp = uni.getWindowInfo()
		var pageHMp = winMp.screenHeight
		if (pageHMp <= 0) {
			pageHMp = winMp.windowHeight
		}
		if (pageHMp <= 0) {
			pageHMp = 700
		}
		var statusHMp = winMp.statusBarHeight
		if (statusHMp < 0) {
			statusHMp = 0
		}
		var safeBottomHMp = 0
		if (winMp.safeAreaInsets != null && winMp.safeAreaInsets.bottom > 0) {
			safeBottomHMp = winMp.safeAreaInsets.bottom
		} else if (winMp.safeArea != null) {
			const gapMp = pageHMp - winMp.safeArea.bottom
			if (gapMp > 0) {
				safeBottomHMp = gapMp
			}
		}
		const navHMp = statusHMp + 44
		const tabHMp = 50 + safeBottomHMp
		var bodyHMp = pageHMp - navHMp - tabHMp
		if (bodyHMp < 200) {
			bodyHMp = 200
		}
		pageRootStyle.value = 'width:100%;height:' + pageHMp.toString() + 'px;flex-direction:column;'
		pageBodyStyle.value = 'width:100%;height:' + bodyHMp.toString() + 'px;flex-direction:column;'
		pageScrollStyle.value = 'width:100%;height:' + bodyHMp.toString() + 'px;'
		// #endif

		// #ifdef APP-ANDROID
		// 安卓首页（冷启动第一页）：不用 fixed/absolute，改文档流 + 明确 px 高度
		// 避免首屏 fixed 顶底栏/absolute 中间层定位失败导致整页白屏
		chromeFixed.value = false
		const infoA = uni.getSystemInfoSync()
		var pageHA = infoA.windowHeight
		if (pageHA <= 0) {
			pageHA = infoA.screenHeight
		}
		var statusA = 0
		if (infoA.statusBarHeight > 0) {
			statusA = infoA.statusBarHeight
		}
		var safeBottomA = 0
		const winA = uni.getWindowInfo()
		if (winA.safeAreaInsets != null && winA.safeAreaInsets.bottom > 0) {
			safeBottomA = winA.safeAreaInsets.bottom
		} else if (winA.safeArea != null) {
			const gapA = winA.screenHeight - winA.safeArea.bottom
			if (gapA > 0) {
				safeBottomA = gapA
			}
		}
		if (pageHA <= 0 && winA.windowHeight > 0) {
			pageHA = winA.windowHeight
		}
		if (statusA <= 0 && winA.statusBarHeight > 0) {
			statusA = winA.statusBarHeight
		}
		if (pageHA <= 0) {
			pageHA = 700
		}
		const navHA = statusA + 44
		const tabHA = 50 + safeBottomA
		var bodyHA = pageHA - navHA - tabHA
		if (bodyHA < 200) {
			bodyHA = 200
		}
		var backgroundA = '#eef8f2'
		if (darkMode.value) {
			backgroundA = '#18181c'
		}
		pageRootStyle.value = 'width:100%;height:' + pageHA.toString() + 'px;flex-direction:column;background-color:' + backgroundA + ';'
		pageBodyStyle.value = 'width:100%;height:' + bodyHA.toString() + 'px;flex-direction:column;background-color:' + backgroundA + ';'
		pageScrollStyle.value = 'width:100%;height:' + bodyHA.toString() + 'px;background-color:' + backgroundA + ';'
		bootTip.value = 'Android ' + pageHA.toString() + '/' + bodyHA.toString()
		// #endif

		// #ifdef APP-IOS || APP-HARMONY
		chromeFixed.value = true
		const info = uni.getSystemInfoSync()
		var pageH = info.windowHeight
		if (pageH <= 0) {
			pageH = info.screenHeight
		}
		var status = 0
		if (info.statusBarHeight > 0) {
			status = info.statusBarHeight
		}
		var safeBottom = 0
		const win = uni.getWindowInfo()
		if (win.safeAreaInsets != null && win.safeAreaInsets.bottom > 0) {
			safeBottom = win.safeAreaInsets.bottom
		} else if (win.safeArea != null) {
			const gap = win.screenHeight - win.safeArea.bottom
			if (gap > 0) {
				safeBottom = gap
			}
		}
		if (pageH <= 0 && win.windowHeight > 0) {
			pageH = win.windowHeight
		}
		if (status <= 0 && win.statusBarHeight > 0) {
			status = win.statusBarHeight
		}
		if (pageH <= 0) {
			pageH = 700
		}
		const navH = status + 44
		const tabH = 50 + safeBottom
		var bodyH = pageH - navH - tabH
		if (bodyH < 200) {
			bodyH = 200
		}
		pageRootStyle.value = 'position:absolute;left:0;top:0;right:0;bottom:0;width:100%;height:' + pageH.toString() + 'px;'
		pageBodyStyle.value = 'position:absolute;left:0;right:0;top:' + navH.toString() + 'px;bottom:' + tabH.toString() + 'px;width:100%;height:' + bodyH.toString() + 'px;'
		pageScrollStyle.value = 'width:100%;height:' + bodyH.toString() + 'px;'
		bootTip.value = '窗口 ' + pageH.toString() + ' / 内容区 ' + bodyH.toString()
		// #endif

		// #ifndef APP-ANDROID || APP-IOS || APP-HARMONY || MP-WEIXIN
		chromeFixed.value = true
		pageRootStyle.value = 'flex:1;width:100%;height:100%;flex-direction:column;'
		pageBodyStyle.value = 'flex:1;height:0;width:100%;flex-direction:column;'
		pageScrollStyle.value = 'flex:1;width:100%;height:100%;'
		bootTip.value = 'nax-ui 演示首页'
		// #endif
	}
	// VDOM 模式 setup 阶段窗口信息可能不可用，失败由 onShow 兜底
	try {
		refreshPageRootStyle()
	} catch (e) {
		// 保持默认
	}

	const tabList = demoTabList()
	var sceneListSafe = [] as any[]
	try {
		sceneListSafe = demoSceneList()
	} catch (e) {
		sceneListSafe = [] as any[]
	}
	const sceneList = sceneListSafe
	var totalCountSafe = '0'
	try {
		totalCountSafe = demoCountByGroup('all').toString()
	} catch (e) {
		totalCountSafe = '0'
	}
	const totalCountText = totalCountSafe
	const noticeList = [
		'主题色来自主题包 nax-ui-theme，主色 18a058。可在「我的」切换深色模式。',
		'组件均 CSS 变量主题，蒸汽模式优先，适配应用、鸿蒙、网页与小程序。'
	] as string[]

	function itemTitle(item : any) : string {
		return demoReadString(item, 'name')
	}

	function itemDesc(item : any) : string {
		return demoReadString(item, 'desc')
	}

	function itemTag(item : any) : string {
		const tag = demoReadString(item, 'tag')
		if (tag.length == 0) {
			return '示例'
		}
		return tag
	}

	function itemIcon(item : any) : string {
		const name = demoReadString(item, 'icon')
		if (name.length == 0) {
			return 'star'
		}
		return name
	}

	function onOpenScene(item : any) {
		const path = demoReadString(item, 'path')
		if (path.length == 0) {
			return
		}
		openDemoPage(path)
	}

	function goCatalog() {
		switchDemoTab(1)
	}

	function goScenes() {
		switchDemoTab(2)
	}

	function goMine() {
		switchDemoTab(3)
	}

	function onTabChange(index : number) {
		if (index == 0) {
			return
		}
		switchDemoTab(index)
	}

	function mountHomeContent() {
		refreshPageRootStyle()
		if (!contentReady.value) {
			contentReady.value = true
		}
		// 通知条再晚一拍，降低安卓首屏动画/测量风险
		if (!noticeReady.value) {
			setTimeout(() => {
				noticeReady.value = true
			}, 120)
		}
	}

	onReady(() => {
		// 首个 Tab 页：等原生页就绪后再挂内容
		mountHomeContent()
	})

	onShow(() => {
		hideDemoNativeTabBar()
		try {
			darkMode.value = bindDemoThemePage()
		} catch (e) {
			// ignore first-page chrome API errors
		}
		refreshPageRootStyle()
		// #ifdef APP-ANDROID
		// 冷启动 hideTabBar 后窗口高度可能异步变化
		setTimeout(() => {
			mountHomeContent()
		}, 30)
		setTimeout(() => {
			refreshPageRootStyle()
		}, 120)
		// #endif
		// #ifndef APP-ANDROID
		if (!contentReady.value) {
			mountHomeContent()
		}
		// #endif
	})
</script>

<style>
	.page-root {
		flex-direction: column;
		width: 100%;
		background-color: #eef8f2;
	}

	.page-body {
		flex-direction: column;
		width: 100%;
		background-color: #eef8f2;
	}

	.page-scroll {
		width: 100%;
		flex-direction: column;
		background-color: #eef8f2;
	}

	.page {
		flex-direction: column;
		width: 100%;
		padding: 12px 16px 24px 16px;
		background-color: #eef8f2;
	}

	.boot-tip {
		font-size: 14px;
		font-weight: 600;
		color: #18a058;
		margin-bottom: 10px;
		padding: 8px 10px;
		background-color: #ffffff;
		border-radius: 5px;
	}

	.nav-action {
		flex-direction: row;
		align-items: center;
		justify-content: center;
		padding-left: 8px;
		padding-right: 4px;
		height: 36px;
	}

	.hero {
		flex-direction: column;
		width: 100%;
		padding: 18px 16px 16px 16px;
		border-radius: 5px;
		background-color: #ffffff;
		border-width: 1px;
		border-style: solid;
		border-color: #f0f0f3;
		margin-bottom: 12px;
	}

	.hero__top {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 12px;
	}

	.hero__brand {
		flex: 1;
		flex-direction: row;
		align-items: center;
	}

	.hero__logo {
		width: 44px;
		height: 44px;
		border-radius: 12px;
		overflow: hidden;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		margin-right: 12px;
		background-color: #ffffff;
		border-width: 1px;
		border-style: solid;
		border-color: #f0f0f3;
	}

	.hero__logo-img {
		width: 44px;
		height: 44px;
	}

	.hero__titles {
		flex: 1;
		flex-direction: column;
	}

	.hero__name {
		font-size: 20px;
		font-weight: 600;
		color: #333639;
		margin-bottom: 2px;
	}

	.hero__slogan {
		font-size: 12px;
		color: #767c82;
	}

	.hero__desc {
		font-size: 13px;
		line-height: 20px;
		color: #767c82;
		margin-bottom: 14px;
	}

	.hero__actions {
		flex-direction: row;
		align-items: center;
	}

	.hero__gap {
		width: 10px;
	}

	.stats {
		flex-direction: row;
		align-items: center;
		width: 100%;
		padding: 14px 8px;
		border-radius: 5px;
		background-color: #ffffff;
		border-width: 1px;
		border-style: solid;
		border-color: #f0f0f3;
		margin-bottom: 12px;
	}

	.stats__item {
		flex: 1;
		flex-direction: column;
		align-items: center;
	}

	.stats__num {
		font-size: 18px;
		font-weight: 600;
		color: #18a058;
		margin-bottom: 2px;
	}

	.stats__label {
		font-size: 12px;
		color: #767c82;
	}

	.stats__divider {
		width: 1px;
		height: 28px;
		background-color: #f5f5f7;
	}

	.block {
		margin-bottom: 12px;
		border-radius: 5px;
		overflow: hidden;
	}

	.section {
		flex-direction: column;
		margin-bottom: 16px;
	}

	.section--last {
		margin-bottom: 8px;
	}

	.section__head {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 10px;
		padding-left: 2px;
		padding-right: 2px;
	}

	.section__title {
		font-size: 16px;
		font-weight: 600;
		color: #333639;
	}

	.section__more {
		font-size: 13px;
		color: #18a058;
	}

	.scene-card {
		flex-direction: row;
		align-items: center;
		width: 100%;
		padding: 14px 12px;
		margin-bottom: 10px;
		border-radius: 5px;
		background-color: #ffffff;
		border-width: 1px;
		border-style: solid;
		border-color: #f0f0f3;
	}

	.scene-card__icon {
		width: 44px;
		height: 44px;
		border-radius: 12px;
		background-color: #e3f3eb;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		margin-right: 12px;
	}

	.scene-card__body {
		flex: 1;
		flex-direction: column;
		margin-right: 8px;
	}

	.scene-card__row {
		flex-direction: row;
		align-items: center;
		margin-bottom: 4px;
	}

	.scene-card__name {
		font-size: 15px;
		font-weight: 500;
		color: #333639;
		margin-right: 8px;
	}

	.scene-card__desc {
		font-size: 12px;
		line-height: 18px;
		color: #767c82;
	}

	.home-page--dark {
		background-color: #18181c;
	}

	.home-surface--dark {
		background-color: #101014;
		border-color: #ffffff24;
	}

	.home-boot--dark {
		color: #63e2b7;
		background-color: #101014;
	}

	.home-text--dark {
		color: #ffffffd1;
	}

	.home-text-secondary--dark {
		color: #ffffffa6;
	}

	.home-text-primary--dark {
		color: #63e2b7;
	}

	.home-divider--dark {
		background-color: #ffffff1a;
	}

	.home-primary-soft--dark {
		background-color: #1a322c;
	}

</style>
