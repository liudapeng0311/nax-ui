<template>
	<view class="page-root nax-theme" :class="themeExtraClass" :style="pageRootStyle">
		<nax-nav-bar
			title="我的"
			:show-back="false"
			:border="false"
			:type="navType"
			home-url="/pages/index/index"
			:fixed="chromeFixed"
			:placeholder="chromeFixed"
		></nax-nav-bar>

		<view class="page-body" :style="pageBodyStyle">
			<scroll-view class="page-scroll" :style="pageScrollStyle">
				<view class="nax-theme page" :class="themeExtraClass">
					<view class="profile">
						<nax-avatar text="NX" size="lg"></nax-avatar>
						<view class="profile__info">
							<text class="profile__name">nax-ui 演示</text>
							<text class="profile__sub">面向正式上架与插件市场的组件样板工程</text>
						</view>
					</view>

					<nax-cell-group inset title="偏好设置">
						<nax-cell title="外观模式" label="手动选择后不再跟随系统" icon="settings" :icon-color="cellIconColor" :border="true"></nax-cell>
						<nax-cell title="跟随系统" @click="onThemeModeChange('followSystem')">
							<template #right>
								<nax-icon v-if="themeMode == 'followSystem'" name="check" :size="'18'" :color="checkIconColor"></nax-icon>
							</template>
						</nax-cell>
						<nax-cell title="浅色" @click="onThemeModeChange('light')">
							<template #right>
								<nax-icon v-if="themeMode == 'light'" name="check" :size="'18'" :color="checkIconColor"></nax-icon>
							</template>
						</nax-cell>
						<nax-cell title="深色" :border="false" @click="onThemeModeChange('dark')">
							<template #right>
								<nax-icon v-if="themeMode == 'dark'" name="check" :size="'18'" :color="checkIconColor"></nax-icon>
							</template>
						</nax-cell>
						<nax-cell title="主题色" value="Primary #18a058" icon="star" :icon-color="cellIconColor"></nax-cell>
					</nax-cell-group>

					<view class="group-gap"></view>

					<nax-cell-group inset title="项目信息">
						<nax-cell title="版本" value="1.0.0" icon="info" :icon-color="cellIconColor"></nax-cell>
						<nax-cell title="技术栈" value="uni-app x / uvue" icon="square" :icon-color="cellIconColor"></nax-cell>
						<nax-cell title="组件数量" :value="componentCountText" icon="square-check" :icon-color="cellIconColor" is-link @click="goCatalog"></nax-cell>
						<nax-cell title="场景示例" value="3 个" icon="star" :icon-color="cellIconColor" is-link @click="goScenes"></nax-cell>
					</nax-cell-group>

					<view class="group-gap"></view>

					<nax-cell-group inset title="快捷入口">
						<nax-cell title="导航栏组件" label="nax-nav-bar" icon="home" :icon-color="cellIconColor" is-link @click="goNavBar"></nax-cell>
						<nax-cell title="底部标签栏" label="nax-tabbar" icon="more" :icon-color="cellIconColor" is-link @click="goTabbar"></nax-cell>
						<nax-cell title="按钮组件" label="nax-button" icon="square-check" :icon-color="cellIconColor" is-link @click="goButton"></nax-cell>
					</nax-cell-group>

					<view class="footer">
						<text class="footer__text">主题变量：--nax-color-primary</text>
					</view>
				</view>
			</scroll-view>
		</view>

		<nax-tabbar
			:model-value="3"
			:list="tabList"
			:fixed="chromeFixed"
			:placeholder="chromeFixed"
			@change="onTabChange"
		></nax-tabbar>
	</view>
</template>

<script setup lang="uts">
	import { bindDemoThemePage, demoDarkRef, getDemoThemeMode, setDemoThemeMode } from '@/common/demo-theme.uts'
	import {
		demoTabList,
		switchDemoTab,
		openDemoPage,
		demoCountByGroup,
		hideDemoNativeTabBar
	} from '@/common/demo-catalog.uts'

	// VDOM 模式页面 setup 阶段页面 body 未就绪，导航栏/窗口 API 可能抛异常；onShow 会再次校准
	try {
		bindDemoThemePage()
	} catch (e) {
		// 保持默认
	}
	const darkMode = demoDarkRef
	const themeMode = ref(getDemoThemeMode())

	const themeExtraClass = computed((): string => {
		if (darkMode.value) {
			return 'nax-theme-dark'
		}
		return ''
	})

	const navType = computed((): string => {
		if (darkMode.value) {
			return 'default'
		}
		return 'primary'
	})

	const cellIconColor = computed((): string => {
		// #ifdef APP-ANDROID || APP-HARMONY
		// App 原生组件边界不可靠继承运行时主题变量，显式传入当前主题色。
		if (darkMode.value) {
			return '#ffffffd1'
		}
		return '#333639'
		// #endif
		// #ifndef APP-ANDROID || APP-HARMONY
		return 'var(--nax-color-text, #333639)'
		// #endif
	})

	const checkIconColor = computed((): string => {
		// #ifdef APP-ANDROID || APP-HARMONY
		if (darkMode.value) {
			return '#63e2b7'
		}
		return '#18a058'
		// #endif
		// #ifndef APP-ANDROID || APP-HARMONY
		return 'var(--nax-color-primary, #18a058)'
		// #endif
	})

	const chromeFixed = ref(true)
	const pageRootStyle = ref('')
	const pageBodyStyle = ref('')
	const pageScrollStyle = ref('')
	function refreshPageRootStyle() {
		// #ifdef MP-WEIXIN
		// 微信小程序 fixed 自定义组件可能被宿主裁剪，顶底栏改用文档流
		chromeFixed.value = false
		const winMp = uni.getWindowInfo()
		var pageHMp = winMp.screenHeight
		if (pageHMp <= 0) {
			pageHMp = winMp.windowHeight
		}
		if (pageHMp <= 0) {
			pageHMp = 700
		}
		var statusHMp = winMp.statusBarHeight
		if (statusHMp < 0) {
			statusHMp = 0
		}
		var safeBottomHMp = 0
		if (winMp.safeAreaInsets != null && winMp.safeAreaInsets.bottom > 0) {
			safeBottomHMp = winMp.safeAreaInsets.bottom
		} else if (winMp.safeArea != null) {
			const gapMp = pageHMp - winMp.safeArea.bottom
			if (gapMp > 0) {
				safeBottomHMp = gapMp
			}
		}
		const navHMp = statusHMp + 44
		const tabHMp = 50 + safeBottomHMp
		var bodyHMp = pageHMp - navHMp - tabHMp
		if (bodyHMp < 200) {
			bodyHMp = 200
		}
		pageRootStyle.value = 'width:100%;height:' + pageHMp.toString() + 'px;flex-direction:column;'
		pageBodyStyle.value = 'width:100%;height:' + bodyHMp.toString() + 'px;flex-direction:column;'
		pageScrollStyle.value = 'width:100%;height:' + bodyHMp.toString() + 'px;'
		// #endif

		// #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
		// App：顶底栏 fixed 贴边；中间区 absolute 卡在顶底之间并写死 px 高
		chromeFixed.value = true
		const info = uni.getSystemInfoSync()
		var pageH = info.windowHeight
		if (pageH <= 0) {
			pageH = info.screenHeight
		}
		var status = 0
		if (info.statusBarHeight > 0) {
			status = info.statusBarHeight
		}
		var safeBottom = 0
		const win = uni.getWindowInfo()
		if (win.safeAreaInsets != null && win.safeAreaInsets.bottom > 0) {
			safeBottom = win.safeAreaInsets.bottom
		} else if (win.safeArea != null) {
			const gap = win.screenHeight - win.safeArea.bottom
			if (gap > 0) {
				safeBottom = gap
			}
		}
		if (pageH <= 0 && win.windowHeight > 0) {
			pageH = win.windowHeight
		}
		if (status <= 0 && win.statusBarHeight > 0) {
			status = win.statusBarHeight
		}
		if (pageH <= 0) {
			pageH = 700
		}
		const navH = status + 44
		const tabH = 50 + safeBottom
		var bodyH = pageH - navH - tabH
		if (bodyH < 200) {
			bodyH = 200
		}
		pageRootStyle.value = 'position:absolute;left:0;top:0;right:0;bottom:0;width:100%;height:' + pageH.toString() + 'px;'
		pageBodyStyle.value = 'position:absolute;left:0;right:0;top:' + navH.toString() + 'px;bottom:' + tabH.toString() + 'px;width:100%;height:' + bodyH.toString() + 'px;'
		pageScrollStyle.value = 'width:100%;height:' + bodyH.toString() + 'px;'
		// #endif
		// #ifndef APP-ANDROID || APP-IOS || APP-HARMONY || MP-WEIXIN
		chromeFixed.value = true
		pageRootStyle.value = 'flex:1;width:100%;height:100%;flex-direction:column;'
		pageBodyStyle.value = 'flex:1;height:0;width:100%;flex-direction:column;'
		pageScrollStyle.value = 'flex:1;width:100%;height:100%;'
		// #endif
	}
	// VDOM 模式 setup 阶段窗口信息可能不可用，失败由 onShow 兜底
	try {
		refreshPageRootStyle()
	} catch (e) {
		// 保持默认
	}

	const tabList = demoTabList()
	const componentCountText = demoCountByGroup('all').toString() + ' 个'

	function onThemeModeChange(mode : string) {
		setDemoThemeMode(mode)
		themeMode.value = mode
		darkMode.value = bindDemoThemePage()
	}

	function goCatalog() {
		switchDemoTab(1)
	}

	function goScenes() {
		switchDemoTab(2)
	}

	function goNavBar() {
		openDemoPage('/pages/components/nav-bar/index')
	}

	function goTabbar() {
		openDemoPage('/pages/components/tabbar/index')
	}

	function goButton() {
		openDemoPage('/pages/components/button/index')
	}

	function onTabChange(index : number) {
		if (index == 3) {
			return
		}
		switchDemoTab(index)
	}

	onShow(() => {
		hideDemoNativeTabBar()
		refreshPageRootStyle()
		darkMode.value = bindDemoThemePage()
		themeMode.value = getDemoThemeMode()
	})
</script>

<style>
	.page-root {
		flex-direction: column;
		width: 100%;
		background-color: var(--nax-color-bg-secondary, #fafafc);
	}

	.page-body {
		flex-direction: column;
		width: 100%;
	}

	.page-scroll {
		width: 100%;
		flex-direction: column;
	}

	.page {
		flex-direction: column;
		padding: 16px 0 28px 0;
		background-color: var(--nax-color-bg-secondary, #fafafc);
	}

	.profile {
		flex-direction: row;
		align-items: center;
		padding: 18px 16px;
		margin-bottom: 16px;
		border-radius: 14px;
		background-color: var(--nax-color-bg, #ffffff);
		border-width: 1px;
		border-style: solid;
		border-color: var(--nax-color-border, #f0f0f3);
	}

	.profile__info {
		flex: 1;
		flex-direction: column;
		margin-left: 12px;
	}

	.profile__name {
		font-size: 18px;
		font-weight: 600;
		color: var(--nax-color-text, #333639);
		margin-bottom: 4px;
	}

	.profile__sub {
		font-size: 12px;
		line-height: 18px;
		color: var(--nax-color-text-secondary, #767c82);
	}

	.group-gap {
		height: 14px;
	}

	.footer {
		flex-direction: column;
		align-items: center;
		margin-top: 24px;
	}

	.footer__text {
		font-size: 12px;
		color: var(--nax-color-text-secondary, #767c82);
		margin-bottom: 4px;
	}
</style>
