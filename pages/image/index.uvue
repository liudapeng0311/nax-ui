<template>
	<scroll-view style="flex:1" scroll-y="true">
		<view class="nax-theme page">
			<text class="page__title">nax-image</text>
			<text class="page__desc">原生 image 封装：尺寸 / 圆角 / 加载中 / 失败占位</text>

			<view class="section">
				<text class="section__title">基础 / mode</text>
				<view class="row">
					<view class="item">
						<nax-image
							:src="okSrc"
							width="100"
							height="100"
							mode="aspectFill"
						></nax-image>
						<text class="item__label">aspectFill</text>
					</view>
					<view class="item">
						<nax-image
							:src="okSrc"
							width="100"
							height="100"
							mode="aspectFit"
						></nax-image>
						<text class="item__label">aspectFit</text>
					</view>
					<view class="item">
						<nax-image
							:src="okSrc"
							width="100"
							height="100"
							mode="scaleToFill"
						></nax-image>
						<text class="item__label">scaleToFill</text>
					</view>
				</view>
			</view>

			<view class="section">
				<text class="section__title">形状 shape</text>
				<view class="row">
					<view class="item">
						<nax-image
							:src="okSrc"
							width="88"
							height="88"
							shape="square"
						></nax-image>
						<text class="item__label">square</text>
					</view>
					<view class="item">
						<nax-image
							:src="okSrc"
							width="88"
							height="88"
							shape="round"
						></nax-image>
						<text class="item__label">round</text>
					</view>
					<view class="item">
						<nax-image
							:src="okSrc"
							width="88"
							height="88"
							shape="circle"
						></nax-image>
						<text class="item__label">circle</text>
					</view>
				</view>
			</view>

			<view class="section">
				<text class="section__title">加载中 / 失败</text>
				<view class="row">
					<view class="item">
						<nax-image
							:src="slowSrc"
							width="120"
							height="120"
							loading-text="加载中"
							@load="onLoadOk"
							@error="onError"
						></nax-image>
						<text class="item__label">加载占位</text>
					</view>
					<view class="item">
						<nax-image
							:src="badSrc"
							width="120"
							height="120"
							error-text="加载失败"
							@error="onError"
						></nax-image>
						<text class="item__label">失败占位</text>
					</view>
					<view class="item">
						<nax-image
							src=""
							width="120"
							height="120"
							error-text="无图片"
						></nax-image>
						<text class="item__label">空 src</text>
					</view>
				</view>
				<text class="page__hint">{{ tip }}</text>
			</view>

			<view class="section">
				<text class="section__title">自定义插槽</text>
				<nax-image
					:src="badSrc"
					width="100%"
					height="140"
					shape="round"
				>
					<template #error>
						<view class="slot-box">
							<text class="slot-box__text">自定义失败插槽</text>
						</view>
					</template>
				</nax-image>
			</view>

			<view class="section">
				<text class="section__title">宽图（块级）</text>
				<nax-image
					:src="okSrc"
					width="100%"
					height="160"
					shape="round"
					mode="aspectFill"
					@click="onClickImage"
				></nax-image>
			</view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	const okSrc = ref('https://qiniu-web-assets.dcloud.net.cn/unidoc/zh/shuijiao.jpg')
	const slowSrc = ref('https://qiniu-web-assets.dcloud.net.cn/unidoc/zh/shuijiao.jpg?t=' + Date.now().toString())
	const badSrc = ref('https://invalid.nax-ui.local/not-found-' + Date.now().toString() + '.png')
	const tip = ref('点击图片或观察 load / error 事件')

	function onLoadOk() {
		tip.value = 'load: 加载成功'
	}

	function onError() {
		tip.value = 'error: 加载失败'
	}

	function onClickImage() {
		tip.value = 'click: 宽图'
	}
</script>

