<template>
	<view class="page-root nax-theme" :class="themeExtraClass">
		<nax-nav-bar
			title="nax-image"
			home-url="/pages/index/index"
			:border="true"
		></nax-nav-bar>
		<scroll-view class="page-scroll" scroll-y="true">
		<view class="nax-theme page" :class="themeExtraClass">
			<text class="page__desc">原生 image 封装：尺寸 / 圆角 / 加载中 / 失败占位</text>

			<view class="section">
				<text class="section__title">基础 / mode</text>
				<view class="row">
					<view class="item">
						<nax-image
							:src="okSrc"
							width="100"
							height="100"
							mode="aspectFill"
						></nax-image>
						<text class="item__label">aspectFill</text>
					</view>
					<view class="item">
						<nax-image
							:src="okSrc"
							width="100"
							height="100"
							mode="aspectFit"
						></nax-image>
						<text class="item__label">aspectFit</text>
					</view>
					<view class="item">
						<nax-image
							:src="okSrc"
							width="100"
							height="100"
							mode="scaleToFill"
						></nax-image>
						<text class="item__label">scaleToFill</text>
					</view>
				</view>
			</view>

			<view class="section">
				<text class="section__title">形状 shape</text>
				<view class="row">
					<view class="item">
						<nax-image
							:src="okSrc"
							width="88"
							height="88"
							shape="square"
						></nax-image>
						<text class="item__label">square</text>
					</view>
					<view class="item">
						<nax-image
							:src="okSrc"
							width="88"
							height="88"
							shape="round"
						></nax-image>
						<text class="item__label">round</text>
					</view>
					<view class="item">
						<nax-image
							:src="okSrc"
							width="88"
							height="88"
							shape="circle"
						></nax-image>
						<text class="item__label">circle</text>
					</view>
				</view>
			</view>

			<view class="section">
				<text class="section__title">加载中 / 失败</text>
				<view class="row">
					<view class="item">
						<nax-image
							force-loading
							width="120"
							height="120"
							loading-text="加载中"
						></nax-image>
						<text class="item__label">加载占位</text>
					</view>
					<view class="item">
						<nax-image
							:src="badSrc"
							width="120"
							height="120"
							:timeout="8000"
							error-text="加载失败"
							@error="onError"
						></nax-image>
						<text class="item__label">失败占位</text>
					</view>
					<view class="item">
						<nax-image
							src=""
							width="120"
							height="120"
							error-text="无图片"
						></nax-image>
						<text class="item__label">空 src</text>
					</view>
				</view>
				<text class="page__hint">{{ tip }}</text>
			</view>

			<view class="section">
				<text class="section__title">自定义插槽</text>
				<nax-image
					:src="badSrc" :timeout="8000"
					width="100%"
					height="140"
					shape="round"
				>
					<template #error>
						<view class="slot-box">
							<text class="slot-box__text">自定义失败插槽</text>
						</view>
					</template>
				</nax-image>
			</view>

			<view class="section">
				<text class="section__title">宽图（块级）</text>
				<nax-image
					:src="okSrc"
					width="100%"
					height="160"
					shape="round"
					mode="aspectFill"
					@click="onClickImage"
				></nax-image>
			</view>
		</view>
	</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { bindDemoThemePage } from '@/common/demo-theme.uts'

	// setup 同步读全局，避免首帧浅色白闪
	const darkMode = ref(bindDemoThemePage())

	const themeExtraClass = computed((): string => {
		if (darkMode.value) {
			return 'nax-theme-dark'
		}
		return ''
	})

	onShow(() => {
		darkMode.value = bindDemoThemePage()
	})



	const okSrc = ref('https://qiniu-web-assets.dcloud.net.cn/unidoc/zh/shuijiao.jpg')
	const badSrc = ref('https://qiniu-web-assets.dcloud.net.cn/unidoc/zh/nax-ui-not-found.png')
	const tip = ref('点击图片或观察 load / error 事件')

	function onLoadOk() {
		tip.value = 'load: 加载成功'
	}

	function onError() {
		tip.value = 'error: 加载失败'
	}

	function onClickImage() {
		tip.value = 'click: 宽图'
	}
</script>

