<template>
	<view class="page-root nax-theme" :class="themeExtraClass">
		<nax-nav-bar
			title="nax-icon"
			home-url="/pages/index/index"
			:border="true"
			:back-icon-color="iconTextColor"
		></nax-nav-bar>
		<scroll-view class="page-scroll">
		<view class="nax-theme page" :class="themeExtraClass">
			<text class="page__desc">Tabler Icons 语义子集 · name / size / color / click</text>

			<view class="section">
				<text class="section__title">尺寸 size</text>
				<view class="row">
					<view class="item">
						<nax-icon name="search" size="sm" :color="iconTextColor"></nax-icon>
						<text class="item__label">sm</text>
					</view>
					<view class="item">
						<nax-icon name="search" size="md" :color="iconTextColor"></nax-icon>
						<text class="item__label">md</text>
					</view>
					<view class="item">
						<nax-icon name="search" size="lg" :color="iconTextColor"></nax-icon>
						<text class="item__label">lg</text>
					</view>
					<view class="item">
						<nax-icon name="search" size="28" :color="iconTextColor"></nax-icon>
						<text class="item__label">28</text>
					</view>
				</view>
			</view>

			<view class="section">
				<text class="section__title">颜色 color</text>
				<view class="row">
					<view class="item">
						<nax-icon name="heart" :color="errorIconColor"></nax-icon>
						<text class="item__label">error</text>
					</view>
					<view class="item">
						<nax-icon name="star" :color="warningIconColor"></nax-icon>
						<text class="item__label">warning</text>
					</view>
					<view class="item">
						<nax-icon name="success" :color="successIconColor"></nax-icon>
						<text class="item__label">success</text>
					</view>
					<view class="item">
						<nax-icon name="info" :color="infoIconColor"></nax-icon>
						<text class="item__label">info</text>
					</view>
				</view>
			</view>

			<view class="section">
				<text class="section__title">状态</text>
				<view class="row">
					<view class="item">
						<nax-icon name="settings" :color="iconTextColor" @click="onTap('settings')"></nax-icon>
						<text class="item__label">可点</text>
					</view>
					<view class="item">
						<nax-icon name="settings" :color="iconTextColor" disabled @click="onTap('disabled')"></nax-icon>
						<text class="item__label">disabled</text>
					</view>
				</view>
				<text class="page__hint">{{ tip }}</text>
			</view>

			<view class="section">
				<text class="section__title">配合 nax-button</text>
				<view class="row">
					<view class="item-wide">
						<nax-button type="primary" label="搜索" @click="onTap('button-search')">
							<template #icon>
								<nax-icon name="search" size="sm" :color="inverseIconColor"></nax-icon>
							</template>
						</nax-button>
					</view>
					<view class="item-wide">
						<nax-button type="error" variant="outline" label="删除" @click="onTap('button-delete')">
							<template #icon>
								<nax-icon name="delete" size="sm" :color="errorIconColor"></nax-icon>
							</template>
						</nax-button>
					</view>
				</view>
			</view>

			<view class="section">
				<text class="section__title">全部图标</text>
				<view class="grid">
					<view class="grid__item" v-for="item in icons" :key="item">
						<nax-icon :name="item" :color="iconTextColor" @click="onTap(item)"></nax-icon>
						<text class="grid__name" :max-lines="1">{{ item }}</text>
					</view>
				</view>
			</view>
		</view>
	</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { bindDemoThemePage, demoDarkRef } from '@/common/demo-theme.uts'

	// setup 同步读全局，避免首帧浅色白闪
	bindDemoThemePage()
	const darkMode = demoDarkRef

	const themeExtraClass = computed((): string => {
		if (darkMode.value) {
			return 'nax-theme-dark'
		}
		return ''
	})

	function themedIconColor(lightColor : string, darkColor : string, tokenColor : string) : string {
		// #ifdef APP-ANDROID || APP-HARMONY
		// App 原生 text 不可靠响应组件边界内的动态 CSS 变量，改传当前主题字面量。
		if (darkMode.value) {
			return darkColor
		}
		return lightColor
		// #endif
		// #ifndef APP-ANDROID || APP-HARMONY
		return tokenColor
		// #endif
	}

	const iconTextColor = computed((): string => {
		return themedIconColor('#333639', '#ffffffd1', 'var(--nax-color-text, #333639)')
	})

	const errorIconColor = computed((): string => {
		return themedIconColor('#d03050', '#e88080', 'var(--nax-color-error, #d03050)')
	})

	const warningIconColor = computed((): string => {
		return themedIconColor('#f0a020', '#f2c97d', 'var(--nax-color-warning, #f0a020)')
	})

	const successIconColor = computed((): string => {
		return themedIconColor('#18a058', '#63e2b7', 'var(--nax-color-success, #18a058)')
	})

	const infoIconColor = computed((): string => {
		return themedIconColor('#2080f0', '#70c0e8', 'var(--nax-color-info, #2080f0)')
	})

	const inverseIconColor = computed((): string => {
		return themedIconColor('#ffffff', '#000000', 'var(--nax-color-text-inverse, #ffffff)')
	})

	onShow(() => {
		darkMode.value = bindDemoThemePage()
	})



	const tip = ref('点击图标查看 name')

	const icons = ref([
		'close',
		'check',
		'plus',
		'minus',
		'arrow-left',
		'arrow-right',
		'arrow-up',
		'arrow-down',
		'chevron-left',
		'chevron-right',
		'chevron-up',
		'chevron-down',
		'search',
		'loading',
		'info',
		'warning',
		'success',
		'error',
		'user',
		'home',
		'more',
		'edit',
		'delete',
		'star',
		'heart',
		'settings',
		'eye',
		'eye-off',
		'copy',
		'share',
		'image',
		'image-off',
		'loader',
		'loader-4',
		'square',
		'circle',
		'square-check',
		'file-off',
		'notes-off',
		'database-off',
		'message-off',
		'category',
		'category-filled',
		'map-pin',
		'map-pin-filled'
	] as string[])

	function onTap(name : string) {
		tip.value = 'click: ' + name
	}
</script>

<style>

	.page-root {
		flex: 1;
		flex-direction: column;
		/* #ifndef APP-ANDROID || APP-IOS || APP-HARMONY */
		height: 100%;
		/* #endif */
	}

	.page-scroll {
		flex: 1;
		height: 0;
	}
	.page {
		padding: 16px;
		background-color: var(--nax-color-bg-secondary, #fafafc);
	}

	.page__title {
		font-size: 20px;
		color: var(--nax-color-text, #333639);
		font-weight: 600;
		margin-bottom: 6px;
	}

	.page__desc {
		font-size: 13px;
		color: var(--nax-color-text-secondary, #767c82);
		margin-bottom: 12px;
	}

	.page__hint {
		font-size: 13px;
		color: var(--nax-color-text-secondary, #767c82);
		margin-top: 8px;
	}

	.section {
		margin-bottom: 16px;
		padding: 14px;
		background-color: var(--nax-color-bg, #ffffff);
		border-radius: var(--nax-radius-md, 3px);
		border-width: 1px;
		border-style: solid;
		border-color: var(--nax-color-border, #f0f0f3);
	}

	.section__title {
		font-size: 14px;
		font-weight: 500;
		color: var(--nax-color-text, #333639);
		margin-bottom: 12px;
	}

	.row {
		flex-direction: row;
		flex-wrap: wrap;
		align-items: center;
	}

	.item {
		width: 72px;
		margin-right: 8px;
		margin-bottom: 10px;
		align-items: center;
	}

	.item-wide {
		margin-right: 12px;
		margin-bottom: 10px;
	}

	.item__label {
		font-size: 12px;
		color: var(--nax-color-text-secondary, #767c82);
		margin-top: 6px;
	}

	.grid {
		flex-direction: row;
		flex-wrap: wrap;
	}

	.grid__item {
		width: 25%;
		padding-top: 10px;
		padding-bottom: 10px;
		align-items: center;
	}

	.grid__name {
		font-size: 11px;
		color: var(--nax-color-text-secondary, #767c82);
		margin-top: 6px;
	}
</style>
