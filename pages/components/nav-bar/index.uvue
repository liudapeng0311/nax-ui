<template>
	<view class="page-root nax-theme" :class="themeExtraClass">
		<!-- 本页自身顶栏（页面已 navigationStyle: custom） -->
		<nax-nav-bar
			title="nax-nav-bar"
			home-url="/pages/index/index"
			:border="true"
		>
			<template #right>
				<view class="nav-right" @click="onRightTip">
					<text class="nav-right__text">说明</text>
				</view>
			</template>
		</nax-nav-bar>

		<scroll-view class="page-scroll" scroll-y="true">
			<view class="nax-theme page" :class="themeExtraClass">
				<text class="page__desc">自定义顶栏：状态栏安全区、fixed 占位、返回栈兜底、小程序胶囊预留。下列为非 fixed 预览块。</text>

				<view class="section">
					<text class="section__title">默认 default</text>
					<nax-nav-bar
						title="默认标题"
						:fixed="false"
						:safe-area-inset-top="false"
						:auto-back="false"
						@back="onDemoBack('default')"
					></nax-nav-bar>
				</view>

				<view class="section">
					<text class="section__title">主色 primary</text>
					<nax-nav-bar
						type="primary"
						title="主色导航"
						:fixed="false"
						:safe-area-inset-top="false"
						:auto-back="false"
						@back="onDemoBack('primary')"
					></nax-nav-bar>
				</view>

				<view class="section">
					<text class="section__title">返回文案 + 无图标</text>
					<nax-nav-bar
						title="设置"
						back-text="关闭"
						back-icon=""
						:fixed="false"
						:safe-area-inset-top="false"
						:auto-back="false"
						@back="onDemoBack('text')"
					></nax-nav-bar>
				</view>

				<view class="section">
					<text class="section__title">左对齐标题 + 无返回</text>
					<nax-nav-bar
						title="首页风格"
						title-align="left"
						:show-back="false"
						:fixed="false"
						:safe-area-inset-top="false"
					>
						<template #right>
							<nax-icon name="search" size="22"></nax-icon>
						</template>
					</nax-nav-bar>
				</view>

				<view class="section">
					<text class="section__title">自定义中间（插槽）</text>
					<nax-nav-bar
						:fixed="false"
						:safe-area-inset-top="false"
						:auto-back="false"
						@back="onDemoBack('slot')"
					>
						<view class="mid-tabs">
							<text class="mid-tabs__item mid-tabs__item--on">关注</text>
							<text class="mid-tabs__item">推荐</text>
						</view>
						<template #right>
							<nax-icon name="plus" size="22"></nax-icon>
						</template>
					</nax-nav-bar>
				</view>

				<view class="section">
					<text class="section__title">沉浸 immersive（预览）</text>
					<view class="immersive-box">
						<nax-nav-bar
							title="沉浸标题"
							type="primary"
							immersive
							:fixed="false"
							:safe-area-inset-top="false"
							:auto-back="false"
							@back="onDemoBack('immersive')"
						></nax-nav-bar>
					</view>
					<text class="demo-note">说明（仅 demo）：开启 immersive 后导航栏透明底、无底边；若同时 fixed，组件不插入占位，内容可从顶栏下方透出。</text>
				</view>

				<view class="section section--end">
					<text class="hint">最近返回事件：{{ lastBack }}</text>
					<text class="hint">页面须 navigationStyle: custom；首页/tab 建议 show-back=false 或配置 home-url。</text>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { bindDemoThemePage } from '@/common/demo-theme.uts'

	const darkMode = ref(bindDemoThemePage())

	const themeExtraClass = computed((): string => {
		if (darkMode.value) {
			return 'nax-theme-dark'
		}
		return ''
	})

	const lastBack = ref('—')

	function onDemoBack(name : string) {
		lastBack.value = name
	}

	function onRightTip() {
		uni.showToast({
			title: '右侧插槽',
			icon: 'none'
		})
	}
</script>

