	</view>
</template>

<script setup lang="uts">
	import { bindDemoThemePage, demoNavBackIconColor } from '@/common/demo-theme.uts'

	// setup 同步读全局，避免首帧浅色白闪
	const darkMode = ref(bindDemoThemePage())

	const themeExtraClass = computed((): string => {
		if (darkMode.value) {
			return 'nax-theme-dark'
		}
		return ''
	})

	onShow(() => {
		darkMode.value = bindDemoThemePage()
	})



	const loading = ref(false)
	const lastClick = ref('暂无')

	function onTap(name : string) {
		lastClick.value = name
		uni.showToast({
			title: name,
			icon: 'none'
		})
	}

	function toggleLoading() {
		loading.value = !loading.value
		lastClick.value = loading.value ? 'loading:on' : 'loading:off'
	}
</script>

