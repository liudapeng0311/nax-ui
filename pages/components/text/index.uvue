	</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { bindDemoThemePage } from '@/common/demo-theme.uts'

	const darkMode = ref(bindDemoThemePage())

	const themeExtraClass = computed((): string => {
		if (darkMode.value) {
			return 'nax-theme-dark'
		}
		return ''
	})

	const lastEvent = ref('无')

	onShow(() => {
		darkMode.value = bindDemoThemePage()
	})

	function onLinkClick() {
		lastEvent.value = 'click link'
		uni.showToast({
			title: '已触发 click',
			icon: 'none'
		})
	}

	function onCallClick() {
		lastEvent.value = 'click call'
	}
</script>

<style>

