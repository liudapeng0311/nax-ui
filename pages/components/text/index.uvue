					<nax-text block align="center" text="居中 center" type="primary"></nax-text>
					<nax-text block align="right" text="右对齐 right" type="secondary"></nax-text>
				</view>
			</view>

			<view class="section">
				<text class="section__title">可选中 selectable</text>
				<view class="stack">
