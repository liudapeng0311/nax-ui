<template>
	<view class="page-root nax-theme" :class="themeExtraClass">
		<nax-nav-bar
			title="nax-text"
			home-url="/pages/index/index"
			:border="true"
		></nax-nav-bar>
		<scroll-view class="page-scroll" scroll-y="true">
		<view class="nax-theme page" :class="themeExtraClass">
			<text class="page__desc">文本。能力对齐 uView Pro Text：主题色 / 字号 / 省略 / 模式格式化。</text>

			<view class="section">
				<text class="section__title">基础</text>
				<view class="stack">
					<nax-text text="我用十年青春,赴你最后之约"></nax-text>
					<nax-text text="带图标的文本" prefix-icon="star" type="primary"></nax-text>
					<nax-text text="后缀图标" suffix-icon="arrow-right" type="secondary"></nax-text>
				</view>
