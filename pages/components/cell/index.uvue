	<view class="page-root nax-theme" :class="themeExtraClass">
		<nax-nav-bar
			title="nax-cell"
			home-url="/pages/index/index"
			:border="true"
		></nax-nav-bar>
		<scroll-view class="page-scroll" scroll-y="true">
		<view class="nax-theme page" :class="themeExtraClass">
			<text class="page__desc">单元格 / 单元格组。设置项与列表行基础，对齐 uView Pro Cell。</text>

			<view class="section">
				<text class="section__title">基础</text>
				<nax-cell-group>
					<nax-cell title="单元格" value="内容"></nax-cell>
					<nax-cell title="单元格" label="描述信息" value="内容"></nax-cell>
					<nax-cell title="单元格" value="详情" is-link @click="onCellClick('基础链接')"></nax-cell>
				</nax-cell-group>
			</view>

			<view class="section">
				<text class="section__title">分组标题</text>
