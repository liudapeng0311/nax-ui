			<view class="section">
				<text class="section__title">状态</text>
				<nax-cell-group>
					<nax-cell title="必填项" required value="请填写" is-link></nax-cell>
					<nax-cell title="禁用" value="不可点" disabled is-link></nax-cell>
					<nax-cell title="无箭头可点" clickable @click="onCellClick('可点')"></nax-cell>
					<nax-cell title="无分割线" value="border=false" :border="false"></nax-cell>
				</nax-cell-group>
			</view>

			<view class="section">
				<text class="section__title">右侧插槽（开关）</text>
				<nax-cell-group>
					<nax-cell title="消息推送" center>
						<template #right>
							<nax-switch v-model="pushOn"></nax-switch>
						</template>
					</nax-cell>
					<nax-cell title="深色模式" label="仅演示绑定" center>
						<template #right>
							<nax-switch v-model="darkSwitch"></nax-switch>
						</template>
					</nax-cell>
				</nax-cell-group>
			</view>

			<view class="section">
				<text class="section__title">自定义颜色</text>
				<nax-cell-group>
					<nax-cell title="标题色" title-color="#18a058" value="主色" value-color="#18a058" is-link></nax-cell>
					<nax-cell icon="user" icon-color="#2080f0" title="图标色" value="info" is-link></nax-cell>
				</nax-cell-group>
			</view>

			<view class="section">
				<text class="section__title">事件</text>
				<text class="hint">最近点击：{{ lastEvent }}</text>
			</view>
		</view>
	</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { bindDemoThemePage } from '@/common/demo-theme.uts'

	const darkMode = ref(bindDemoThemePage())
	const pushOn = ref(true)
	const darkSwitch = ref(false)
	const lastEvent = ref('无')

	const themeExtraClass = computed((): string => {
		if (darkMode.value) {
			return 'nax-theme-dark'
		}
		return ''
	})

	onShow(() => {
		darkMode.value = bindDemoThemePage()
	})

	function onCellClick(name : string) {
		lastEvent.value = name
		uni.showToast({
			title: name,
			icon: 'none'
		})
	}
</script>

