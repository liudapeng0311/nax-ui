<template>
	<view class="page-root">
		<nax-nav-bar
			title="nax-slider"
			home-url="/pages/index/index"
			:border="true"
		></nax-nav-bar>
		<scroll-view class="page-scroll" scroll-y="true">
		<view class="nax-theme page" :class="themeExtraClass">
			<text class="page__desc">滑动选择器 · 对齐 uView Pro Slider 主能力</text>

			<view class="section">
				<text class="section__title">基础用法</text>
				<nax-slider v-model="basic" @change="onBasicChange"></nax-slider>
				<text class="section__meta">值：{{ basic }} · {{ lastEvent }}</text>
			</view>

			<view class="section">
				<text class="section__title">尺寸 size</text>
				<text class="section__label">sm</text>
				<nax-slider v-model="sizeSm" size="sm"></nax-slider>
				<text class="section__label section__label--gap">md</text>
				<nax-slider v-model="sizeMd" size="md"></nax-slider>
				<text class="section__label section__label--gap">lg</text>
				<nax-slider v-model="sizeLg" size="lg"></nax-slider>
			</view>

			<view class="section">
				<text class="section__title">范围 min / max</text>
				<nax-slider v-model="rangeVal" :min="30" :max="80" show-edge-value></nax-slider>
				<text class="section__meta">当前 {{ rangeVal }}（可选 30–80）</text>
			</view>

			<view class="section">
				<text class="section__title">步长 step</text>
				<nax-slider v-model="stepVal" :step="10" show-value></nax-slider>
				<text class="section__meta">step=10 · {{ stepVal }}</text>
			</view>

			<view class="section">
				<text class="section__title">小数步长</text>
				<nax-slider v-model="stepFloat" :step="0.1" :start="0" :end="1" show-value></nax-slider>
				<text class="section__meta">step=0.1 · 范围 0–1 · {{ stepFloat }}</text>
			</view>

			<view class="section">
				<text class="section__title">自定义颜色</text>
				<nax-slider
					v-model="colorVal"
					active-color="#2080f0"
					inactive-color="#d6e4ff"
					block-color="#ffffff"
					show-value
				></nax-slider>
				<text class="section__meta">info 蓝 · {{ colorVal }}</text>
			</view>

			<view class="section">
				<text class="section__title">显示起止值 showEdgeValue</text>
				<nax-slider
					v-model="edgeVal"
					:start="0"
					:end="100"
					show-edge-value
					edge-value-position="bottom"
					show-value
					value-position="top"
				></nax-slider>
				<text class="section__meta">{{ edgeVal }}</text>
			</view>

			<view class="section">
				<text class="section__title">自定义滑块 useSlot</text>
				<nax-slider v-model="slotVal" use-slot :block-width="28">
					<view class="custom-thumb">
						<text class="custom-thumb__text">{{ slotVal }}</text>
					</view>
				</nax-slider>
			</view>

			<view class="section">
				<text class="section__title">禁用 disabled</text>
				<nax-slider v-model="disabledVal" disabled></nax-slider>
				<text class="section__meta">{{ disabledVal }}</text>
			</view>

			<view class="section">
				<text class="section__title">事件 start / moving / end</text>
				<nax-slider
					v-model="eventVal"
					@start="onStart"
					@moving="onMoving"
					@end="onEnd"
					@change="onEventChange"
				></nax-slider>
				<text class="section__meta">{{ eventLog }}</text>
			</view>
		</view>
	</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { bindDemoThemePage } from '@/common/demo-theme.uts'

	const darkMode = ref(bindDemoThemePage())

	const themeExtraClass = computed((): string => {
		if (darkMode.value) {
			return 'nax-theme-dark'
		}
		return ''
	})

	onShow(() => {
		darkMode.value = bindDemoThemePage()
	})

	const basic = ref(30)
	const sizeSm = ref(20)
	const sizeMd = ref(40)
	const sizeLg = ref(60)
	const rangeVal = ref(50)
	const stepVal = ref(30)
	const stepFloat = ref(0.3)
	const colorVal = ref(45)
	const edgeVal = ref(55)
	const slotVal = ref(35)
	const disabledVal = ref(40)
	const eventVal = ref(25)
	const lastEvent = ref('—')
	const eventLog = ref('等待操作')

	function onBasicChange(v : number) {
		lastEvent.value = 'change: ' + v.toString()
	}

	function onStart() {
		eventLog.value = 'start'
	}

	function onMoving() {
		eventLog.value = 'moving · ' + eventVal.value.toString()
	}

	function onEnd() {
		eventLog.value = 'end · ' + eventVal.value.toString()
	}

	function onEventChange(v : number) {
		eventLog.value = 'change · ' + v.toString()
	}
</script>

<style>

	.page-root {
		flex: 1;
		flex-direction: column;
		/* #ifndef APP-ANDROID || APP-IOS || APP-HARMONY */
		height: 100%;
		/* #endif */
	}
	.page-scroll {
		flex: 1;
		height: 0;
	}

	.page {
		padding: 16px;
		padding-bottom: 32px;
		background-color: var(--nax-color-bg-secondary, #fafafc);
		flex-direction: column;
	}

	.page__title {
		font-size: 20px;
		color: var(--nax-color-text, #333639);
		font-weight: 600;
		margin-bottom: 6px;
	}

	.page__desc {
		font-size: 13px;
		color: var(--nax-color-text-secondary, #767c82);
		margin-bottom: 12px;
	}

	.section {
		margin-bottom: 16px;
		padding: 14px;
		background-color: var(--nax-color-bg, #ffffff);
		border-radius: var(--nax-radius-md, 3px);
		border-width: 1px;
		border-style: solid;
		border-color: var(--nax-color-border, #f0f0f3);
		flex-direction: column;
	}

	.section__title {
		font-size: 14px;
		font-weight: 500;
		color: var(--nax-color-text, #333639);
		margin-bottom: 12px;
	}

	.section__label {
		font-size: 12px;
		color: var(--nax-color-text-secondary, #767c82);
		margin-bottom: 4px;
	}

	.section__label--gap {
		margin-top: 12px;
	}

	.section__meta {
		margin-top: 8px;
		font-size: 13px;
		color: var(--nax-color-text-secondary, #767c82);
	}

	.custom-thumb {
		width: 28px;
		height: 28px;
		border-radius: 14px;
		background-color: var(--nax-color-primary, #18a058);
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}

	.custom-thumb__text {
		font-size: 10px;
		color: #ffffff;
		font-weight: 600;
	}
</style>
