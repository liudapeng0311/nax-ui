<template>
	<view class="page-root nax-theme" :class="themeExtraClass">
		<nax-nav-bar
			:back-icon-color="navBackIconColor"
			title="nax-rich-text"
			home-url="/pages/index/index"
			:border="true"
		></nax-nav-bar>
		<scroll-view class="page-scroll">
		<view class="nax-theme page" :class="themeExtraClass">
			<text class="page__desc">一篇内容覆盖全部元素：标题 / 首行缩进 / 行内样式 / 引用 / 列表 / 表格 / 图片 / 视频 / 链接</text>

			<view class="rich-box">
				<nax-rich-text :content="demoHtml" @itemclick="onItemClick"></nax-rich-text>
			</view>
			<text class="page__hint">{{ itemTip }}</text>
		</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { bindDemoThemePage, demoDarkRef, demoNavBackIconColor } from '@/common/demo-theme.uts'

	// setup 同步读全局，避免首帧浅色白闪
	bindDemoThemePage()
	const darkMode = demoDarkRef

	const navBackIconColor = computed((): string => {
		// Android 模板编译不直接调用导入的 UTS 函数，避免生成未解析的 invoke。
		// #ifdef APP-ANDROID
		return ''
		// #endif
		// #ifndef APP-ANDROID
		return demoNavBackIconColor(darkMode.value)
		// #endif
	})

	const themeExtraClass = computed((): string => {
		if (darkMode.value) {
			return 'nax-theme-dark'
		}
		return ''
	})

	onShow(() => {
		darkMode.value = bindDemoThemePage()
	})

	const demoHtml = '<h2>全市经济运行稳中有进</h2>'
		+ '<p style="text-indent:2em;">据新华社电，今年以来全市经济运行<strong>稳中有进</strong>、<em>质效向好</em>，主要指标<mark>好于预期</mark>，市场活力持续增强。</p>'
		+ '<p>支持<u>下划线</u>、<del>删除线</del>、<code>行内代码</code>，以及<span style="color:#2080f0;">行内着色</span>与<span style="background-color:#e6f4ff;">背景色</span>，详情见<a href="https://www.nax-ui.cn">nax-ui 官网</a>。</p>'
		+ '<blockquote>相关负责人表示：“下一步将持续优化营商环境，巩固经济回升向好势头。”</blockquote>'
		+ '<h3>数据要点</h3>'
		+ '<ul><li>工业增加值增长 6.2%</li><li>固定资产投资增长 4.8%<ol><li>制造业投资增长 7.1%</li><li>基础设施投资增长 3.4%</li></ol></li><li>消费市场持续回暖</li></ul>'
		+ '<p>各项数据对比如下：</p>'
		+ '<table border="1"><tr><th>指标</th><th>增速</th></tr><tr><td>GDP</td><td>5.2%</td></tr><tr><td>规上工业</td><td>6.2%</td></tr></table>'
		+ '<p style="text-align:center;"><img src="https://qiniu-web-assets.dcloud.net.cn/unidoc/zh/shuijiao.jpg" width="240"></p>'
		+ '<hr/>'
		+ '<p>相关音频报道：</p>'
		+ '<audio src="https://stream7.iqilu.com/10339/sucaiku/202608/28/bee8f3ab0f344c19893b4a30b9ee5799.mp3" poster="https://qiniu-web-assets.dcloud.net.cn/unidoc/zh/cbd.jpg" title="微光.mp3" controls></audio>'
		+ '<audio src="https://www.w3school.com.cn/i/horse.mp3" controls></audio>'
		+ '<p>现场视频实录：</p>'
		+ '<video src="https://qiniu-web-assets.dcloud.net.cn/unidoc/zh/2minute-demo.mp4" poster="https://qiniu-web-assets.dcloud.net.cn/unidoc/zh/cbd.jpg" controls></video>'
		+ '<p style="text-align:right;">（完）</p>'

	const itemTip = ref('点击图片 / 链接 / 视频观察 itemclick')

	function onItemClick(e : any) {
		const obj = e as UTSJSONObject
		let src = ''
		let href = ''
		let type = ''
		const srcVal = obj['src']
		const hrefVal = obj['href']
		const typeVal = obj['type']
		if (srcVal != null) {
			src = srcVal as string
		}
		if (hrefVal != null) {
			href = hrefVal as string
		}
		if (typeVal != null) {
			type = typeVal as string
		}
		let desc = ''
		if (src.length > 0) {
			desc = '图片 ' + src
		} else if (href.length > 0) {
			desc = (type == 'a' ? '链接 ' : type + ' ') + href
		}
		if (desc.length == 0) {
			desc = 'itemclick 已触发'
		}
		itemTip.value = 'itemclick: ' + desc
	}
</script>

<style>

	.page-root {
		flex: 1;
		flex-direction: column;
		/* #ifndef APP-ANDROID || APP-IOS || APP-HARMONY */
		height: 100%;
		/* #endif */
	}

	.page-scroll {
		flex: 1;
		height: 0;
	}
	.page {
		padding: 16px;
		background-color: var(--nax-color-bg-secondary, #fafafc);
	}

	.page__desc {
		font-size: 13px;
		color: var(--nax-color-text-secondary, #767c82);
		margin-bottom: 12px;
	}

	.page__hint {
		font-size: 13px;
		color: var(--nax-color-text-secondary, #767c82);
		margin-top: 8px;
	}

	.rich-box {
		padding: 10px;
		background-color: var(--nax-color-bg, #ffffff);
		border-radius: var(--nax-radius-md, 3px);
	}
</style>
