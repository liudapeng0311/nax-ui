<template>
	<view class="page-root">
		<nax-nav-bar
			title="nax-form"
			home-url="/pages/index/index"
			:border="true"
		></nax-nav-bar>
		<scroll-view class="page-scroll" scroll-y="true">
		<view class="nax-theme page" :class="themeExtraClass">
			<text class="page__desc">表单 / 表单项（对齐 uView Pro Form 主能力）</text>

			<view class="section">
				<text class="section__title">基础校验</text>
				<view class="panel">
					<nax-form
						ref="formRef"
						:model="formModel"
						:rules="rules"
						label-position="left"
						:label-width="80"
						label-align="left"
						error-type="message"
						:border-bottom="true"
					>
						<nax-form-item label="姓名" prop="name" required>
							<nax-input v-model="name" placeholder="请输入姓名" :clearable="true" @change="syncFormModel" @blur="syncFormModel"></nax-input>
						</nax-form-item>
						<nax-form-item label="手机" prop="phone" required>
							<nax-input v-model="phone" type="number" placeholder="请输入手机号" :clearable="true" @change="syncFormModel" @blur="syncFormModel"></nax-input>
						</nax-form-item>
						<nax-form-item label="邮箱" prop="email">
							<nax-input v-model="email" placeholder="选填，校验邮箱格式" :clearable="true" @change="syncFormModel" @blur="syncFormModel"></nax-input>
						</nax-form-item>
						<nax-form-item label="密码" prop="password" required>
							<nax-input v-model="password" type="password" placeholder="6-20 位" :clearable="true" @change="syncFormModel" @blur="syncFormModel"></nax-input>
						</nax-form-item>
						<nax-form-item label="简介" prop="intro" label-position="top">
							<nax-textarea v-model="intro" placeholder="至少 5 个字" height="80" @change="syncFormModel" @blur="syncFormModel"></nax-textarea>
						</nax-form-item>
						<nax-form-item label="性别" prop="sex" required>
							<nax-radio-group v-model="sex" @change="onSexChange">
								<nax-radio name="1" label="男"></nax-radio>
								<nax-radio name="2" label="女"></nax-radio>
							</nax-radio-group>
						</nax-form-item>
						<nax-form-item label="协议" prop="agree" required>
							<nax-checkbox v-model="agree" label="我已阅读并同意用户协议" @change="onAgreeChange"></nax-checkbox>
						</nax-form-item>
					</nax-form>
				</view>

				<view class="actions">
					<view class="actions__btn">
						<nax-button type="primary" label="提交校验" @click="onSubmit"></nax-button>
					</view>
					<view class="actions__btn">
						<nax-button label="重置" @click="onReset"></nax-button>
					</view>
					<view class="actions__btn">
						<nax-button variant="secondary" label="清空错误" @click="onClear"></nax-button>
					</view>
				</view>
				<text class="hint">结果：{{ resultText }}</text>
			</view>

			<view class="section">
				<text class="section__title">标签在上方 + toast 错误</text>
				<view class="panel">
					<nax-form
						ref="formTopRef"
						:model="formTopModel"
						:rules="rulesTop"
						label-position="top"
						error-type="toast"
						:border-bottom="false"
					>
						<nax-form-item label="昵称" prop="nickname" required>
							<nax-input v-model="nickname" border placeholder="必填昵称" @change="syncTopModel" @blur="syncTopModel"></nax-input>
						</nax-form-item>
						<nax-form-item label="备注" prop="remark">
							<nax-input v-model="remark" border placeholder="可选" @change="syncTopModel" @blur="syncTopModel"></nax-input>
						</nax-form-item>
					</nax-form>
				</view>
				<view class="actions">
					<view class="actions__btn">
						<nax-button type="primary" label="提交（toast）" @click="onSubmitTop"></nax-button>
					</view>
				</view>
			</view>

			<view class="section">
				<text class="section__title">外部 error-message / status</text>
				<view class="panel">
					<nax-form :model="formManualModel" :border-bottom="true" :label-width="80">
						<nax-form-item label="账号" prop="account" :error-message="manualError" status="error">
							<nax-input v-model="account" placeholder="外部错误文案"></nax-input>
						</nax-form-item>
						<nax-form-item label="状态" prop="ok" status="success" :border-bottom="true">
							<nax-input v-model="okText" placeholder="success 下划线"></nax-input>
						</nax-form-item>
					</nax-form>
				</view>
				<view class="actions">
					<view class="actions__btn">
						<nax-button size="sm" label="设置错误" @click="setManualError"></nax-button>
					</view>
					<view class="actions__btn">
						<nax-button size="sm" variant="secondary" label="清除错误" @click="clearManualError"></nax-button>
					</view>
				</view>
			</view>
		</view>
	</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { bindDemoThemePage } from '@/common/demo-theme.uts'

	const darkMode = ref(bindDemoThemePage())

	const themeExtraClass = computed((): string => {
		if (darkMode.value) {
			return 'nax-theme-dark'
		}
		return ''
	})

	onShow(() => {
		darkMode.value = bindDemoThemePage()
	})

	const formRef = ref(null)
	const formTopRef = ref(null)
	const resultText = ref('—')
	const manualError = ref('')

	// 字段 ref（控件 v-model）+ UTSJSONObject model（交给 nax-form 校验）
	const name = ref('')
	const phone = ref('')
	const email = ref('')
	const password = ref('')
	const intro = ref('')
	const sex = ref('')
	const agree = ref(false)

	const nickname = ref('')
	const remark = ref('')
	const account = ref('')
	const okText = ref('已通过')

	const formModel = {
		name: '',
		phone: '',
		email: '',
		password: '',
		intro: '',
		sex: '',
		agree: false
	} as UTSJSONObject

	const formTopModel = {
		nickname: '',
		remark: ''
	} as UTSJSONObject

	const formManualModel = {
		account: '',
		ok: '已通过'
	} as UTSJSONObject

	function syncFormModel() {
		formModel.set('name', name.value)
		formModel.set('phone', phone.value)
		formModel.set('email', email.value)
		formModel.set('password', password.value)
		formModel.set('intro', intro.value)
		formModel.set('sex', sex.value)
		formModel.set('agree', agree.value)
	}

	function syncTopModel() {
		formTopModel.set('nickname', nickname.value)
		formTopModel.set('remark', remark.value)
	}

	function onSexChange(_v: string) {
		syncFormModel()
	}

	function onAgreeChange(_v: boolean) {
		syncFormModel()
	}

	syncFormModel()
	syncTopModel()

	const rules = {
		name: [
			{
				required: true,
				message: '请输入姓名',
				trigger: ['blur', 'change']
			} as UTSJSONObject,
			{
				min: 2,
				max: 10,
				message: '姓名长度 2-10 个字'
			} as UTSJSONObject
		] as any[],
		phone: [
			{
				required: true,
				message: '请输入手机号'
			} as UTSJSONObject,
			{
				pattern: '^1\\d{10}$',
				message: '手机号格式不正确'
			} as UTSJSONObject
		] as any[],
		email: [
			{
				type: 'email',
				message: '邮箱格式不正确'
			} as UTSJSONObject
		] as any[],
		password: [
			{
				required: true,
				message: '请输入密码'
			} as UTSJSONObject,
			{
				min: 6,
				max: 20,
				message: '密码 6-20 位'
			} as UTSJSONObject
		] as any[],
		intro: [
			{
				min: 5,
				message: '简介至少 5 个字'
			} as UTSJSONObject
		] as any[],
		sex: [
			{
				required: true,
				message: '请选择性别'
			} as UTSJSONObject
		] as any[],
		agree: [
			{
				type: 'accepted',
				required: true,
				message: '请勾选用户协议'
			} as UTSJSONObject
		] as any[]
	} as UTSJSONObject

	const rulesTop = {
		nickname: [
			{
				required: true,
				message: '请填写昵称'
			} as UTSJSONObject
		] as any[]
	} as UTSJSONObject

	function callFormMethod(target: any | null, methodName: string): any | null {
		if (target == null) {
			return null
		}
		if (methodName == 'validate') {
			return target.validate()
		}
		if (methodName == 'resetFields') {
			target.resetFields()
			return null
		}
		if (methodName == 'clearValidate') {
			target.clearValidate()
			return null
		}
		return null
	}

	function onSubmit() {
		syncFormModel()
		const ret = callFormMethod(formRef.value, 'validate')
		if (ret == null) {
			resultText.value = '表单未就绪'
			return
		}
		const p = ret as Promise<boolean>
		p.then((_ok: boolean) => {
			resultText.value = '校验通过'
			uni.showToast({
				title: '校验通过',
				icon: 'none'
			})
		}).catch((_err: any | null) => {
			resultText.value = '校验失败，请查看字段提示'
		})
	}

	function onReset() {
		name.value = ''
		phone.value = ''
		email.value = ''
		password.value = ''
		intro.value = ''
		sex.value = ''
		agree.value = false
		syncFormModel()
		callFormMethod(formRef.value, 'resetFields')
		callFormMethod(formRef.value, 'clearValidate')
		resultText.value = '已重置'
	}

	function onClear() {
		callFormMethod(formRef.value, 'clearValidate')
		resultText.value = '已清空错误'
	}

	function onSubmitTop() {
		syncTopModel()
		const ret = callFormMethod(formTopRef.value, 'validate')
		if (ret == null) {
			return
		}
		const p = ret as Promise<boolean>
		p.then((_ok: boolean) => {
			uni.showToast({
				title: '顶部表单通过',
				icon: 'none'
			})
		}).catch((_err: any | null) => {
			// toast 已由 form 弹出
		})
	}

	function setManualError() {
		manualError.value = '账号已存在'
	}

	function clearManualError() {
		manualError.value = ''
	}
</script>

<style>

	.page-root {
		flex: 1;
		flex-direction: column;
		/* #ifndef APP-ANDROID || APP-IOS || APP-HARMONY */
		height: 100%;
		/* #endif */
	}

	.page-scroll {
		flex: 1;
		height: 0;
	}
	.page {
		padding: 16px;
		padding-bottom: 40px;
		background-color: var(--nax-color-bg-secondary, #fafafc);
		flex-direction: column;
	}

	.page__title {
		font-size: 20px;
		color: var(--nax-color-text, #333639);
		font-weight: 600;
		margin-bottom: 6px;
	}

	.page__desc {
		font-size: 13px;
		color: var(--nax-color-text-secondary, #767c82);
		margin-bottom: 16px;
	}

	.section {
		margin-bottom: 22px;
		flex-direction: column;
	}

	.section__title {
		font-size: 14px;
		color: var(--nax-color-text, #333639);
		font-weight: 500;
		margin-bottom: 10px;
	}

	.panel {
		background-color: var(--nax-color-bg, #ffffff);
		border-radius: var(--nax-radius-md, 3px);
		padding-left: 12px;
		padding-right: 12px;
		flex-direction: column;
	}

	.actions {
		flex-direction: row;
		flex-wrap: wrap;
		margin-top: 12px;
	}

	.actions__btn {
		margin-right: 8px;
		margin-bottom: 8px;
	}

	.hint {
		font-size: 12px;
		color: var(--nax-color-text-secondary, #767c82);
		margin-top: 4px;
	}
</style>
