<template>
	<scroll-view style="flex:1" scroll-y="true">
		<view class="nax-theme page" :class="themeExtraClass">
			<text class="page__title">nax-alert</text>
			<text class="page__desc">警告提示条（页面内常驻）。对齐 uView Pro AlertTips：类型 / 标题 / 描述 / 图标 / 可关闭。</text>

			<view class="section">
				<text class="section__title">基础</text>
				<view class="item">
					<nax-alert
						title="温馨提示"
						description="请先完成实名认证后再进行提现操作。"
					></nax-alert>
				</view>
			</view>

			<view class="section">
				<text class="section__title">类型 type</text>
				<view class="item">
					<nax-alert type="primary" title="主色提示" description="这是 primary 类型。"></nax-alert>
				</view>
				<view class="item">
					<nax-alert type="info" title="信息提示" description="这是 info 类型。"></nax-alert>
				</view>
				<view class="item">
					<nax-alert type="success" title="成功提示" description="操作已成功完成。"></nax-alert>
				</view>
				<view class="item">
					<nax-alert type="warning" title="警告提示" description="请注意相关风险。"></nax-alert>
				</view>
				<view class="item">
					<nax-alert type="error" title="错误提示" description="提交失败，请稍后重试。"></nax-alert>
				</view>
			</view>

			<view class="section">
				<text class="section__title">实心 variant=solid</text>
				<view class="item">
					<nax-alert type="info" variant="solid" title="信息" description="实心填充样式。"></nax-alert>
				</view>
				<view class="item">
					<nax-alert type="success" variant="solid" title="成功" description="实心填充样式。"></nax-alert>
				</view>
				<view class="item">
					<nax-alert type="warning" variant="solid" title="警告" description="实心填充样式。"></nax-alert>
				</view>
				<view class="item">
					<nax-alert type="error" variant="solid" title="错误" description="实心填充样式。"></nax-alert>
				</view>
			</view>

			<view class="section">
				<text class="section__title">仅标题 / 仅描述</text>
				<view class="item">
					<nax-alert type="info" title="只有标题"></nax-alert>
				</view>
				<view class="item">
					<nax-alert type="warning" description="只有描述文字，没有标题。"></nax-alert>
				</view>
			</view>

			<view class="section">
				<text class="section__title">无图标 / 自定义图标</text>
				<view class="item">
					<nax-alert :show-icon="false" type="info" title="不显示图标" description="show-icon=false"></nax-alert>
				</view>
				<view class="item">
					<nax-alert icon="star" type="primary" title="自定义图标" description="icon=star"></nax-alert>
				</view>
			</view>

			<view class="section">
				<text class="section__title">居中 center</text>
				<view class="item">
					<nax-alert
						center
						type="success"
						title="居中展示"
						description="标题与描述水平居中。"
					></nax-alert>
				</view>
			</view>

			<view class="section">
				<text class="section__title">可关闭 closable</text>
				<view class="item" v-if="showCloseA">
					<nax-alert
						closable
						type="error"
						title="账号异常"
						description="检测到异地登录，建议立即修改密码。"
						@close="onCloseA"
					></nax-alert>
				</view>
				<view class="item">
					<nax-alert
						closable
						:show="showCloseB"
						type="warning"
						title="受控显示"
						description="使用 show + update:show 控制。"
						@close="onCloseB"
						@update:show="onShowB"
					></nax-alert>
				</view>
				<view class="item">
					<nax-button size="sm" label="重置关闭示例" @click="resetClose"></nax-button>
				</view>
				<text class="hint">最近事件：{{ lastEvent }}</text>
			</view>

			<view class="section">
				<text class="section__title">默认插槽</text>
				<view class="item">
					<nax-alert type="info" title="自定义描述">
						<text class="slot-desc">描述可用默认插槽自定义，例如补充链接说明文案。</text>
					</nax-alert>
				</view>
			</view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import { bindDemoThemePage } from '@/common/demo-theme.uts'

	const darkMode = ref(bindDemoThemePage())

	const themeExtraClass = computed((): string => {
		if (darkMode.value) {
			return 'nax-theme-dark'
		}
		return ''
	})

	onShow(() => {
		darkMode.value = bindDemoThemePage()
	})

	const showCloseA = ref(true)
	const showCloseB = ref(true)
	const lastEvent = ref('无')

	function onCloseA() {
		showCloseA.value = false
		lastEvent.value = 'close A'
	}

	function onCloseB() {
		lastEvent.value = 'close B'
	}

	function onShowB(v : boolean) {
		showCloseB.value = v
		lastEvent.value = 'update:show ' + (v ? 'true' : 'false')
	}

	function resetClose() {
		showCloseA.value = true
		showCloseB.value = true
		lastEvent.value = 'reset'
	}
</script>

<style>
	.page {
		padding: 16px;
		background-color: var(--nax-color-bg, #ffffff);
		flex-direction: column;
	}

	.page__title {
		font-size: 20px;
		color: var(--nax-color-text, #333639);
		font-weight: 600;
		margin-bottom: 6px;
	}

	.page__desc {
		font-size: 13px;
		color: var(--nax-color-text-secondary, #767c82);
		margin-bottom: 16px;
	}

	.section {
		margin-bottom: 24px;
		flex-direction: column;
	}

	.section__title {
		font-size: 14px;
		color: var(--nax-color-text, #333639);
		font-weight: 500;
		margin-bottom: 10px;
	}

	.item {
		margin-bottom: 10px;
		flex-direction: column;
	}

	.hint {
		margin-top: 4px;
		font-size: 12px;
		color: var(--nax-color-text-secondary, #767c82);
	}

	.slot-desc {
		font-size: 14px;
		color: var(--nax-color-text-secondary, #767c82);
		margin-top: 4px;
	}
</style>
