<template>
	<view class="page-root nax-theme" :class="themeExtraClass">
		<nax-nav-bar
			:back-icon-color="navBackIconColor"
			title="nax-transition"
			home-url="/pages/index/index"
			:border="true"
		></nax-nav-bar>
		<scroll-view class="page-scroll" scroll-y="true">
		<view class="nax-theme page" :class="themeExtraClass">
			<text class="page__desc">轻量进退场过渡。预设 fade / slide / zoom 等，供弹层复用。</text>

			<view class="section">
				<text class="section__title">预设 name</text>
				<view class="row">
					<nax-button size="sm" :type="currentName == 'fade' ? 'primary' : 'default'" label="fade" @click="pickName('fade')"></nax-button>
					<view class="gap"></view>
					<nax-button size="sm" :type="currentName == 'slide-up' ? 'primary' : 'default'" label="slide-up" @click="pickName('slide-up')"></nax-button>
					<view class="gap"></view>
					<nax-button size="sm" :type="currentName == 'slide-down' ? 'primary' : 'default'" label="slide-down" @click="pickName('slide-down')"></nax-button>
				</view>
				<view class="row row--gap">
					<nax-button size="sm" :type="currentName == 'slide-left' ? 'primary' : 'default'" label="slide-left" @click="pickName('slide-left')"></nax-button>
					<view class="gap"></view>
					<nax-button size="sm" :type="currentName == 'slide-right' ? 'primary' : 'default'" label="slide-right" @click="pickName('slide-right')"></nax-button>
					<view class="gap"></view>
					<nax-button size="sm" :type="currentName == 'zoom' ? 'primary' : 'default'" label="zoom" @click="pickName('zoom')"></nax-button>
					<view class="gap"></view>
					<nax-button size="sm" :type="currentName == 'fade-up' ? 'primary' : 'default'" label="fade-up" @click="pickName('fade-up')"></nax-button>
				</view>
				<view class="row row--gap">
					<nax-button type="primary" :label="visible ? '隐藏' : '显示'" @click="toggle"></nax-button>
				</view>
				<text class="hint">当前：{{ currentName }} · 事件：{{ lastEvent }}</text>

				<view class="stage">
					<nax-transition
						:show="visible"
						:name="currentName"
						:duration="duration"
						@before-enter="onEvent('before-enter')"
						@after-enter="onEvent('after-enter')"
						@before-leave="onEvent('before-leave')"
						@after-leave="onEvent('after-leave')"
					>
						<view class="card">
							<text class="card__title">过渡内容</text>
							<text class="card__desc">name = {{ currentName }}</text>
						</view>
					</nax-transition>
				</view>
			</view>

			<view class="section">
				<text class="section__title">时长 duration</text>
				<view class="row">
					<nax-button size="sm" :type="duration == 150 ? 'primary' : 'default'" label="150ms" @click="setDuration(150)"></nax-button>
					<view class="gap"></view>
					<nax-button size="sm" :type="duration == 280 ? 'primary' : 'default'" label="280ms" @click="setDuration(280)"></nax-button>
					<view class="gap"></view>
					<nax-button size="sm" :type="duration == 500 ? 'primary' : 'default'" label="500ms" @click="setDuration(500)"></nax-button>
					<view class="gap"></view>
					<nax-button size="sm" :type="duration == 0 ? 'primary' : 'default'" label="0 无动画" @click="setDuration(0)"></nax-button>
				</view>
			</view>

			<view class="section">
				<text class="section__title">底部面板（slide-up 场景）</text>
				<nax-button label="打开底部面板" type="primary" @click="openSheet"></nax-button>
				<view v-if="sheetMounted" class="sheet-root">
					<nax-transition :show="sheetShow" name="fade" :duration="280" @after-leave="onSheetGone">
						<view class="sheet-mask" @click="closeSheet"></view>
					</nax-transition>
					<nax-transition :show="sheetShow" name="slide-up" :duration="280" @after-leave="onSheetGone">
						<view class="sheet-panel">
							<text class="sheet-title">底部面板</text>
							<text class="sheet-desc">遮罩 fade + 面板 slide-up</text>
							<nax-button label="关闭" @click="closeSheet"></nax-button>
						</view>
					</nax-transition>
				</view>
			</view>
		</view>
	</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { bindDemoThemePage, demoNavBackIconColor } from '@/common/demo-theme.uts'

	const darkMode = ref(bindDemoThemePage())

	const navBackIconColor = computed((): string => {
		// Android 模板编译不直接调用导入的 UTS 函数，避免生成未解析的 invoke。
		// #ifdef APP-ANDROID
		return ''
		// #endif
		// #ifndef APP-ANDROID
		return demoNavBackIconColor(darkMode.value)
		// #endif
	})

	const themeExtraClass = computed((): string => {
		if (darkMode.value) {
			return 'nax-theme-dark'
		}
		return ''
	})

	onShow(() => {
		darkMode.value = bindDemoThemePage()
	})

	const visible = ref(true)
	const currentName = ref('fade')
	const duration = ref(280)
	const lastEvent = ref('无')

	const sheetShow = ref(false)
	const sheetMounted = ref(false)
	let sheetLeaveCount = 0

	function toggle() {
		visible.value = !visible.value
	}

	function pickName(name: string) {
		currentName.value = name
		// 切换预设时重新播一次，便于对比
		visible.value = false
		setTimeout(() => {
			visible.value = true
		}, 40)
	}

	function setDuration(v: number) {
		duration.value = v
	}

	function onEvent(name: string) {
		lastEvent.value = name
	}

	function openSheet() {
		sheetLeaveCount = 0
		sheetMounted.value = true
		// 下一帧再 show，确保容器已挂载
		setTimeout(() => {
			sheetShow.value = true
		}, 20)
	}

	function closeSheet() {
		sheetShow.value = false
	}

	function onSheetGone() {
		// mask + panel 各触发一次 after-leave
		sheetLeaveCount++
		if (sheetLeaveCount >= 2 && !sheetShow.value) {
			sheetMounted.value = false
			sheetLeaveCount = 0
		}
	}
</script>

<style>

	.page-root {
		flex: 1;
		flex-direction: column;
		background-color: var(--nax-color-bg, #ffffff);
		/* #ifndef APP-ANDROID || APP-IOS || APP-HARMONY */
		height: 100%;
		/* #endif */
	}

	.page-scroll {
		flex: 1;
		height: 0;
		background-color: var(--nax-color-bg, #ffffff);
	}
	.page {
		padding: 16px;
		background-color: var(--nax-color-bg, #ffffff);
	}

	.page__title {
		font-size: 20px;
		color: var(--nax-color-text, #333639);
		font-weight: 600;
		margin-bottom: 6px;
	}

	.page__desc {
		font-size: 13px;
		color: var(--nax-color-text-secondary, #767c82);
		margin-bottom: 16px;
	}

	.section {
		margin-bottom: 24px;
		flex-direction: column;
	}

	.section__title {
		font-size: 14px;
		color: var(--nax-color-text, #333639);
		font-weight: 500;
		margin-bottom: 10px;
	}

	.row {
		flex-direction: row;
		align-items: center;
		flex-wrap: wrap;
	}

	.row--gap {
		margin-top: 8px;
	}

	.gap {
		width: 8px;
		height: 1px;
	}

	.hint {
		font-size: 12px;
		color: var(--nax-color-text-secondary, #767c82);
		margin-top: 10px;
		margin-bottom: 10px;
	}

	.stage {
		min-height: 120px;
		padding: 12px;
		background-color: var(--nax-color-bg-secondary, #fafafc);
		border-radius: var(--nax-radius-md, 8px);
		flex-direction: column;
		/* #ifndef APP-ANDROID || APP-IOS || APP-HARMONY */
		overflow: hidden;
		/* #endif */
	}

	.card {
		padding: 16px;
		background-color: var(--nax-color-bg, #ffffff);
		border-radius: var(--nax-radius-md, 8px);
		border-width: 1px;
		border-style: solid;
		border-color: var(--nax-color-border, #f0f0f3);
		flex-direction: column;
	}

	.card__title {
		font-size: 16px;
		color: var(--nax-color-text, #333639);
		font-weight: 500;
		margin-bottom: 6px;
	}

	.card__desc {
		font-size: 13px;
		color: var(--nax-color-text-secondary, #767c82);
	}

	.sheet-root {
		position: fixed;
		left: 0;
		top: 0;
		right: 0;
		bottom: 0;
		flex-direction: column;
		justify-content: flex-end;
		z-index: 1000;
	}

	.sheet-mask {
		position: absolute;
		left: 0;
		top: 0;
		right: 0;
		bottom: 0;
		background-color: var(--nax-color-mask, rgba(0, 0, 0, 0.4));
	}

	.sheet-panel {
		position: relative;
		z-index: 1;
		padding: 20px;
		background-color: var(--nax-color-bg, #ffffff);
		border-top-left-radius: 12px;
		border-top-right-radius: 12px;
		flex-direction: column;
	}

	.sheet-title {
		font-size: 16px;
		color: var(--nax-color-text, #333639);
		font-weight: 600;
		margin-bottom: 8px;
	}

	.sheet-desc {
		font-size: 13px;
		color: var(--nax-color-text-secondary, #767c82);
		margin-bottom: 16px;
	}
</style>
