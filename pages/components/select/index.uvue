<template>
	<view class="page-root nax-theme" :class="themeExtraClass">
		<nax-nav-bar
			:back-icon-color="navBackIconColor"
			title="nax-select"
			home-url="/pages/index/index"
			:border="true"
		></nax-nav-bar>
		<scroll-view class="page-scroll">
		<view class="nax-theme page" :class="themeExtraClass">

			<view class="section">
				<text class="section__title">单列 + 按钮打开</text>
				<!-- #ifdef MP-WEIXIN -->
				<text class="hint">微信小程序端：nax-select 使用系统弹层 picker，点击下方触发条打开（按钮打开不生效）。</text>
				<!-- #endif -->
				<!-- #ifndef MP-WEIXIN -->
				<nax-button label="选择水果" type="primary" @click="openSingle"></nax-button>
				<!-- #endif -->
				<text class="hint">结果：{{ singleText }}</text>
				<nax-select
					v-model:show="singleShow"
					:list="fruitList"
					title="选择水果"
					:default-value="singleDefault"
					@confirm="onSingleConfirm"
					@cancel="onCancel('single')"
				></nax-select>
			</view>

				<view class="section">
					<text class="section__title">内置触发条 + v-model</text>
					<nax-select
						v-model="triggerValue"
						v-model:show="triggerShow"
						show-trigger
						placeholder="请选择城市"
						:list="cityList"
						title="城市"
						@confirm="onTriggerConfirm"
						@clear="onTriggerClear"
					></nax-select>
					<text class="hint">v-model：{{ triggerValue }}</text>
					<text class="hint">结果：{{ triggerText }}（有值时点下箭头左侧清除）</text>
				</view>

			<view class="section">
				<text class="section__title">多列 multi-column</text>
				<!-- #ifdef MP-WEIXIN -->
				<text class="hint">微信小程序端：点下方触发条打开。</text>
				<!-- #endif -->
				<!-- #ifndef MP-WEIXIN -->
				<nax-button label="选择时间段" @click="multiShow = true"></nax-button>
				<!-- #endif -->
				<text class="hint">结果：{{ multiText }}</text>
				<nax-select
					v-model:show="multiShow"
					mode="multi-column"
					:list="multiList"
					title="上课时间"
					@confirm="onMultiConfirm"
				></nax-select>
			</view>

			<view class="section">
				<text class="section__title">多列联动 multi-column-auto</text>
					<nax-select
						v-model="cascadeValue"
						v-model:show="cascadeShow"
						show-trigger
						mode="multi-column-auto"
						:list="regionList"
						title="选择地区"
						placeholder="省 / 市 / 区"
						@confirm="onCascadeConfirm"
						@change="onCascadeChange"
						@clear="onCascadeClear"
					></nax-select>
					<text class="hint">结果：{{ cascadeText }}</text>
					<text class="hint">滚动中：{{ cascadeLive }}</text>
			</view>

			<view class="section">
				<text class="section__title">自定义字段名</text>
				<!-- #ifdef MP-WEIXIN -->
				<text class="hint">微信小程序端：点下方触发条打开。</text>
				<!-- #endif -->
				<!-- #ifndef MP-WEIXIN -->
				<nax-button label="打开（id/name）" size="sm" @click="customShow = true"></nax-button>
				<!-- #endif -->
				<text class="hint">结果：{{ customText }}</text>
				<nax-select
					v-model:show="customShow"
					:list="customList"
					value-name="id"
					label-name="name"
					title="自定义字段"
					@confirm="onCustomConfirm"
				></nax-select>
			</view>

			<view class="section">
				<text class="section__title">禁用触发条</text>
				<nax-select
					show-trigger
					disabled
					placeholder="已禁用"
					:list="fruitList"
				></nax-select>
			</view>

			<view class="section">
				<text class="section__title">最近事件</text>
				<text class="hint">{{ lastEvent }}</text>
			</view>
		</view>
	</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { bindDemoThemePage, demoDarkRef, demoNavBackIconColor } from '@/common/demo-theme.uts'

	bindDemoThemePage()
	const darkMode = demoDarkRef

	const navBackIconColor = computed((): string => {
		// Android 模板编译不直接调用导入的 UTS 函数，避免生成未解析的 invoke。
		// #ifdef APP-ANDROID
		return ''
		// #endif
		// #ifndef APP-ANDROID
		return demoNavBackIconColor(darkMode.value)
		// #endif
	})

	const themeExtraClass = computed((): string => {
		if (darkMode.value) {
			return 'nax-theme-dark'
		}
		return ''
	})

	onShow(() => {
		darkMode.value = bindDemoThemePage()
	})

	const lastEvent = ref('无')

	const singleShow = ref(false)
	const singleDefault = [1] as number[]
	const singleText = ref('未选择')
	const fruitList = [
		{ value: 'apple', label: '苹果' },
		{ value: 'banana', label: '香蕉' },
		{ value: 'orange', label: '橙子' },
		{ value: 'grape', label: '葡萄' },
		{ value: 'mango', label: '芒果' }
	]

		const triggerShow = ref(false)
		const triggerValue = ref('sh')
		const triggerText = ref('上海(sh)')
	const cityList = [
		{ value: 'bj', label: '北京' },
		{ value: 'sh', label: '上海' },
		{ value: 'gz', label: '广州' },
		{ value: 'sz', label: '深圳' },
		{ value: 'cd', label: '成都' }
	]

	const multiShow = ref(false)
	const multiText = ref('未选择')
	const multiList = [
		[
			{ value: 'mon', label: '周一' },
			{ value: 'tue', label: '周二' },
			{ value: 'wed', label: '周三' },
			{ value: 'thu', label: '周四' },
			{ value: 'fri', label: '周五' }
		],
		[
			{ value: 'am', label: '上午' },
			{ value: 'pm', label: '下午' },
			{ value: 'eve', label: '晚上' }
		]
	]

		const cascadeShow = ref(false)
		const cascadeValue = ref(['zhejiang', 'hangzhou', 'xihu'] as string[])
		const cascadeText = ref('浙江(zhejiang) / 杭州(hangzhou) / 西湖(xihu)')
	const cascadeLive = ref('-')
	const regionList = [
		{
			value: 'zhejiang',
			label: '浙江',
			children: [
				{
					value: 'hangzhou',
					label: '杭州',
					children: [
						{ value: 'xihu', label: '西湖' },
						{ value: 'yuhang', label: '余杭' }
					]
				},
				{
					value: 'ningbo',
					label: '宁波',
					children: [
						{ value: 'haishu', label: '海曙' },
						{ value: 'jiangbei', label: '江北' }
					]
				}
			]
		},
		{
			value: 'jiangsu',
			label: '江苏',
			children: [
				{
					value: 'nanjing',
					label: '南京',
					children: [
						{ value: 'xuanwu', label: '玄武' },
						{ value: 'gulou', label: '鼓楼' }
					]
				},
				{
					value: 'suzhou',
					label: '苏州',
					children: [
						{ value: 'gusu', label: '姑苏' },
						{ value: 'wuzhong', label: '吴中' }
					]
				}
			]
		}
	]

	const customShow = ref(false)
	const customText = ref('未选择')
	const customList = [
		{ id: 10, name: '一号方案' },
		{ id: 20, name: '二号方案' },
		{ id: 30, name: '三号方案' }
	]

	function formatItems(items: UTSJSONObject[]): string {
		if (items.length == 0) {
			return '空'
		}
		let text = ''
		let i = 0
		while (i < items.length) {
			const row = items[i]
			const label = row.getString('label')
			const valueAny = row.getAny('value')
			let valueText = ''
			if (valueAny != null) {
				if (typeof valueAny == 'string') {
					valueText = valueAny as string
				} else if (typeof valueAny == 'number') {
					valueText = (valueAny as number).toString()
				}
			}
			const part = (label != null ? label : '') + '(' + valueText + ')'
			if (i > 0) {
				text += ' / '
			}
			text += part
			i++
		}
		return text
	}

	function openSingle() {
		singleShow.value = true
	}

	function onSingleConfirm(items: UTSJSONObject[]) {
		singleText.value = formatItems(items)
		lastEvent.value = 'confirm single'
	}

		function onTriggerConfirm(items: UTSJSONObject[]) {
			triggerText.value = formatItems(items)
			lastEvent.value = 'confirm trigger'
		}
	
		function onTriggerClear() {
			triggerText.value = '未选择'
			lastEvent.value = 'clear trigger'
		}

	function onMultiConfirm(items: UTSJSONObject[]) {
		multiText.value = formatItems(items)
		lastEvent.value = 'confirm multi'
	}

		function onCascadeConfirm(items: UTSJSONObject[]) {
			cascadeText.value = formatItems(items)
			lastEvent.value = 'confirm cascade'
		}
	
		function onCascadeClear() {
			cascadeText.value = '未选择'
			lastEvent.value = 'clear cascade'
		}

	function onCascadeChange(items: UTSJSONObject[]) {
		cascadeLive.value = formatItems(items)
	}

	function onCustomConfirm(items: UTSJSONObject[]) {
		customText.value = formatItems(items)
		lastEvent.value = 'confirm custom'
	}

	function onCancel(name: string) {
		lastEvent.value = 'cancel ' + name
	}
</script>

<style>

	.page-root {
		flex: 1;
		flex-direction: column;
		background-color: var(--nax-color-bg, #ffffff);
		/* #ifndef APP-ANDROID || APP-IOS || APP-HARMONY */
		height: 100%;
		/* #endif */
	}

	.page-scroll {
		flex: 1;
		height: 0;
		background-color: var(--nax-color-bg, #ffffff);
	}
	.page {
		padding: 16px;
		background-color: var(--nax-color-bg, #ffffff);
	}

	.page__title {
		font-size: 20px;
		color: var(--nax-color-text, #333639);
		font-weight: 600;
		margin-bottom: 6px;
	}

	.section {
		margin-bottom: 20px;
		flex-direction: column;
	}

	.section__title {
		font-size: 14px;
		color: var(--nax-color-text, #333639);
		font-weight: 500;
		margin-bottom: 10px;
	}

	.hint {
		font-size: 12px;
		color: var(--nax-color-text-secondary, #767c82);
		margin-top: 6px;
	}
</style>
