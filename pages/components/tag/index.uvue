<template>
	<view class="page-root">
		<nax-nav-bar
			title="nax-tag"
			home-url="/pages/index/index"
			:border="true"
		></nax-nav-bar>
		<scroll-view class="page-scroll" scroll-y="true">
		<view class="nax-theme page" :class="themeExtraClass">
			<text class="page__desc">标签。能力对齐 Naive UI Tag：类型 / 尺寸 / 边框 / 圆角 / 可关闭 / 可选中。</text>

			<view class="section">
				<text class="section__title">基础</text>
				<view class="row">
					<view class="item">
						<nax-tag label="标签"></nax-tag>
					</view>
					<view class="item">
						<nax-tag type="info" label="标签文案"></nax-tag>
					</view>
					<view class="item">
						<nax-tag icon="star" label="图标"></nax-tag>
					</view>
					<view class="item">
						<nax-tag strong label="加粗"></nax-tag>
					</view>
				</view>
			</view>

			<view class="section">
				<text class="section__title">类型 type</text>
				<view class="row">
					<view class="item">
						<nax-tag type="default" label="default"></nax-tag>
					</view>
					<view class="item">
						<nax-tag type="primary" label="primary"></nax-tag>
					</view>
					<view class="item">
						<nax-tag type="info" label="info"></nax-tag>
					</view>
					<view class="item">
						<nax-tag type="success" label="success"></nax-tag>
					</view>
					<view class="item">
						<nax-tag type="warning" label="warning"></nax-tag>
					</view>
					<view class="item">
						<nax-tag type="error" label="error"></nax-tag>
					</view>
				</view>
			</view>

			<view class="section">
				<text class="section__title">层级 variant</text>
				<view class="row">
					<view class="item">
						<nax-tag type="primary" variant="light" label="light"></nax-tag>
					</view>
					<view class="item">
						<nax-tag type="primary" variant="solid" label="solid"></nax-tag>
					</view>
					<view class="item">
						<nax-tag type="primary" variant="outline" label="outline"></nax-tag>
					</view>
					<view class="item">
						<nax-tag type="primary" variant="text" label="text"></nax-tag>
					</view>
				</view>
			</view>

			<view class="section">
				<text class="section__title">尺寸 size</text>
				<view class="row">
					<view class="item">
						<nax-tag size="sm" type="info" label="sm"></nax-tag>
					</view>
					<view class="item">
						<nax-tag size="md" type="info" label="md"></nax-tag>
					</view>
					<view class="item">
						<nax-tag size="lg" type="info" label="lg"></nax-tag>
					</view>
					<view class="item">
						<nax-tag size="tiny" type="info" label="tiny"></nax-tag>
					</view>
					<view class="item">
						<nax-tag size="large" type="info" label="large"></nax-tag>
					</view>
				</view>
			</view>

			<view class="section">
				<text class="section__title">圆角 / 无边框</text>
				<view class="row">
					<view class="item">
						<nax-tag round type="success" label="round"></nax-tag>
					</view>
					<view class="item">
						<nax-tag :bordered="false" type="success" label="no border"></nax-tag>
					</view>
					<view class="item">
						<nax-tag round :bordered="false" type="warning" label="round+无边"></nax-tag>
					</view>
				</view>
			</view>

			<view class="section">
				<text class="section__title">可关闭 closable</text>
				<view class="row">
					<view class="item" v-if="showCloseA">
						<nax-tag closable type="error" label="关闭我" @close="onCloseA" @click="onTagClick('A')"></nax-tag>
					</view>
					<view class="item" v-if="showCloseB">
						<nax-tag
							closable
							:trigger-click-on-close="false"
							type="warning"
							label="关不触发 click"
							@close="onCloseB"
							@click="onTagClick('B')"
						></nax-tag>
					</view>
					<view class="item">
						<nax-button size="sm" label="重置关闭" @click="resetClose"></nax-button>
					</view>
				</view>
				<text class="hint">最近事件：{{ lastEvent }}</text>
			</view>

			<view class="section">
				<text class="section__title">可选中 checkable</text>
				<view class="row">
					<view class="item">
						<nax-tag
							checkable
							type="primary"
							label="可选 primary"
							:checked="checkedPrimary"
							@update:checked="onCheckedPrimary"
						></nax-tag>
					</view>
					<view class="item">
						<nax-tag
							checkable
							type="info"
							label="可选 info"
							:checked="checkedInfo"
							@update:checked="onCheckedInfo"
						></nax-tag>
					</view>
					<view class="item">
						<nax-tag
							checkable
							type="success"
							variant="outline"
							label="outline 可选"
							:checked="checkedOutline"
							@update:checked="onCheckedOutline"
						></nax-tag>
					</view>
				</view>
				<text class="hint">primary={{ checkedPrimary }} · info={{ checkedInfo }} · outline={{ checkedOutline }}</text>
			</view>

			<view class="section">
				<text class="section__title">禁用 disabled</text>
				<view class="row">
					<view class="item">
						<nax-tag disabled label="禁用"></nax-tag>
					</view>
					<view class="item">
						<nax-tag disabled type="primary" label="禁用 primary"></nax-tag>
					</view>
					<view class="item">
						<nax-tag disabled closable type="error" label="禁用关闭"></nax-tag>
					</view>
				</view>
			</view>

			<view class="section">
				<text class="section__title">自定义 color</text>
				<view class="row">
					<view class="item">
						<nax-tag color="#8a2be2" label="紫 light"></nax-tag>
					</view>
					<view class="item">
						<nax-tag color="#8a2be2" variant="solid" label="紫 solid"></nax-tag>
					</view>
					<view class="item">
						<nax-tag color="#8a2be2" variant="outline" label="紫 outline"></nax-tag>
					</view>
					<view class="item">
						<nax-tag color="#ff6b00" text-color="#ff6b00" :bordered="false" label="橙字"></nax-tag>
					</view>
				</view>
			</view>

			<view class="section">
				<text class="section__title">solid × type</text>
				<view class="row">
					<view class="item">
						<nax-tag variant="solid" label="default"></nax-tag>
					</view>
					<view class="item">
						<nax-tag type="primary" variant="solid" label="primary"></nax-tag>
					</view>
					<view class="item">
						<nax-tag type="info" variant="solid" label="info"></nax-tag>
					</view>
					<view class="item">
						<nax-tag type="success" variant="solid" label="success"></nax-tag>
					</view>
					<view class="item">
						<nax-tag type="warning" variant="solid" label="warning"></nax-tag>
					</view>
					<view class="item">
						<nax-tag type="error" variant="solid" label="error"></nax-tag>
					</view>
				</view>
			</view>
		</view>
	</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { bindDemoThemePage } from '@/common/demo-theme.uts'

	const darkMode = ref(bindDemoThemePage())

	const themeExtraClass = computed((): string => {
		if (darkMode.value) {
			return 'nax-theme-dark'
		}
		return ''
	})

	onShow(() => {
		darkMode.value = bindDemoThemePage()
	})

	const showCloseA = ref(true)
	const showCloseB = ref(true)
	const lastEvent = ref('无')

	const checkedPrimary = ref(false)
	const checkedInfo = ref(true)
	const checkedOutline = ref(false)

	function onCloseA() {
		showCloseA.value = false
		lastEvent.value = 'close A'
	}

	function onCloseB() {
		showCloseB.value = false
		lastEvent.value = 'close B'
	}

	function onTagClick(name : string) {
		lastEvent.value = 'click ' + name
	}

	function resetClose() {
		showCloseA.value = true
		showCloseB.value = true
		lastEvent.value = 'reset'
	}

	function onCheckedPrimary(v : boolean) {
		checkedPrimary.value = v
	}

	function onCheckedInfo(v : boolean) {
		checkedInfo.value = v
	}

	function onCheckedOutline(v : boolean) {
		checkedOutline.value = v
	}
</script>

