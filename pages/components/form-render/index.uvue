<template>
	<view class="page-root nax-theme" :class="themeExtraClass">
		<nax-nav-bar
			:back-icon-color="navBackIconColor"
			title="nax-form-render"
			home-url="/pages/index/index"
			:border="true"
		></nax-nav-bar>

		<scroll-view class="page-scroll">
			<view class="nax-theme page" :class="themeExtraClass">
				<nax-alert
					type="info"
					title="schema 驱动"
					description="下方表单由 JSON 渲染，切换配置即换一套字段。校验规则同样由 schema 生成。"
				></nax-alert>

				<view class="section">
					<text class="section__title">选择 schema</text>
					<view class="row">
						<view v-for="(preset, index) in presetNames" :key="preset" class="row__item">
							<nax-tag
								:type="presetIndex == index ? 'primary' : 'default'"
								:variant="presetIndex == index ? 'solid' : 'light'"
								:label="preset"
								checkable
								:checked="presetIndex == index"
								@click="onPickPreset(index)"
							></nax-tag>
						</view>
					</view>
					<text class="hint">切换上面标签可整体替换字段；字段增删由组件自动处理</text>
				</view>

				<view class="section">
					<text class="section__title">账号信息</text>
					<nax-form-render
						ref="formRef"
						v-model="formValue"
						:schema="schema"
						label-width="88"
						@change="onChange"
						@confirm="onConfirm"
					></nax-form-render>

					<view class="actions">
						<nax-button block type="primary" label="提交校验" @click="onSubmit"></nax-button>
						<view class="actions__gap"></view>
						<nax-button block variant="secondary" label="重置" @click="onReset"></nax-button>
						<view class="actions__gap"></view>
						<nax-button block variant="tertiary" label="读取值" @click="onReadValue"></nax-button>
					</view>
					<text class="hint">{{ resultText }}</text>
				</view>

				<view class="section">
					<text class="section__title">当前值</text>
					<text class="hint">{{ valueText }}</text>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { bindDemoThemePage, demoDarkRef, demoNavBackIconColor } from '@/common/demo-theme.uts'

	bindDemoThemePage()
	const darkMode = demoDarkRef

	const navBackIconColor = computed((): string => {
		// Android 模板编译不直接调用导入的 UTS 函数，避免生成未解析的 invoke。
		// #ifdef APP-ANDROID
		return ''
		// #endif
		// #ifndef APP-ANDROID
		return demoNavBackIconColor(darkMode.value)
		// #endif
	})

	const themeExtraClass = computed((): string => {
		if (darkMode.value) {
			return 'nax-theme-dark'
		}
		return ''
	})

	onShow(() => {
		darkMode.value = bindDemoThemePage()
	})

	/** 配置一：账号信息（文本 / 密码 / 选择 / 开关 / 日期） */
	const SCHEMA_ACCOUNT = `[
		{ "prop": "account", "label": "账号", "type": "text", "placeholder": "4-12 位字母或数字", "required": true, "tip": "登录用的唯一标识" },
		{ "prop": "password", "label": "密码", "type": "password", "placeholder": "至少 6 位", "required": true },
		{ "prop": "role", "label": "角色", "type": "select", "placeholder": "请选择角色", "required": true,
			"options": [ { "value": "dev", "label": "开发" }, { "value": "ops", "label": "运维" }, { "value": "pm", "label": "产品" } ] },
		{ "prop": "level", "label": "职级", "type": "number", "required": false, "min": 1, "max": 9 },
		{ "prop": "joinDate", "label": "入职日期", "type": "date", "required": false, "placeholder": "请选择日期" },
		{ "prop": "notify", "label": "接收通知", "type": "switch" }
	]`

	/** 配置二：知识问答（评分 / 滑动 / 多选 / 单选 / 多行文本） */
	const SCHEMA_QUIZ = `[
		{ "prop": "nickname", "label": "昵称", "type": "text", "placeholder": "请输入昵称", "required": true, "maxlength": 20 },
		{ "prop": "gender", "label": "性别", "type": "radio", "required": true,
			"options": [ { "value": "m", "label": "男" }, { "value": "f", "label": "女" } ] },
		{ "prop": "skills", "label": "技能", "type": "checkbox-group", "required": false,
			"options": [ { "value": "js", "label": "JS" }, { "value": "ts", "label": "TS" }, { "value": "kt", "label": "Kotlin" } ] },
		{ "prop": "score", "label": "自评", "type": "rate", "max": 5, "min": 1 },
		{ "prop": "experience", "label": "经验年限", "type": "slider", "min": 0, "max": 20, "step": 1 },
		{ "prop": "agree", "label": "协议", "type": "checkbox", "placeholder": "已阅读并同意", "required": false },
		{ "prop": "remark", "label": "备注", "type": "textarea", "placeholder": "补充说明（选填）", "required": false }
	]`

	/** nax-form-render 的 expose 类型；App UTS 不能用 any 调组件方法 */
	type NaxFormRenderExpose = {
		validate : () => Promise<boolean>,
		validateField : (fieldProps : any | null, event : string) => UTSJSONObject[],
		resetFields : () => void,
		clearValidate : (fieldProps : any | null) => void,
		setSchema : (schema : any | null) => void,
		getModel : () => UTSJSONObject
	}

	const presetNames = ['账号信息', '知识问答'] as string[]
	const presetIndex = ref(0)
	const schema = ref(SCHEMA_ACCOUNT)

	const formRef = ref(null as NaxFormRenderExpose | null)
	const formValue = ref({} as UTSJSONObject)
	const resultText = ref('—')
	const valueText = ref('（尚未操作）')

	function onPickPreset(index : number) {
		presetIndex.value = index
		schema.value = index == 1 ? SCHEMA_QUIZ : SCHEMA_ACCOUNT
		resultText.value = '已切换 schema：' + presetNames[index]
		updateValueText()
	}

	function onChange(payload : UTSJSONObject) {
		const prop = payload.getString('prop')
		const p = prop != null ? prop : ''
		resultText.value = 'change：' + p
		updateValueText()
	}

	function onConfirm(payload : UTSJSONObject) {
		const prop = payload.getString('prop')
		const value = payload.getString('value')
		resultText.value = 'confirm ' + (prop != null ? prop : '') + ' → ' + (value != null ? value : '')
		updateValueText()
	}

	function getTarget() : NaxFormRenderExpose | null {
		return formRef.value
	}

	function updateValueText() {
		const t = getTarget()
		if (t == null) {
			valueText.value = '（组件未就绪）'
			return
		}
		valueText.value = JSON.stringify(t.getModel())
	}

	function onSubmit() {
		const t = getTarget()
		if (t == null) {
			resultText.value = '组件未就绪'
			return
		}
		const p = t.validate() as Promise<boolean>
		p.then((_ok : boolean) => {
			resultText.value = '校验通过'
			updateValueText()
			uni.showToast({ title: '校验通过', icon: 'success' })
		}).catch((_err : any | null) => {
			resultText.value = '校验失败，请查看字段提示'
		})
	}

	function onReset() {
		const t = getTarget()
		if (t == null) {
			return
		}
		t.resetFields()
		resultText.value = '已重置'
		updateValueText()
	}

	function onReadValue() {
		updateValueText()
		resultText.value = '已读取当前值'
	}

	onReady(() => {
		updateValueText()
	})
</script>

<style>
	.page-root {
		flex: 1;
		flex-direction: column;
		background-color: var(--nax-color-bg-secondary, #fafafc);
		/* #ifndef APP-ANDROID || APP-IOS || APP-HARMONY */
		height: 100%;
		/* #endif */
	}

	.page-scroll {
		flex: 1;
		height: 0;
	}

	.page {
		flex-direction: column;
		padding: 16px;
		background-color: var(--nax-color-bg-secondary, #fafafc);
	}

	.section {
		flex-direction: column;
		margin-bottom: 16px;
		padding: 14px;
		background-color: var(--nax-color-bg, #ffffff);
		border-radius: 8px;
		border-width: 1px;
		border-style: solid;
		border-color: var(--nax-color-border, #f0f0f3);
	}

	.section__title {
		font-size: 15px;
		font-weight: 500;
		color: var(--nax-color-text, #333639);
		margin-bottom: 12px;
	}

	.hint {
		margin-top: 8px;
		font-size: 13px;
		line-height: 18px;
		color: var(--nax-color-text-secondary, #767c82);
	}

	.row {
		flex-direction: row;
		align-items: center;
	}

	.row__item {
		margin-right: 8px;
	}

	.actions {
		margin-top: 16px;
		flex-direction: column;
	}

	.actions__gap {
		height: 10px;
	}
</style>
