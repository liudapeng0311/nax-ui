<template>
	<view class="page-root nax-theme" :class="themeExtraClass">
		<nax-nav-bar
			:back-icon-color="navBackIconColor"
			title="nax-radio"
			home-url="/pages/index/index"
			:border="true"
		></nax-nav-bar>
		<scroll-view class="page-scroll" scroll-y="true">
		<view class="nax-theme page" :class="themeExtraClass">

			<view class="section">
				<text class="section__title">单独使用</text>
				<nax-radio v-model="alone" label="默认选项" @change="onAloneChange"></nax-radio>
				<text class="hint">checked：{{ aloneText }} · {{ lastEvent }}</text>
			</view>

			<view class="section">
				<text class="section__title">基础组</text>
				<nax-radio-group v-model="basic" @change="onGroupChange">
					<nax-radio name="apple" label="苹果"></nax-radio>
					<nax-radio name="banana" label="香蕉"></nax-radio>
					<nax-radio name="orange" label="橙子"></nax-radio>
				</nax-radio-group>
				<text class="hint">值：{{ basic }}</text>
			</view>

			<view class="section">
				<text class="section__title">形状 shape</text>
				<view class="block">
					<nax-radio-group v-model="shapeCircle" shape="circle">
						<nax-radio name="c1" label="圆形（默认）"></nax-radio>
						<nax-radio name="c2" label="另一项"></nax-radio>
					</nax-radio-group>
				</view>
				<view class="block">
					<nax-radio-group v-model="shapeSquare" shape="square">
						<nax-radio name="s1" label="方形"></nax-radio>
						<nax-radio name="s2" label="另一项"></nax-radio>
					</nax-radio-group>
				</view>
			</view>

			<view class="section">
				<text class="section__title">尺寸 size</text>
				<view class="block">
					<nax-radio-group v-model="sizeSm" size="sm">
						<nax-radio name="s" label="sm"></nax-radio>
					</nax-radio-group>
				</view>
				<view class="block">
					<nax-radio-group v-model="sizeMd" size="md">
						<nax-radio name="m" label="md"></nax-radio>
					</nax-radio-group>
				</view>
				<view class="block">
					<nax-radio-group v-model="sizeLg" size="lg">
						<nax-radio name="l" label="lg"></nax-radio>
					</nax-radio-group>
				</view>
			</view>

			<view class="section">
				<text class="section__title">禁用 disabled</text>
				<nax-radio-group v-model="disabledVals">
					<nax-radio name="on" label="可选"></nax-radio>
					<nax-radio name="off" label="禁用项" disabled></nax-radio>
				</nax-radio-group>
				<view class="block">
					<nax-radio-group v-model="disabledGroup" disabled>
						<nax-radio name="g1" label="整组禁用"></nax-radio>
						<nax-radio name="g2" label="不可点"></nax-radio>
					</nax-radio-group>
				</view>
			</view>

			<view class="section">
				<text class="section__title">文案不可点 labelDisabled</text>
				<nax-radio-group v-model="labelLock" label-disabled>
					<nax-radio name="x" label="只能点左侧圆框"></nax-radio>
					<nax-radio name="y" label="点文字无效"></nax-radio>
				</nax-radio-group>
			</view>

			<view class="section">
				<text class="section__title">纵向排列 wrap</text>
				<nax-radio-group v-model="wrapVal" wrap>
					<nax-radio name="1" label="选项一"></nax-radio>
					<nax-radio name="2" label="选项二"></nax-radio>
					<nax-radio name="3" label="选项三"></nax-radio>
				</nax-radio-group>
				<text class="hint">值：{{ wrapVal }}</text>
			</view>

			<view class="section">
				<text class="section__title">自定义颜色 activeColor</text>
				<nax-radio-group v-model="colorVal" active-color="#2080f0">
					<nax-radio name="c1" label="信息色"></nax-radio>
					<nax-radio name="c2" label="另一项"></nax-radio>
				</nax-radio-group>
			</view>

			<view class="section">
				<text class="section__title">横向均分 width</text>
				<nax-radio-group v-model="widthVal" width="50%">
					<nax-radio name="w1" label="左侧 50%"></nax-radio>
					<nax-radio name="w2" label="右侧 50%"></nax-radio>
					<nax-radio name="w3" label="再一行左"></nax-radio>
					<nax-radio name="w4" label="再一行右"></nax-radio>
				</nax-radio-group>
			</view>
		</view>
	</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { bindDemoThemePage, demoDarkRef, demoNavBackIconColor } from '@/common/demo-theme.uts'

	bindDemoThemePage()
	const darkMode = demoDarkRef

	const navBackIconColor = computed((): string => {
		// Android 模板编译不直接调用导入的 UTS 函数，避免生成未解析的 invoke。
		// #ifdef APP-ANDROID
		return ''
		// #endif
		// #ifndef APP-ANDROID
		return demoNavBackIconColor(darkMode.value)
		// #endif
	})

	const themeExtraClass = computed((): string => {
		if (darkMode.value) {
			return 'nax-theme-dark'
		}
		return ''
	})

	onShow(() => {
		darkMode.value = bindDemoThemePage()
	})

	const alone = ref(true)
	const aloneText = computed((): string => {
		if (alone.value) {
			return 'true'
		}
		return 'false'
	})

	const basic = ref('apple')
	const shapeCircle = ref('c1')
	const shapeSquare = ref('s1')
	const sizeSm = ref('s')
	const sizeMd = ref('m')
	const sizeLg = ref('l')
	const disabledVals = ref('on')
	const disabledGroup = ref('g1')
	const labelLock = ref('x')
	const wrapVal = ref('1')
	const colorVal = ref('c1')
	const widthVal = ref('w1')

	const lastEvent = ref('—')

	function onAloneChange(v : boolean) {
		if (v) {
			lastEvent.value = 'change: true'
		} else {
			lastEvent.value = 'change: false'
		}
	}

	function onGroupChange(v : string) {
		lastEvent.value = 'group: ' + v
	}
</script>

<style>

	.page-root {
		flex: 1;
		flex-direction: column;
		/* #ifndef APP-ANDROID || APP-IOS || APP-HARMONY */
		height: 100%;
		/* #endif */
	}

	.page-scroll {
		flex: 1;
		height: 0;
	}
	.page {
		padding: 16px;
		background-color: var(--nax-color-bg-secondary, #fafafc);
	}

	.page__title {
		font-size: 20px;
		color: var(--nax-color-text, #333639);
		font-weight: 600;
		margin-bottom: 6px;
	}

	.section {
		margin-bottom: 16px;
		padding: 14px;
		background-color: var(--nax-color-bg, #ffffff);
		border-radius: var(--nax-radius-md, 3px);
		border-width: 1px;
		border-style: solid;
		border-color: var(--nax-color-border, #f0f0f3);
	}

	.section__title {
		font-size: 14px;
		font-weight: 500;
		color: var(--nax-color-text, #333639);
		margin-bottom: 12px;
	}

	.hint {
		font-size: 12px;
		color: var(--nax-color-text-secondary, #767c82);
		margin-top: 8px;
	}

	.block {
		margin-top: 8px;
	}
</style>
