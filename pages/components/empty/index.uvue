<template>
	<scroll-view style="flex:1" scroll-y="true">
		<view class="nax-theme page" :class="themeExtraClass">
			<text class="page__title">nax-empty</text>
			<text class="page__desc">空状态。无数据 / 搜索无结果 / 失败占位，可配描述与操作。</text>

			<view class="section">
				<text class="section__title">基础</text>
				<view class="panel">
					<nax-empty></nax-empty>
				</view>
			</view>

			<view class="section">
				<text class="section__title">标题 + 描述</text>
				<view class="panel">
					<nax-empty icon="notes-off" title="暂无订单" description="下单后，订单会出现在这里"></nax-empty>
				</view>
			</view>

			<view class="section">
				<text class="section__title">图标语义</text>
				<view class="panel">
					<nax-empty icon="file-off" description="暂无相关文件"></nax-empty>
				</view>
				<view class="panel panel--gap">
					<nax-empty icon="notes-off" description="暂无列表"></nax-empty>
				</view>
				<view class="panel panel--gap">
					<nax-empty icon="database-off" description="暂无数据"></nax-empty>
				</view>
				<view class="panel panel--gap">
					<nax-empty icon="message-off" description="消息箱是空的"></nax-empty>
				</view>
			</view>

			<view class="section">
				<text class="section__title">操作按钮</text>
				<view class="panel">
					<nax-empty icon="notes-off" title="列表为空" description="试着新建一条数据吧">
						<template #action>
							<nax-button type="primary" size="sm" label="新建" @click="onCreate"></nax-button>
						</template>
					</nax-empty>
				</view>
			</view>

			<view class="section">
				<text class="section__title">多个操作</text>
				<view class="panel">
					<nax-empty icon="search" description="换个关键词试试">
						<template #action>
							<nax-space size="sm">
								<nax-space-item>
									<nax-button size="sm" label="清空筛选" @click="onClear"></nax-button>
								</nax-space-item>
								<nax-space-item>
									<nax-button type="primary" size="sm" label="重新搜索" @click="onSearch"></nax-button>
								</nax-space-item>
							</nax-space>
						</template>
					</nax-empty>
				</view>
			</view>

			<view class="section">
				<text class="section__title">尺寸 image-size</text>
				<view class="panel">
					<nax-empty image-size="sm" description="小号 sm"></nax-empty>
				</view>
				<view class="panel panel--gap">
					<nax-empty image-size="md" description="中号 md（默认档）"></nax-empty>
				</view>
			</view>

			<view class="section">
				<text class="section__title">隐藏插图</text>
				<view class="panel">
					<nax-empty :show-image="false" description="仅文案的空状态"></nax-empty>
				</view>
			</view>

			<view class="section">
				<text class="section__title">自定义插图槽</text>
				<view class="panel">
					<nax-empty description="使用 #image 自定义">
						<template #image>
							<view class="custom-illu">
								<nax-icon name="star" size="40" color="#f0a020"></nax-icon>
							</view>
						</template>
						<template #action>
							<nax-button size="sm" type="warning" label="去收藏" @click="onStar"></nax-button>
						</template>
					</nax-empty>
				</view>
			</view>

			<view class="section">
				<text class="section__title">事件反馈</text>
				<text class="hint">最近操作：{{ lastEvent }}</text>
			</view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import { bindDemoThemePage } from '@/common/demo-theme.uts'

	const darkMode = ref(bindDemoThemePage())
	const lastEvent = ref('无')

	const themeExtraClass = computed((): string => {
		if (darkMode.value) {
			return 'nax-theme-dark'
		}
		return ''
	})

	onShow(() => {
		darkMode.value = bindDemoThemePage()
	})

	function onCreate() {
		lastEvent.value = '新建'
		uni.showToast({ title: '新建', icon: 'none' })
	}

	function onClear() {
		lastEvent.value = '清空筛选'
		uni.showToast({ title: '已清空', icon: 'none' })
	}

	function onSearch() {
		lastEvent.value = '重新搜索'
		uni.showToast({ title: '搜索', icon: 'none' })
	}

	function onStar() {
		lastEvent.value = '去收藏'
		uni.showToast({ title: '收藏', icon: 'none' })
	}
</script>

<style>
	.page {
		padding: 16px;
		background-color: var(--nax-color-bg-secondary, #fafafc);
		flex-direction: column;
	}

	.page__title {
		font-size: 20px;
		color: var(--nax-color-text, #333639);
		font-weight: 600;
		margin-bottom: 6px;
	}

	.page__desc {
		font-size: 13px;
		color: var(--nax-color-text-secondary, #767c82);
		margin-bottom: 16px;
	}

	.section {
		margin-bottom: 20px;
		flex-direction: column;
	}

	.section__title {
		font-size: 14px;
		color: var(--nax-color-text, #333639);
		font-weight: 500;
		margin-bottom: 10px;
	}

	.panel {
		flex-direction: column;
		background-color: var(--nax-color-bg, #ffffff);
		border-radius: var(--nax-radius-md, 8px);
		overflow: hidden;
	}

	.panel--gap {
		margin-top: 12px;
	}

	.custom-illu {
		width: 96px;
		height: 96px;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		background-color: var(--nax-color-warning-secondary, #fcefda);
		border-radius: var(--nax-radius-full, 999px);
	}

	.hint {
		font-size: 12px;
		color: var(--nax-color-text-secondary, #767c82);
	}
</style>
