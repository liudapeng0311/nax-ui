<template>
	<view class="page-root nax-theme" :class="themeExtraClass">
		<nax-nav-bar
			:back-icon-color="navBackIconColor"
			title="useInterval 轮询"
			home-url="/pages/index/index"
			:border="true"
		></nax-nav-bar>
		<scroll-view class="page-scroll">
		<view class="nax-theme page" :class="themeExtraClass">

			<view class="section">
				<text class="section__title">可控轮询（500ms，immediate: false）</text>
				<view class="row">
					<nax-button size="sm" type="primary" :label="poller.running ? '停止' : '开始'" @click="onToggle"></nax-button>
					<view class="gap"></view>
					<text class="row__text">状态：{{ poller.running ? '运行中' : '已停止' }} · 已执行 {{ poller.count }} 次</text>
				</view>
				<view class="row row--gap">
					<text class="row__text">最近触发：{{ lastTick }}</text>
				</view>
				<view class="row row--gap">
					<text class="row__text">stop 后可再次 start，计数不清零</text>
				</view>
			</view>

			<view class="section">
				<text class="section__title">说明</text>
				<text class="code">const poller = useInterval(fn, 500, false)</text>
				<text class="code">poller.start() / poller.stop()</text>
				<text class="code">组件内使用：页面卸载自动 stop</text>
			</view>

		</view>
	</scroll-view>
	</view>
</template>

<script setup>
	import { computed, ref } from 'vue'
	import { bindDemoThemePage, demoDarkRef, demoNavBackIconColor } from '@/common/demo-theme.uts'
	import { useInterval } from '@/uni_modules/nax-use/composables/use-interval.uts'

	bindDemoThemePage()
	const darkMode = demoDarkRef

	const navBackIconColor = computed((): string => {
		// Android 模板编译不直接调用导入的 UTS 函数，避免生成未解析的 invoke。
		// #ifdef APP-ANDROID
		return ''
		// #endif
		// #ifndef APP-ANDROID
		return demoNavBackIconColor(darkMode.value)
		// #endif
	})

	const themeExtraClass = computed((): string => {
		if (darkMode.value) {
			return 'nax-theme-dark'
		}
		return ''
	})

	onShow(() => {
		darkMode.value = bindDemoThemePage()
	})

	const lastTick = ref('—')
	function pad2(n : number) : string {
		return n < 10 ? '0' + n.toString() : n.toString()
	}
	const poller = useInterval(() => {
		const d = new Date()
		lastTick.value = pad2(d.getHours()) + ':' + pad2(d.getMinutes()) + ':' + pad2(d.getSeconds())
	}, 500, false)
	const onToggle = () => {
		if (poller.running) {
			poller.stop()
			return
		}
		poller.start()
	}
</script>

<style>

	.page-root {
		flex: 1;
		flex-direction: column;
		/* #ifndef APP-ANDROID || APP-IOS || APP-HARMONY */
		height: 100%;
		/* #endif */
	}

	.page-scroll {
		flex: 1;
		height: 0;
	}
	.page {
		padding: 16px;
		background-color: var(--nax-color-bg-secondary, #fafafc);
	}

	.section {
		margin-bottom: 16px;
		padding: 14px;
		background-color: var(--nax-color-bg, #ffffff);
		border-radius: var(--nax-radius-md, 3px);
		border-width: 1px;
		border-style: solid;
		border-color: var(--nax-color-border, #f0f0f3);
	}

	.section__title {
		font-size: 14px;
		font-weight: 500;
		color: var(--nax-color-text, #333639);
		margin-bottom: 12px;
	}

	.row {
		flex-direction: row;
		align-items: center;
	}

	.row--gap {
		margin-top: 12px;
	}

	.row__text {
		font-size: 13px;
		color: var(--nax-color-text-secondary, #767c82);
		flex: 1;
	}

	.gap {
		width: 8px;
	}

	.code {
		font-size: 12px;
		color: var(--nax-color-text-secondary, #767c82);
		margin-bottom: 4px;
	}
</style>
