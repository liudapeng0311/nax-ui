<script setup lang="uts">
	import { bindDemoThemePage, demoNavBackIconColor } from '@/common/demo-theme.uts'

	const darkMode = ref(bindDemoThemePage())

	const themeExtraClass = computed((): string => {
		if (darkMode.value) {
			return 'nax-theme-dark'
		}
		return ''
	})

	onShow(() => {
		darkMode.value = bindDemoThemePage()
	})

	// demo image: repo static; bad url for error / fallback
	// Web caches same-url images aggressively; bump v after replacing static/logo.png
	const okSrc = '/static/logo.png?v=2'
	const badSrc = 'https://example.com/nax-avatar-not-found.png'

	function onAvatarClick() {
		uni.showToast({
			title: 'avatar click',
			icon: 'none'
		})
	}

	function onError() {
		console.log('nax-avatar error')
	}
</script>

