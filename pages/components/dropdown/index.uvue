<template>
	<view class="page-root">
		<nax-nav-bar
			title="nax-dropdown"
			home-url="/pages/index/index"
			:border="true"
		></nax-nav-bar>
		<scroll-view class="page-scroll" scroll-y="true">
			<view class="nax-theme page" :class="themeExtraClass">
				<text class="page__desc">筛选栏式下拉菜单：多 Tab + 默认单选 / 自定义面板；token 主题；选中自动高亮。</text>

				<view class="section">
					<text class="section__title">基础（附近 / 排序 / 价格）</text>
					<nax-dropdown border-bottom @open="onOpen" @close="onClose" @change="onMenuChange">
						<nax-dropdown-item
							v-model="nearValue"
							title="附近"
							:options="nearOptions"
							@change="onNearChange"
						></nax-dropdown-item>
						<nax-dropdown-item
							v-model="sortValue"
							title="排序"
							:options="sortOptions"
						></nax-dropdown-item>
						<nax-dropdown-item
							v-model="priceValue"
							title="价格"
							:options="priceOptions"
							display-selected
						></nax-dropdown-item>
					</nax-dropdown>
					<view class="panel">
						<text class="panel__text">附近：{{ nearLabel }}</text>
						<text class="panel__text">排序：{{ sortLabel }}</text>
						<text class="panel__text">价格：{{ priceLabel }}（标题 displaySelected）</text>
						<text class="hint">最近事件：{{ lastEvent }}</text>
					</view>
				</view>

				<view class="section">
					<text class="section__title">自定义面板 + 手动关闭</text>
					<nax-dropdown ref="filterDropdown" border-bottom border-radius="12">
						<nax-dropdown-item title="筛选" :highlighted="filterActive">
							<view class="filter-panel">
								<text class="filter-panel__label">仅看包邮</text>
								<nax-switch v-model="onlyFreeShip"></nax-switch>
							</view>
							<view class="filter-panel filter-panel--gap">
								<text class="filter-panel__label">仅看有货</text>
								<nax-switch v-model="onlyInStock"></nax-switch>
							</view>
							<view class="filter-actions">
								<nax-button size="sm" label="重置" @click="resetFilter"></nax-button>
								<view class="filter-actions__gap"></view>
								<nax-button size="sm" type="primary" label="确定" @click="confirmFilter"></nax-button>
							</view>
						</nax-dropdown-item>
						<nax-dropdown-item
							v-model="brandValue"
							title="品牌"
							:options="brandOptions"
							height="200"
						></nax-dropdown-item>
					</nax-dropdown>
					<view class="panel">
						<text class="panel__text">筛选生效：{{ filterActive ? '是' : '否' }}</text>
						<text class="panel__text">包邮={{ onlyFreeShip }} / 有货={{ onlyInStock }}</text>
						<text class="panel__text">品牌：{{ brandLabel }}</text>
						<text class="hint">品牌列表 height=200 可滚动</text>
					</view>
				</view>

				<view class="section">
					<text class="section__title">尺寸 size / 禁用项</text>
					<nax-dropdown size="sm" border-bottom>
						<nax-dropdown-item v-model="sizeValue" title="小号" :options="sizeOptions"></nax-dropdown-item>
						<nax-dropdown-item title="禁用" disabled :options="sizeOptions"></nax-dropdown-item>
					</nax-dropdown>
					<view class="block-gap"></view>
					<nax-dropdown size="lg" border-bottom>
						<nax-dropdown-item v-model="sizeValue" title="大号" :options="sizeOptions"></nax-dropdown-item>
						<nax-dropdown-item v-model="sizeValue2" title="大号2" :options="sizeOptions"></nax-dropdown-item>
					</nax-dropdown>
				</view>

				<view class="section">
					<text class="section__title">命令式 open / close</text>
					<view class="row">
						<nax-button size="sm" label="打开第 0 项" @click="openFirst"></nax-button>
						<view class="gap"></view>
						<nax-button size="sm" label="关闭" @click="closeCmd"></nax-button>
					</view>
					<view class="block-gap"></view>
					<nax-dropdown ref="cmdDropdown" border-bottom>
						<nax-dropdown-item v-model="cmdValue" title="命令式" :options="nearOptions"></nax-dropdown-item>
						<nax-dropdown-item v-model="cmdValue2" title="第二项" :options="sortOptions"></nax-dropdown-item>
					</nax-dropdown>
				</view>

				<view class="section section--list">
					<text class="section__title">下方列表（验证遮罩不挡滚动关闭后点击）</text>
					<view v-for="(row, idx) in fakeList" :key="idx" class="list-row">
						<text class="list-row__text">列表项 {{ idx + 1 }} · {{ row }}</text>
					</view>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { bindDemoThemePage } from '@/common/demo-theme.uts'

	const darkMode = ref(bindDemoThemePage())

	const themeExtraClass = computed((): string => {
		if (darkMode.value) {
			return 'nax-theme-dark'
		}
		return ''
	})

	onShow(() => {
		darkMode.value = bindDemoThemePage()
	})

	const lastEvent = ref('无')

	const nearValue = ref('1')
	const sortValue = ref('default')
	const priceValue = ref('')
	const brandValue = ref('')
	const sizeValue = ref('a')
	const sizeValue2 = ref('b')
	const cmdValue = ref('')
	const cmdValue2 = ref('')

	const nearOptions = [
		{ label: '附近', value: '1' },
		{ label: '500m', value: '2' },
		{ label: '1km', value: '3' },
		{ label: '3km', value: '4' }
	]

	const sortOptions = [
		{ label: '智能排序', value: 'default' },
		{ label: '距离优先', value: 'distance' },
		{ label: '好评优先', value: 'rate' },
		{ label: '销量优先', value: 'sales' }
	]

	const priceOptions = [
		{ label: '不限', value: '' },
		{ label: '0-50', value: '0-50' },
		{ label: '50-100', value: '50-100' },
		{ label: '100 以上', value: '100+' }
	]

	const brandOptions = [
		{ label: '全部品牌', value: '' },
		{ label: '品牌 A', value: 'a' },
		{ label: '品牌 B', value: 'b' },
		{ label: '品牌 C', value: 'c' },
		{ label: '品牌 D', value: 'd' },
		{ label: '品牌 E', value: 'e' },
		{ label: '品牌 F', value: 'f' },
		{ label: '品牌 G', value: 'g' }
	]

	const sizeOptions = [
		{ label: '选项 A', value: 'a' },
		{ label: '选项 B', value: 'b' },
		{ label: '选项 C', value: 'c' }
	]

	const onlyFreeShip = ref(false)
	const onlyInStock = ref(false)
	const filterActive = ref(false)

	// App UTS：不能对 any 调 open/close，需显式暴露类型
	type NaxDropdownExpose = {
		open : (index : number) => void
		close : () => void
	}
	const filterDropdown = ref(null as NaxDropdownExpose | null)
	const cmdDropdown = ref(null as NaxDropdownExpose | null)

	const fakeList = [
		'可点击区域 1',
		'可点击区域 2',
		'可点击区域 3',
		'可点击区域 4',
		'可点击区域 5',
		'可点击区域 6'
	]

	function labelOf(options : any[], value : string, emptyText : string) : string {
		if (value.length == 0) {
			return emptyText
		}
		var i = 0
		while (i < options.length) {
			const row = options[i] as UTSJSONObject
			const v = row['value']
			if (v != null && ('' + v) == value) {
				const lab = row['label']
				if (lab != null) {
					return '' + lab
				}
			}
			i++
		}
		return value
	}

	const nearLabel = computed((): string => {
		return labelOf(nearOptions as any[], nearValue.value, '未选')
	})

	const sortLabel = computed((): string => {
		return labelOf(sortOptions as any[], sortValue.value, '未选')
	})

	const priceLabel = computed((): string => {
		return labelOf(priceOptions as any[], priceValue.value, '不限')
	})

	const brandLabel = computed((): string => {
		return labelOf(brandOptions as any[], brandValue.value, '全部')
	})

	function onOpen(index : number) {
		lastEvent.value = 'open index=' + index.toString()
	}

	function onClose(index : number) {
		lastEvent.value = 'close index=' + index.toString()
	}

	function onMenuChange(index : number) {
		lastEvent.value = 'change menu index=' + index.toString()
	}

	function onNearChange(value : string) {
		lastEvent.value = 'near change=' + value
	}


	function callDropdownMethod(target : NaxDropdownExpose | null, methodName : string, index : number) {
		if (target == null) {
			return
		}
		if (methodName == 'close') {
			target.close()
			return
		}
		if (methodName == 'open') {
			target.open(index)
			return
		}
	}
	function resetFilter() {
		onlyFreeShip.value = false
		onlyInStock.value = false
		filterActive.value = false
	}

	function confirmFilter() {
		filterActive.value = onlyFreeShip.value || onlyInStock.value
		callDropdownMethod(filterDropdown.value, 'close', 0)
		lastEvent.value = 'filter confirm active=' + (filterActive.value ? '1' : '0')
	}

	function openFirst() {
		callDropdownMethod(cmdDropdown.value, 'open', 0)
	}

	function closeCmd() {
		callDropdownMethod(cmdDropdown.value, 'close', 0)
	}
</script>

<style>
	.page-root {
		flex: 1;
		flex-direction: column;
		/* #ifndef APP-ANDROID || APP-IOS || APP-HARMONY */
		height: 100%;
		/* #endif */
	}

	.page-scroll {
		flex: 1;
		height: 0;
	}

	.page {
		flex-direction: column;
		padding: 16px;
		padding-bottom: 40px;
	}

	.page__title {
		font-size: 20px;
		line-height: 28px;
		color: var(--nax-color-text, #303133);
		font-weight: bold;
	}

	.page__desc {
		margin-top: 6px;
		font-size: 13px;
		line-height: 18px;
		color: var(--nax-color-text-secondary, #909399);
	}

	.section {
		margin-top: 20px;
		flex-direction: column;
	}

	.section__title {
		margin-bottom: 10px;
		font-size: 15px;
		line-height: 22px;
		color: var(--nax-color-text, #303133);
		font-weight: bold;
	}

	.panel {
		margin-top: 10px;
		padding: 12px;
		border-radius: 8px;
		background-color: var(--nax-color-bg-secondary, #f5f5f5);
		flex-direction: column;
	}

	.panel__text {
		font-size: 13px;
		line-height: 20px;
		color: var(--nax-color-text, #303133);
	}

	.hint {
		margin-top: 4px;
		font-size: 12px;
		line-height: 18px;
		color: var(--nax-color-text-secondary, #909399);
	}

	.block-gap {
		height: 12px;
	}

	.row {
		flex-direction: row;
		align-items: center;
	}

	.gap {
		width: 8px;
	}

	.filter-panel {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding-left: 16px;
		padding-right: 16px;
		height: 48px;
	}

	.filter-panel--gap {
		border-top-width: 0.5px;
		border-top-style: solid;
		border-top-color: var(--nax-color-border, #f0f0f3);
	}

	.filter-panel__label {
		font-size: 15px;
		line-height: 22px;
		color: var(--nax-color-text, #303133);
	}

	.filter-actions {
		flex-direction: row;
		align-items: center;
		justify-content: flex-end;
		padding: 12px 16px 16px 16px;
	}

	.filter-actions__gap {
		width: 8px;
	}

	.list-row {
		padding: 14px 12px;
		border-bottom-width: 0.5px;
		border-bottom-style: solid;
		border-bottom-color: var(--nax-color-border, #f0f0f3);
		flex-direction: row;
	}

	.list-row__text {
		font-size: 14px;
		line-height: 20px;
		color: var(--nax-color-text-secondary, #909399);
	}

	.section--list {
		margin-bottom: 24px;
	}
</style>


