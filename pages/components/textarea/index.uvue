<template>
	<view class="page-root">
		<nax-nav-bar
			title="nax-textarea"
			home-url="/pages/index/index"
			:border="true"
		></nax-nav-bar>
		<scroll-view
			class="page-scroll"
			scroll-y="true"
			:scroll-top="scrollTop"
			:scroll-with-animation="false"
			@scroll="onPageScroll"
		>
		<view class="nax-theme page" :class="themeExtraClass">
			<text class="page__desc">多行输入（对齐 uView Pro Textarea 主能力，不含 formatter）</text>

			<view id="sec-basic" class="section">
				<text class="section__title">基础用法</text>
				<nax-textarea
					v-model="basic"
					:adjust-position="textareaAdjustPosition"
					placeholder="请输入内容"
					@click="onFieldFocus('sec-basic')"
					@focus="onFieldFocus('sec-basic')"
					@blur="onFieldBlur"
					@keyboardheightchange="onTaKeyboard"
					@change="onChange('basic')"
				></nax-textarea>
				<text class="hint">值：{{ basic }}</text>
			</view>

			<view id="sec-count" class="section">
				<text class="section__title">字数统计 count</text>
				<nax-textarea
					v-model="withCount"
					count
					:maxlength="100"
					:adjust-position="textareaAdjustPosition"
					placeholder="最多 100 字"
					@click="onFieldFocus('sec-count')"
					@focus="onFieldFocus('sec-count')"
					@blur="onFieldBlur"
					@keyboardheightchange="onTaKeyboard"
				></nax-textarea>
			</view>

			<view id="sec-auto" class="section">
				<text class="section__title">自动增高 auto-height</text>
				<nax-textarea
					v-model="autoH"
					auto-height
					height="70"
					:adjust-position="textareaAdjustPosition"
					placeholder="输入时自动增高"
					@click="onFieldFocus('sec-auto')"
					@focus="onFieldFocus('sec-auto')"
					@blur="onFieldBlur"
					@keyboardheightchange="onTaKeyboard"
				></nax-textarea>
			</view>

			<view id="sec-plain" class="section">
				<text class="section__title">无边框 / 背景色</text>
				<view class="panel">
					<nax-textarea
						v-model="plain"
						:border="false"
						:adjust-position="textareaAdjustPosition"
						placeholder="无边框"
						@click="onFieldFocus('sec-plain')"
						@focus="onFieldFocus('sec-plain')"
						@blur="onFieldBlur"
						@keyboardheightchange="onTaKeyboard"
					></nax-textarea>
				</view>
				<view class="item item--gap">
					<nax-textarea
						v-model="plainBg"
						:border="false"
						background="#f3f3f5"
						:adjust-position="textareaAdjustPosition"
						placeholder="无边框 + 背景色"
						@click="onFieldFocus('sec-plain')"
						@focus="onFieldFocus('sec-plain')"
						@blur="onFieldBlur"
						@keyboardheightchange="onTaKeyboard"
					></nax-textarea>
				</view>
			</view>

			<view id="sec-bottom-border" class="section">
				<text class="section__title">仅下边框 border-type=bottom</text>
				<nax-textarea
					v-model="bottomBorder"
					border
					border-type="bottom"
					:adjust-position="textareaAdjustPosition"
					placeholder="下划线风格"
					@click="onFieldFocus('sec-bottom-border')"
					@focus="onFieldFocus('sec-bottom-border')"
					@blur="onFieldBlur"
					@keyboardheightchange="onTaKeyboard"
				></nax-textarea>
			</view>

			<view id="sec-size" class="section">
				<text class="section__title">尺寸 size</text>
				<view id="sec-size-sm" class="item">
					<nax-textarea
						v-model="sizeSm"
						size="sm"
						height="56"
						:adjust-position="textareaAdjustPosition"
						placeholder="sm"
						@click="onFieldFocus('sec-size-sm')"
						@focus="onFieldFocus('sec-size-sm')"
						@blur="onFieldBlur"
						@keyboardheightchange="onTaKeyboard"
					></nax-textarea>
				</view>
				<view id="sec-size-md" class="item">
					<nax-textarea
						v-model="sizeMd"
						size="md"
						height="70"
						:adjust-position="textareaAdjustPosition"
						placeholder="md"
						@click="onFieldFocus('sec-size-md')"
						@focus="onFieldFocus('sec-size-md')"
						@blur="onFieldBlur"
						@keyboardheightchange="onTaKeyboard"
					></nax-textarea>
				</view>
				<view id="sec-size-lg" class="item">
					<nax-textarea
						v-model="sizeLg"
						size="lg"
						height="88"
						:adjust-position="textareaAdjustPosition"
						placeholder="lg"
						@click="onFieldFocus('sec-size-lg')"
						@focus="onFieldFocus('sec-size-lg')"
						@blur="onFieldBlur"
						@keyboardheightchange="onTaKeyboard"
					></nax-textarea>
				</view>
			</view>

			<view id="sec-state" class="section">
				<text class="section__title">禁用 / 只读</text>
				<view class="item">
					<nax-textarea v-model="disabledVal" disabled count></nax-textarea>
				</view>
				<view class="item">
					<nax-textarea v-model="readonlyVal" readonly></nax-textarea>
				</view>
			</view>

			<view id="sec-color" class="section">
				<text class="section__title">自定义边框色 + 高度</text>
				<nax-textarea
					v-model="colorBorder"
					border
					border-color="#18a058"
					height="100"
					:adjust-position="textareaAdjustPosition"
					placeholder="height=100，边框 primary"
					@click="onFieldFocus('sec-color')"
					@focus="onFieldFocus('sec-color')"
					@blur="onFieldBlur"
					@keyboardheightchange="onTaKeyboard"
					@confirm="onConfirm"
				></nax-textarea>
				<text class="hint">最近事件：{{ lastEvent }}</text>
			</view>

			<!-- 鸿蒙：垫高保证可滚够；真正避让靠按遮挡量 scroll-top，不顶到页面顶部 -->
			<!-- #ifdef APP-HARMONY -->
			<view class="keyboard-pad" :style="keyboardPadStyle"></view>
			<!-- #endif -->
		</view>
	</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { bindDemoThemePage } from '@/common/demo-theme.uts'

	const darkMode = ref(bindDemoThemePage())

	const themeExtraClass = computed((): string => {
		if (darkMode.value) {
			return 'nax-theme-dark'
		}
		return ''
	})

	onShow(() => {
		darkMode.value = bindDemoThemePage()
		// #ifdef APP-HARMONY
		captureBaseWindowHeight()
		// #endif
	})

	const basic = ref('')
	const withCount = ref('统计字数')
	const autoH = ref('')
	const plain = ref('')
	const plainBg = ref('')
	const bottomBorder = ref('')
	const sizeSm = ref('')
	const sizeMd = ref('')
	const sizeLg = ref('')
	const disabledVal = ref('文本域已被禁用')
	const readonlyVal = ref('只读状态，不可编辑')
	const colorBorder = ref('')
	const lastEvent = ref('无')

	/**
	 * 鸿蒙演示页关闭原生 adjust-position，由页面精确滚动避让；
	 * 其它端保持默认 true。
	 */
	const textareaAdjustPosition = computed((): boolean => {
		// #ifdef APP-HARMONY
		return false
		// #endif
		// #ifndef APP-HARMONY
		return true
		// #endif
	})

	const focusSecId = ref('')
	const scrollTop = ref(0)
	let lastScrollTop: number = 0
	let blurClearTimer: number = 0
	let scrollTick: number = 0
	/** 仅鸿蒙演示页键盘占位 */
	const keyboardPad = ref(0)
	let currentKeyboardHeight: number = 0
	/** 输入框底边与键盘顶边目标间距 */
	const KEYBOARD_GAP = 8
	/**
	 * 键盘未弹起时的窗口高度。避让计算一律用它减键盘高，
	 * 避免窗口缩放后用「已缩小的 windowHeight」再减键盘高导致滚不够/滚过头。
	 */
	let baseWindowHeight: number = 0

	const keyboardPadStyle = computed((): string => {
		const h = keyboardPad.value
		if (h <= 0) {
			return 'height:0px;'
		}
		return 'height:' + h.toString() + 'px;'
	})

	function captureBaseWindowHeight() {
		// #ifdef APP-HARMONY
		const h = uni.getSystemInfoSync().windowHeight
		// 只在更大时更新，防止键盘已弹起时误记成矮窗口
		if (h > baseWindowHeight) {
			baseWindowHeight = h
		}
		// #endif
	}

	function onPageScroll(e: UniScrollEvent) {
		lastScrollTop = e.detail.scrollTop
	}

	/**
	 * 强制写入 scroll-top：相同值不触发时做扰动。
	 */
	function applyScrollTop(next: number) {
		// #ifdef APP-HARMONY
		if (next < 0) {
			next = 0
		}
		// 先写一个不同值再写目标，提高鸿蒙受控 scroll-top 命中率
		const nudge = next + 0.5
		if (scrollTop.value == next) {
			scrollTop.value = nudge
			setTimeout(() => {
				scrollTop.value = next
			}, 16)
		} else {
			scrollTop.value = next
		}
		lastScrollTop = next
		// #endif
	}

	/**
	 * 可视区底边 = 弹起前窗口高 - 键盘高。
	 * 与运行时原生避让公式一致：overflow = bottom - (windowH - keyboardH)。
	 */
	function resolveSafeBottom(keyboardHeight: number): number {
		captureBaseWindowHeight()
		let winH = baseWindowHeight
		if (winH <= 0) {
			winH = uni.getSystemInfoSync().windowHeight
		}
		// 若当前窗口明显比 base 矮，说明已缩放：可视底取当前窗口底（键盘在窗外）
		const curH = uni.getSystemInfoSync().windowHeight
		const shrunk = winH - curH
		if (shrunk > keyboardHeight * 0.4) {
			return curH - KEYBOARD_GAP
		}
		// 覆盖模式：键盘叠在窗口上
		return winH - keyboardHeight - KEYBOARD_GAP
	}

	/**
	 * 只滚被挡掉的距离；若仍被挡会在外部多次重试补滚。
	 */
	function scrollJustAboveKeyboard(keyboardHeight: number): boolean {
		// #ifdef APP-HARMONY
		const id = focusSecId.value
		if (id.length == 0 || keyboardHeight <= 0) {
			return false
		}
		const el = uni.getElementById(id)
		if (el == null) {
			return false
		}
		const rect = el.getBoundingClientRect()
		const bottom = rect.y + rect.height
		const safeBottom = resolveSafeBottom(keyboardHeight)
		const overflow = bottom - safeBottom
		if (overflow > 1) {
			applyScrollTop(lastScrollTop + overflow)
			return true
		}
		return false
		// #endif
		// #ifndef APP-HARMONY
		return false
		// #endif
	}

	/**
	 * 垫高完成后再测位滚动，并多拍几次补齐（键盘动画 / 占位渲染延迟）。
	 */
	function ensureFieldAboveKeyboard(keyboardHeight: number) {
		// #ifdef APP-HARMONY
		const delays = [80, 160, 280]
		let i = 0
		const run = () => {
			if (currentKeyboardHeight <= 0) {
				return
			}
			scrollJustAboveKeyboard(keyboardHeight)
			i++
			if (i < delays.length) {
				scrollTick = setTimeout(run, delays[i] - (i > 0 ? delays[i - 1] : 0)) as number
			}
		}
		if (scrollTick > 0) {
			clearTimeout(scrollTick)
			scrollTick = 0
		}
		scrollTick = setTimeout(run, delays[0]) as number
		// #endif
	}

	function onTaKeyboard(detail: UniInputKeyboardHeightChangeEventDetail) {
		// #ifdef APP-HARMONY
		const h = detail.height
		if (h > 0) {
			if (blurClearTimer > 0) {
				clearTimeout(blurClearTimer)
				blurClearTimer = 0
			}
			// 键盘刚弹起时尽量锁住「弹起前」窗口高
			if (currentKeyboardHeight <= 0) {
				captureBaseWindowHeight()
			}
			currentKeyboardHeight = h
			// 占位 = 键盘高，保证底部项能滚够；不额外加大，避免可见空洞
			keyboardPad.value = h
			ensureFieldAboveKeyboard(h)
		} else {
			currentKeyboardHeight = 0
			keyboardPad.value = 0
			if (scrollTick > 0) {
				clearTimeout(scrollTick)
				scrollTick = 0
			}
			// 收起后刷新 base，供下次使用
			setTimeout(() => {
				baseWindowHeight = 0
				captureBaseWindowHeight()
			}, 50)
		}
		// #endif
	}

	function onFieldFocus(secId: string) {
		lastEvent.value = 'focus: ' + secId
		// #ifdef APP-HARMONY
		if (blurClearTimer > 0) {
			clearTimeout(blurClearTimer)
			blurClearTimer = 0
		}
		focusSecId.value = secId
		if (currentKeyboardHeight <= 0) {
			captureBaseWindowHeight()
		}
		if (currentKeyboardHeight > 0) {
			ensureFieldAboveKeyboard(currentKeyboardHeight)
		}
		// #endif
	}

	function onFieldBlur(val: string) {
		lastEvent.value = 'blur: ' + val
		// #ifdef APP-HARMONY
		if (blurClearTimer > 0) {
			clearTimeout(blurClearTimer)
		}
		blurClearTimer = setTimeout(() => {
			currentKeyboardHeight = 0
			keyboardPad.value = 0
			focusSecId.value = ''
			if (scrollTick > 0) {
				clearTimeout(scrollTick)
				scrollTick = 0
			}
			blurClearTimer = 0
		}, 280) as number
		// #endif
	}

	function onChange(name: string) {
		lastEvent.value = 'change ' + name
	}

	function onConfirm(val: string) {
		lastEvent.value = 'confirm: ' + val
	}
</script>

<style>
	.page-root {
		flex: 1;
		flex-direction: column;
		/* #ifndef APP-ANDROID || APP-IOS || APP-HARMONY */
		height: 100%;
		/* #endif */
	}

	.page-scroll {
		flex: 1;
		height: 0;
	}
	.page {
		padding: 16px;
		background-color: var(--nax-color-bg, #ffffff);
	}

	.page__title {
		font-size: 20px;
		color: var(--nax-color-text, #333639);
		font-weight: 600;
		margin-bottom: 6px;
	}

	.page__desc {
		font-size: 13px;
		color: var(--nax-color-text-secondary, #767c82);
		margin-bottom: 16px;
	}

	.section {
		margin-bottom: 20px;
	}

	.section__title {
		font-size: 14px;
		color: var(--nax-color-text, #333639);
		font-weight: 500;
		margin-bottom: 10px;
	}

	.item {
		margin-bottom: 10px;
	}

	.item--gap {
		margin-top: 10px;
	}

	.panel {
		background-color: var(--nax-color-bg-secondary, #fafafc);
		border-radius: var(--nax-radius-md, 3px);
		padding-left: 4px;
		padding-right: 4px;
	}

	.hint {
		font-size: 12px;
		color: var(--nax-color-text-secondary, #767c82);
		margin-top: 6px;
	}

	/* #ifdef APP-HARMONY */
	.keyboard-pad {
		width: 100%;
		flex-shrink: 0;
	}
	/* #endif */
</style>