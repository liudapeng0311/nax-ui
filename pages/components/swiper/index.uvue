<template>
	<view class="page-root nax-theme" :class="themeExtraClass">
		<nax-nav-bar
			title="nax-swiper"
			home-url="/pages/index/index"
			:border="true"
		></nax-nav-bar>
		<scroll-view class="page-scroll" scroll-y="true">
		<view class="nax-theme page" :class="themeExtraClass">
			<text class="page__desc">轮播 · list 色块演示 / autoplay / indicator / v-model:current</text>

			<view class="section">
				<text class="section__title">基础（点指示器）</text>
				<nax-swiper
					:list="slides"
					height="160"
					@change="onChange"
					@click="onClickItem"
				></nax-swiper>
				<text class="page__hint">current: {{ currentHint }} · {{ tip }}</text>
			</view>

			<view class="section">
				<text class="section__title">自动播放 + 循环</text>
				<nax-swiper
					:list="slides"
					height="160"
					autoplay
					:interval="2500"
					circular
				></nax-swiper>
			</view>

			<view class="section">
				<text class="section__title">数字指示器</text>
				<nax-swiper
					:list="slides"
					height="160"
					indicator
					indicator-type="number"
					indicator-position="bottom-right"
				></nax-swiper>
			</view>

			<view class="section">
				<text class="section__title">受控 current</text>
				<nax-swiper
					:list="slides"
					height="160"
					v-model:current="current"
					:indicator="true"
				></nax-swiper>
				<view class="row">
					<view class="item">
						<nax-button size="sm" label="上一页" @click="prev"></nax-button>
					</view>
					<view class="item">
						<nax-button size="sm" type="primary" label="下一页" @click="next"></nax-button>
					</view>
					<text class="page__hint">v-model: {{ current }}</text>
				</view>
			</view>
		</view>
	</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { bindDemoThemePage } from '@/common/demo-theme.uts'

	// setup 同步读全局，避免首帧浅色白闪
	const darkMode = ref(bindDemoThemePage())

	const themeExtraClass = computed((): string => {
		if (darkMode.value) {
			return 'nax-theme-dark'
		}
		return ''
	})

	onShow(() => {
		darkMode.value = bindDemoThemePage()
	})

	/**
	 * 演示用色块 list，不依赖外链图片（避免 CDN 404）
	 * 业务侧仍可传 string url 或 { src|image|url, text, bg|background }
	 */
	const slides = ref([
		{
			bg: '#18a058',
			text: '色块 1 · primary'
		} as UTSJSONObject,
		{
			bg: '#2080f0',
			text: '色块 2 · info'
		} as UTSJSONObject,
		{
			bg: '#f0a020',
			text: '色块 3 · warning'
		} as UTSJSONObject
	] as UTSJSONObject[])

	const current = ref(0)
	const currentHint = ref(0)
	const tip = ref('点击轮播页查看 index')

	function onChange(cur: number) {
		currentHint.value = cur
	}

	function onClickItem(index: number) {
		tip.value = 'click index: ' + index.toString()
	}

	function prev() {
		if (current.value <= 0) {
			current.value = slides.value.length - 1
			return
		}
		current.value = current.value - 1
	}

	function next() {
		if (current.value >= slides.value.length - 1) {
			current.value = 0
			return
		}
		current.value = current.value + 1
	}
</script>

<style>

	.page-root {
		flex: 1;
		flex-direction: column;
		/* #ifndef APP-ANDROID || APP-IOS || APP-HARMONY */
		height: 100%;
		/* #endif */
	}

	.page-scroll {
		flex: 1;
		height: 0;
	}
	.page {
		padding: 16px;
		background-color: var(--nax-color-bg-secondary, #fafafc);
	}

	.page__title {
		font-size: 20px;
		color: var(--nax-color-text, #333639);
		font-weight: 600;
		margin-bottom: 6px;
	}

	.page__desc {
		font-size: 13px;
		color: var(--nax-color-text-secondary, #767c82);
		margin-bottom: 12px;
	}

	.page__hint {
		font-size: 13px;
		color: var(--nax-color-text-secondary, #767c82);
		margin-top: 8px;
	}

	.section {
		margin-bottom: 16px;
		padding: 14px;
		background-color: var(--nax-color-bg, #ffffff);
		border-radius: var(--nax-radius-md, 3px);
		border-width: 1px;
		border-style: solid;
		border-color: var(--nax-color-border, #f0f0f3);
	}

	.section__title {
		font-size: 14px;
		font-weight: 500;
		color: var(--nax-color-text, #333639);
		margin-bottom: 12px;
	}

	.row {
		flex-direction: row;
		flex-wrap: wrap;
		align-items: center;
		margin-top: 10px;
	}

	.item {
		margin-right: 10px;
	}
</style>
