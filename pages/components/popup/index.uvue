<template>
	<view class="page-root nax-theme" :class="themeExtraClass">
		<nax-nav-bar
			:back-icon-color="navBackIconColor"
			title="nax-popup"
			home-url="/pages/index/index"
			:border="true"
		></nax-nav-bar>
		<scroll-view class="page-scroll">
			<view class="nax-theme page" :class="themeExtraClass">
				<text class="page__desc">压窗屏：App/Web 用 dialogPage 盖住原生导航栏与 tabBar；小程序降级页面级并说明限制。</text>

				<view class="section">
					<text class="section__title">当前端能力</text>
					<text class="hint">{{ capabilityText }}</text>
				</view>

				<view class="section">
					<text class="section__title">压窗 · 内置 host（title/content）</text>
					<view class="row">
						<nax-button type="primary" label="居中压窗" @click="openWindowCenter"></nax-button>
					</view>
					<view class="row row--gap">
						<nax-button size="sm" label="底部" @click="openWindowBottom"></nax-button>
						<view class="gap"></view>
						<nax-button size="sm" label="mode=window" @click="openForceWindow"></nax-button>
					</view>
					<text class="hint">App/Web：应盖住本页导航栏。小程序：降级到页面宿主（本页底部已挂）。</text>
				</view>

				<view class="section">
					<text class="section__title">压窗 · 自定义 dialog 页</text>
					<view class="row">
						<nax-button type="info" label="打开 demo-dialog 页" @click="openCustomDialog"></nax-button>
					</view>
					<text class="hint">复杂 UI 推荐自建透明页 + openNaxPopup({ url })；animationType 建议 none，进退场动画写在 dialog 页内（本 demo 已示例）。</text>
				</view>

				<view class="section">
					<text class="section__title">页面级 · 不压窗（全端一致）</text>
					<view class="row">
						<nax-button label="mode=page API" @click="openPageMode"></nax-button>
						<view class="gap"></view>
						<nax-button label="声明式插槽" @click="openDeclarative"></nax-button>
					</view>
					<text class="hint">与 nax-picker 相同层级：盖不住原生导航栏/tabBar。</text>
				</view>

				<view class="section">
					<text class="section__title">面板内滚动</text>
					<view class="row">
						<nax-button type="success" label="底部定高 + 滚动列表" @click="openScrollList"></nax-button>
					</view>
					<text class="hint">先给面板确定高度（height prop 建议固定像素或 px 单位；左右抽屉天然全高），插槽内 scroll-view 配 flex:1 即可占满剩余空间并滚动；面板内容自适应（不设高度）时，需要给 scroll-view / 外层写固定高度。</text>
				</view>

				<view class="section">
					<text class="section__title">头部区域与关闭按钮</text>
					<view class="row">
						<nax-button size="sm" label="默认头部+✕" @click="hdDefault = true"></nax-button>
						<view class="gap"></view>
						<nax-button size="sm" label="无关闭按钮" @click="hdNoClose = true"></nax-button>
						<view class="gap"></view>
						<nax-button size="sm" label="无头部" @click="hdNoHeader = true"></nax-button>
					</view>
					<text class="hint">showHeader / showClose 默认 true：标题左对齐 + 右上角「✕」关闭；showClose=false 时底部保留「关闭」按钮兜底。</text>
				</view>

				<view class="section">
					<text class="section__title">关闭</text>
					<view class="row">
						<nax-button size="sm" label="closeNaxPopup()" @click="onCloseApi"></nax-button>
					</view>
				</view>

				<view class="section">
					<text class="section__title">平台说明摘要</text>
					<text class="hint">• App/Web：真压窗 ✅（dialogPage）</text>
					<text class="hint">• 微信小程序：真压窗 ❌，需自定义导航/tabBar 或接受页面级遮罩</text>
					<text class="hint">• 详见 uni_modules/nax-popup/readme.md 与 docs/popup-window.md</text>
				</view>
			</view>
		</scroll-view>

		<!-- 声明式 -->
		<nax-popup v-model:show="declShow" position="bottom">
			<view class="demo-panel">
				<text class="demo-panel__title">声明式 nax-popup</text>
				<text class="demo-panel__desc">页面级插槽，不盖原生导航栏。</text>
				<nax-button size="sm" type="primary" label="关闭" @click="declShow = false"></nax-button>
			</view>
		</nax-popup>

		<!-- 面板内容滚动：定高面板 + 插槽 scroll-view flex:1 -->
		<nax-popup
			v-model:show="scrollShow"
			position="bottom"
			height="520"
			title="可滚动内容区"
		>
			<scroll-view class="demo-scroll-panel" direction="vertical">
				<view v-for="i in 30" :key="'sr-' + i.toString()" class="demo-scroll-panel__row">
					<text class="demo-scroll-panel__text">滚动行 {{ i }}：列表内容超出可视高度后由 scroll-view 统一滚动，本行文案较长时允许自动换行完整显示</text>
				</view>
			</scroll-view>
		</nax-popup>

		<!-- 头部与关闭按钮：默认头部 + ✕ -->
		<nax-popup
			v-model:show="hdDefault"
			position="center"
			title="默认头部"
			content="showHeader / showClose 默认 true：标题左对齐 + 右上角「✕」。"
		></nax-popup>

		<!-- 头部无关闭：右上角无 ✕，底部保留「关闭」按钮 -->
		<nax-popup
			v-model:show="hdNoClose"
			position="bottom"
			title="头部无关闭"
			content="showClose=false：隐藏右上角 ✕，底部「关闭」按钮兜底。"
			:show-close="false"
		></nax-popup>

		<!-- 无头部：仅内容 + 底部「关闭」按钮 -->
		<nax-popup
			v-model:show="hdNoHeader"
			position="bottom"
			content="showHeader=false：无头部区域，仅内容与底部「关闭」按钮。"
			:show-header="false"
			:show-close="false"
		></nax-popup>

		<!-- 命令式页面级 / 小程序降级宿主（可空） -->
		<nax-popup />
	</view>
</template>

<script setup lang="uts">
	import { bindDemoThemePage, demoDarkRef, setDemoDarkMode, demoNavBackIconColor } from '@/common/demo-theme.uts'
	import {
		openNaxPopup,
		closeNaxPopup,
		naxPopupSupportsWindowCover
	} from '@/uni_modules/nax-popup/index.uts'

	bindDemoThemePage()
	const darkMode = demoDarkRef

	const navBackIconColor = computed((): string => {
		// Android 模板编译不直接调用导入的 UTS 函数，避免生成未解析的 invoke。
		// #ifdef APP-ANDROID
		return ''
		// #endif
		// #ifndef APP-ANDROID
		return demoNavBackIconColor(darkMode.value)
		// #endif
	})
	const declShow = ref(false)
	const scrollShow = ref(false)
	const hdDefault = ref(false)
	const hdNoClose = ref(false)
	const hdNoHeader = ref(false)

	const themeExtraClass = computed((): string => {
		if (darkMode.value) {
			return 'nax-theme-dark'
		}
		return ''
	})

	const capabilityText = computed((): string => {
		if (naxPopupSupportsWindowCover()) {
			return '支持真·压窗（dialogPage）：可盖住原生导航栏与 tabBar'
		}
		return '不支持 dialogPage：已降级页面级弹层，无法盖住原生导航栏/tabBar'
	})

	onShow(() => {
		darkMode.value = bindDemoThemePage()
	})

	function openWindowCenter() {
		openNaxPopup({
			themeClass: themeExtraClass.value,
			title: '压窗屏',
			content: 'App/Web 下遮罩应盖住导航栏。点遮罩或关闭按钮退出。',
			position: 'center',
			maskClosable: true
		})
	}

	function openWindowBottom() {
		openNaxPopup({
			themeClass: themeExtraClass.value,
			title: '底部压窗',
			content: 'position=bottom 的内置 host 面板。',
			position: 'bottom',
			maskClosable: true
		})
	}

	function openForceWindow() {
		openNaxPopup({
			themeClass: themeExtraClass.value,
			mode: 'window',
			title: '强制 window',
			content: 'mode=window：不支持的端会 warn 并尝试页面宿主降级。',
			position: 'center'
		})
	}

	function openCustomDialog() {
		openNaxPopup({
			url: '/pages/components/popup/demo-dialog',
			animationType: 'none'
		})
	}

	function openPageMode() {
		openNaxPopup({
			mode: 'page',
			title: '页面级 API',
			content: 'mode=page：全端走页面宿主，不盖原生栏。',
			position: 'center'
		})
	}

	function openDeclarative() {
		declShow.value = true
	}

	function openScrollList() {
		scrollShow.value = true
	}

	function onCloseApi() {
		closeNaxPopup()
	}
</script>

<style>
	.page-root {
		flex: 1;
		flex-direction: column;
		/* #ifndef APP-ANDROID || APP-IOS || APP-HARMONY */
		height: 100%;
		/* #endif */
	}

	.page-scroll {
		flex: 1;
		height: 0;
	}

	.page {
		padding: 20px;
		padding-bottom: 40px;
		flex-direction: column;
		background-color: var(--nax-color-bg-secondary, #fafafc);
	}

	.page__title {
		font-size: 20px;
		font-weight: 600;
		color: var(--nax-color-text, #333639);
		margin-bottom: 6px;
	}

	.page__desc {
		font-size: 13px;
		color: var(--nax-color-text-secondary, #767c82);
		margin-bottom: 16px;
	}

	.section {
		flex-direction: column;
		margin-bottom: 16px;
		padding: 12px;
		background-color: var(--nax-color-bg, #ffffff);
		border-radius: var(--nax-radius-md, 3px);
		border-width: 1px;
		border-style: solid;
		border-color: var(--nax-color-border, #f0f0f3);
	}

	.section__title {
		font-size: 14px;
		font-weight: 500;
		color: var(--nax-color-text, #333639);
		margin-bottom: 10px;
	}

	.row {
		flex-direction: row;
		flex-wrap: wrap;
		align-items: center;
	}

	.row--gap {
		margin-top: 8px;
	}

	.gap {
		width: 8px;
		height: 1px;
	}

	.hint {
		margin-top: 8px;
		font-size: 12px;
		color: var(--nax-color-text-secondary, #767c82);
		line-height: 18px;
	}

	.demo-panel {
		flex-direction: column;
		padding: 20px;
		align-items: center;
	}

	.demo-scroll-panel {
		flex: 1;
		/* 不设横向 padding：滚动条才能贴住面板右缘；行内容留白放行内 */
		background-color: var(--nax-color-bg-secondary, #fafafc);
	}

	.demo-scroll-panel__row {
		flex-direction: row;
		align-items: center;
		min-height: 44px;
		padding-top: 10px;
		padding-bottom: 10px;
		padding-left: 20px;
		padding-right: 20px;
		border-bottom-width: 1px;
		border-bottom-style: solid;
		border-bottom-color: var(--nax-color-border, #f0f0f3);
	}

	.demo-scroll-panel__text {
		flex: 1;
		font-size: 13px;
		line-height: 20px;
		color: var(--nax-color-text, #333639);
	}

	.demo-panel__title {
		font-size: 16px;
		font-weight: 600;
		color: var(--nax-color-text, #333639);
		margin-bottom: 8px;
	}

	.demo-panel__desc {
		font-size: 13px;
		color: var(--nax-color-text-secondary, #767c82);
		margin-bottom: 16px;
		text-align: center;
	}
</style>
