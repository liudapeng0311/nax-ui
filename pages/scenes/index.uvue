<template>
	<view class="page-root nax-theme" :class="themeExtraClass" :style="pageRootStyle">
		<nax-nav-bar
			title="场景"
			:show-back="false"
			:border="false"
			:type="navType"
			home-url="/pages/index/index"
			:fixed="chromeFixed"
			:placeholder="chromeFixed"
		></nax-nav-bar>

		<view class="page-body" :style="pageBodyStyle">
			<scroll-view class="page-scroll" scroll-y="true" :style="pageScrollStyle">
				<view class="nax-theme page" :class="themeExtraClass">
					<text class="intro">用现有组件拼装接近真实业务的页面片段，便于上架演示与二次开发参考。</text>

					<view
						v-for="(scene, index) in sceneList"
						:key="index"
						class="card"
						@click="onOpen(scene)"
					>
						<view class="card__cover" :class="'card__cover--' + (index % 3).toString()">
							<nax-icon :name="itemIcon(scene)" size="28" color="#ffffff"></nax-icon>
						</view>
						<view class="card__body">
							<view class="card__row">
								<text class="card__title">{{ itemTitle(scene) }}</text>
								<nax-tag type="primary" variant="light" size="sm" :label="itemTag(scene)"></nax-tag>
							</view>
							<text class="card__desc">{{ itemDesc(scene) }}</text>
							<view class="card__footer">
								<text class="card__link">查看示例</text>
								<nax-icon name="chevron-right" size="16" color="#18a058"></nax-icon>
							</view>
						</view>
					</view>

					<view class="tips">
						<nax-alert type="info" title="提示" description="场景页只做组合演示，不接真实接口；提交类操作用 Toast / Dialog 反馈。"></nax-alert>
					</view>
				</view>
			</scroll-view>
		</view>

		<nax-tabbar
			:model-value="2"
			:list="tabList"
			:fixed="chromeFixed"
			:placeholder="chromeFixed"
			@change="onTabChange"
		></nax-tabbar>
	</view>
</template>

<script setup lang="uts">
	import { bindDemoThemePage, demoDarkRef } from '@/common/demo-theme.uts'
	import {
		demoTabList,
		switchDemoTab,
		openDemoPage,
		demoSceneList,
		demoReadString,
		hideDemoNativeTabBar
	} from '@/common/demo-catalog.uts'

	bindDemoThemePage()
	const darkMode = demoDarkRef

	const themeExtraClass = computed((): string => {
		if (darkMode.value) {
			return 'nax-theme-dark'
		}
		return ''
	})

	const navType = computed((): string => {
		if (darkMode.value) {
			return 'default'
		}
		return 'primary'
	})

	const chromeFixed = ref(true)
	const pageRootStyle = ref('')
	const pageBodyStyle = ref('')
	const pageScrollStyle = ref('')
	function refreshPageRootStyle() {
		// #ifdef MP-WEIXIN
		// 微信小程序 fixed 自定义组件可能被宿主裁剪，顶底栏改用文档流
		chromeFixed.value = false
		const winMp = uni.getWindowInfo()
		var pageHMp = winMp.screenHeight
		if (pageHMp <= 0) {
			pageHMp = winMp.windowHeight
		}
		if (pageHMp <= 0) {
			pageHMp = 700
		}
		var statusHMp = winMp.statusBarHeight
		if (statusHMp < 0) {
			statusHMp = 0
		}
		var safeBottomHMp = 0
		if (winMp.safeAreaInsets != null && winMp.safeAreaInsets.bottom > 0) {
			safeBottomHMp = winMp.safeAreaInsets.bottom
		} else if (winMp.safeArea != null) {
			const gapMp = pageHMp - winMp.safeArea.bottom
			if (gapMp > 0) {
				safeBottomHMp = gapMp
			}
		}
		const navHMp = statusHMp + 44
		const tabHMp = 50 + safeBottomHMp
		var bodyHMp = pageHMp - navHMp - tabHMp
		if (bodyHMp < 200) {
			bodyHMp = 200
		}
		pageRootStyle.value = 'width:100%;height:' + pageHMp.toString() + 'px;flex-direction:column;'
		pageBodyStyle.value = 'width:100%;height:' + bodyHMp.toString() + 'px;flex-direction:column;'
		pageScrollStyle.value = 'width:100%;height:' + bodyHMp.toString() + 'px;'
		// #endif

		// #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
		// App：顶底栏 fixed 贴边；中间区 absolute 卡在顶底之间并写死 px 高
		chromeFixed.value = true
		const info = uni.getSystemInfoSync()
		var pageH = info.windowHeight
		if (pageH <= 0) {
			pageH = info.screenHeight
		}
		var status = 0
		if (info.statusBarHeight > 0) {
			status = info.statusBarHeight
		}
		var safeBottom = 0
		const win = uni.getWindowInfo()
		if (win.safeAreaInsets != null && win.safeAreaInsets.bottom > 0) {
			safeBottom = win.safeAreaInsets.bottom
		} else if (win.safeArea != null) {
			const gap = win.screenHeight - win.safeArea.bottom
			if (gap > 0) {
				safeBottom = gap
			}
		}
		if (pageH <= 0 && win.windowHeight > 0) {
			pageH = win.windowHeight
		}
		if (status <= 0 && win.statusBarHeight > 0) {
			status = win.statusBarHeight
		}
		if (pageH <= 0) {
			pageH = 700
		}
		const navH = status + 44
		const tabH = 50 + safeBottom
		var bodyH = pageH - navH - tabH
		if (bodyH < 200) {
			bodyH = 200
		}
		pageRootStyle.value = 'position:absolute;left:0;top:0;right:0;bottom:0;width:100%;height:' + pageH.toString() + 'px;'
		pageBodyStyle.value = 'position:absolute;left:0;right:0;top:' + navH.toString() + 'px;bottom:' + tabH.toString() + 'px;width:100%;height:' + bodyH.toString() + 'px;'
		pageScrollStyle.value = 'width:100%;height:' + bodyH.toString() + 'px;'
		// #endif
		// #ifndef APP-ANDROID || APP-IOS || APP-HARMONY || MP-WEIXIN
		chromeFixed.value = true
		pageRootStyle.value = 'flex:1;width:100%;height:100%;flex-direction:column;'
		pageBodyStyle.value = 'flex:1;height:0;width:100%;flex-direction:column;'
		pageScrollStyle.value = 'flex:1;width:100%;height:100%;'
		// #endif
	}
	refreshPageRootStyle()

	const tabList = demoTabList()
	const sceneList = demoSceneList()

	function itemTitle(item : any) : string {
		return demoReadString(item, 'name')
	}

	function itemTag(item : any) : string {
		return demoReadString(item, 'tag')
	}

	function itemIcon(item : any) : string {
		return demoReadString(item, 'icon')
	}

	function itemDesc(item : any) : string {
		return demoReadString(item, 'desc')
	}

	function onOpen(item : any) {
		openDemoPage(demoReadString(item, 'path'))
	}

	function onTabChange(index : number) {
		if (index == 2) {
			return
		}
		switchDemoTab(index)
	}

	onShow(() => {
		hideDemoNativeTabBar()
		refreshPageRootStyle()
		darkMode.value = bindDemoThemePage()
	})
</script>

<style>
	.page-root {
		flex-direction: column;
		width: 100%;
		background-color: var(--nax-color-bg-secondary, #fafafc);
	}

	.page-body {
		flex-direction: column;
		width: 100%;
	}

	.page-scroll {
		width: 100%;
		flex-direction: column;
	}

	.page {
		flex-direction: column;
		padding: 16px;
		padding-bottom: 28px;
		background-color: var(--nax-color-bg-secondary, #fafafc);
	}

	.intro {
		font-size: 13px;
		line-height: 20px;
		color: var(--nax-color-text-secondary, #767c82);
		margin-bottom: 14px;
	}

	.card {
		flex-direction: column;
		margin-bottom: 14px;
		border-radius: 14px;
		overflow: hidden;
		background-color: var(--nax-color-bg, #ffffff);
		border-width: 1px;
		border-style: solid;
		border-color: var(--nax-color-border, #f0f0f3);
	}

	.card__cover {
		height: 96px;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		background-color: var(--nax-color-primary, #18a058);
	}

	.card__cover--0 {
		background-color: var(--nax-color-primary, #18a058);
	}

	.card__cover--1 {
		background-color: var(--nax-color-info, #2080f0);
	}

	.card__cover--2 {
		background-color: var(--nax-color-warning, #f0a020);
	}

	.card__body {
		flex-direction: column;
		padding: 14px 14px 12px 14px;
	}

	.card__row {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 6px;
	}

	.card__title {
		font-size: 16px;
		font-weight: 600;
		color: var(--nax-color-text, #333639);
	}

	.card__desc {
		font-size: 13px;
		line-height: 20px;
		color: var(--nax-color-text-secondary, #767c82);
		margin-bottom: 10px;
	}

	.card__footer {
		flex-direction: row;
		align-items: center;
	}

	.card__link {
		font-size: 13px;
		color: var(--nax-color-primary, #18a058);
		font-weight: 500;
		margin-right: 2px;
	}

	.tips {
		margin-top: 4px;
	}
</style>
