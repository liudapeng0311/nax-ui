<template>
	<view class="nax-checkbox-group" :class="rootClass">
		<slot></slot>
	</view>
</template>

<script setup lang="uts">
	/**
	 * nax-checkbox-group
	 * @description 复选框组。管理多个 nax-checkbox 的选中值数组。
	 * @property {Array} modelValue 选中项 name/value 数组（v-model）
	 * @property {boolean} disabled 整组禁用
	 * @property {string} shape square | circle
	 * @property {string} size sm | md | lg
	 * @property {string} activeColor 选中色；空则主题 primary
	 * @property {string} iconSize 勾选图标字号（数字字符串 px）
	 * @property {string} labelSize 文案字号（数字字符串 px）
	 * @property {boolean} labelDisabled 为 true 时点击文案不切换
	 * @property {number} max 最多可选数量；0 不限制
	 * @property {boolean} wrap 是否每个选项独占一行
	 * @property {string} width 子项宽度（如 50% / 120px）
	 * @property {string} customClass 根节点扩展 class
	 * @event update:modelValue v-model
	 * @event change 选中数组变化
	 * @slot default 放置 nax-checkbox
	 */
	const props = defineProps({
		modelValue: {
			type: Array,
			default: () => [] as string[]
		},
		disabled: {
			type: Boolean,
			default: false
		},
		shape: {
			type: String,
			default: 'square'
		},
		size: {
			type: String,
			default: 'md'
		},
		activeColor: {
			type: String,
			default: ''
		},
		iconSize: {
			type: String,
			default: ''
		},
		labelSize: {
			type: String,
			default: ''
		},
		labelDisabled: {
			type: Boolean,
			default: false
		},
		max: {
			type: Number,
			default: 0
		},
		wrap: {
			type: Boolean,
			default: false
		},
		width: {
			type: String,
			default: ''
		},
		customClass: {
			type: String,
			default: ''
		}
	})

	const emit = defineEmits(['update:modelValue', 'change'])

	// 位于 nax-form-item 内时由表单项注入：值变化 / 失焦时回调，驱动规则 trigger 校验
	function fallbackItemValidate(_event: string, _value: any | null) {
	}
	const formItemValidateRaw = inject('naxFormItemValidate', fallbackItemValidate) as (event: string, value: any | null) => void

	function notifyFormItem(event: string, value: any | null) {
		formItemValidateRaw(event, value)
	}

	const selected = ref([] as string[])
	// Android inject 会按默认值推断具体运行时类型，需与子组件的 RefImpl 默认值保持一致。
	// #ifdef APP-ANDROID
	const disabledState = ref(props.disabled)
	const shapeState = ref(props.shape)
	const sizeState = ref(props.size)
	const activeColorState = ref(props.activeColor)
	const iconSizeState = ref(props.iconSize)
	const labelSizeState = ref(props.labelSize)
	const labelDisabledState = ref(props.labelDisabled)
	const maxState = ref(props.max)
	const widthState = ref(props.width)
	const wrapState = ref(props.wrap)
	// #endif

	function copyStringArray(raw : any | null) : string[] {
		const next = [] as string[]
		if (raw == null) {
			return next
		}
		const list = raw as string[]
		var i = 0
		while (i < list.length) {
			next.push('' + list[i])
			i++
		}
		return next
	}

	function syncFromProps() {
		selected.value = copyStringArray(props.modelValue)
	}

	syncFromProps()

	watch((): any => {
		return props.modelValue
	}, (_ : any) => {
		syncFromProps()
	})
	// #ifdef APP-ANDROID
	watch((): boolean => props.disabled, (value : boolean) => { disabledState.value = value })
	watch((): string => props.shape, (value : string) => { shapeState.value = value })
	watch((): string => props.size, (value : string) => { sizeState.value = value })
	watch((): string => props.activeColor, (value : string) => { activeColorState.value = value })
	watch((): string => props.iconSize, (value : string) => { iconSizeState.value = value })
	watch((): string => props.labelSize, (value : string) => { labelSizeState.value = value })
	watch((): boolean => props.labelDisabled, (value : boolean) => { labelDisabledState.value = value })
	watch((): number => props.max, (value : number) => { maxState.value = value })
	watch((): string => props.width, (value : string) => { widthState.value = value })
	watch((): boolean => props.wrap, (value : boolean) => { wrapState.value = value })
	// #endif

	/**
	 * 切换选项
	 * @return -1 未变更；0 取消选中；1 选中
	 */
	function toggleItem(name : string) : number {
		if (props.disabled) {
			return -1
		}
		if (name.length == 0) {
			return -1
		}
		const prev = selected.value
		const next = [] as string[]
		var found = false
		var i = 0
		while (i < prev.length) {
			const item = prev[i]
			if (item == name) {
				found = true
			} else {
				next.push(item)
			}
			i++
		}
		if (found) {
			selected.value = next
			emit('update:modelValue', next)
			emit('change', next)
			notifyFormItem('change', next)
			return 0
		}
		if (props.max > 0 && next.length >= props.max) {
			return -1
		}
		next.push(name)
		selected.value = next
		emit('update:modelValue', next)
		emit('change', next)
		notifyFormItem('change', next)
		return 1
	}

	// 向子 checkbox 注入上下文（字符串 key，避免跨端符号问题）
	provide('naxCbInGroup', true)
	provide('naxCbSelected', selected)
	provide('naxCbToggle', toggleItem)
	// #ifdef APP-ANDROID
	provide('naxCbDisabled', disabledState)
	provide('naxCbShape', shapeState)
	provide('naxCbSize', sizeState)
	provide('naxCbActiveColor', activeColorState)
	provide('naxCbIconSize', iconSizeState)
	provide('naxCbLabelSize', labelSizeState)
	provide('naxCbLabelDisabled', labelDisabledState)
	provide('naxCbMax', maxState)
	provide('naxCbWidth', widthState)
	provide('naxCbWrap', wrapState)
	// #endif
	// #ifndef APP-ANDROID
	provide('naxCbDisabled', computed((): boolean => {
		return props.disabled
	}))
	provide('naxCbShape', computed((): string => {
		return props.shape
	}))
	provide('naxCbSize', computed((): string => {
		return props.size
	}))
	provide('naxCbActiveColor', computed((): string => {
		return props.activeColor
	}))
	provide('naxCbIconSize', computed((): string => {
		return props.iconSize
	}))
	provide('naxCbLabelSize', computed((): string => {
		return props.labelSize
	}))
	provide('naxCbLabelDisabled', computed((): boolean => {
		return props.labelDisabled
	}))
	provide('naxCbMax', computed((): number => {
		return props.max
	}))
	provide('naxCbWidth', computed((): string => {
		return props.width
	}))
	provide('naxCbWrap', computed((): boolean => {
		return props.wrap
	}))
	// #endif

	const rootClass = computed((): string => {
		var cls = ''
		if (props.wrap) {
			cls += ' nax-checkbox-group--wrap'
		} else {
			cls += ' nax-checkbox-group--row'
		}
		if (props.customClass.length > 0) {
			cls += ' ' + props.customClass
		}
		return cls.trim()
	})
</script>

<style>
	.nax-checkbox-group--row {
		flex-direction: row;
		flex-wrap: wrap;
		align-items: center;
	}

	.nax-checkbox-group--wrap {
		flex-direction: column;
		align-items: flex-start;
	}
</style>
