	/* 省略文本：在 flex 行内强制可收缩，内容超宽才触发 lines/ellipsis */
	.nax-text__value--ellipsis {
		flex: 1;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	/* 鸿蒙：CSS lines 与属性 :lines 双写；单行/多行共用 overflow */
