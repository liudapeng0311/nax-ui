	/* iOS 自研滚轮样式（框架渲染，可正常控制文字居中） */
	/* #ifdef APP-IOS */
	.nax-select__wheel {
		flex: 1;
		height: 240px;
		flex-direction: row;
		/* 滚轮区域显式底色，避免联动重建列数据后透出页面（iOS 用字面量，var 不可靠） */
		background-color: #ffffff;
	}

	/* iOS 主题 class：按暗黑/浅色用字面量覆盖弹窗内颜色（不依赖 CSS 变量） */
	/* #ifndef VUE3-VAPOR */
	.nax-select--ios-light .nax-select__wheel {
		background-color: #ffffff;
	}

	.nax-select--ios-dark .nax-select__wheel {
		background-color: #101014;
	}

	.nax-select--ios-light .nax-select__title {
