	}

	.nax-select__wheel-item {
		height: 40px;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		padding-left: var(--nax-space-2, 8px);
		padding-right: var(--nax-space-2, 8px);
	}

	.nax-select__wheel-item--selected {}

	.nax-select__wheel-text {
		font-size: var(--nax-font-size-md, 16px);
		color: var(--nax-color-text-secondary, #767c82);
		text-align: center;
		/* iOS 单行 text 基线不随父级居中，显式对齐行高 */
		height: 40px;
		line-height: 40px;
	}

	.nax-select__wheel-text--selected {
		color: var(--nax-color-text-black, #000000);
	}
	/* #endif */

	/* 鸿蒙：选项不可点选（仅视觉/点击吞掉；勿 pointer-events:none，以免影响滑动） */
	/* #ifdef APP-HARMONY */
	.nax-select__item--no-tap {
		/* 保持可滑动区域 */
	}

	.nax-select__picker--harmony {
		/* 占位：与其它端同滚轮，仅行为上禁点选 */
	}
	/* #endif */
