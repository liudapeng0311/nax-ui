<template>
	<view
		class="nax-button"
		:class="rootClass"
		:hover-class="hoverClassName"
		:hover-start-time="20"
		:hover-stay-time="70"
		@click="onClick"
	>
		<text v-if="loading" class="nax-button__loading" :class="textClass">...</text>
		<slot name="icon"></slot>
		<text v-if="label.length > 0" class="nax-button__text" :class="textClass" :lines="1">{{ label }}</text>
		<slot></slot>
	</view>
</template>

<script setup lang="uts">
	/**
	 * nax-button
	 * @description 通用按钮。props 管行为，class / CSS 变量管外观。
	 * @property {string} type default | tertiary | primary | info | success | warning | error
	 * @property {string} variant solid | outline | text | light
	 * @property {string} size sm | md | lg
	 * @property {string} shape square | round | circle
	 * @property {boolean} disabled 禁用
	 * @property {boolean} loading 加载中（阻止点击）
	 * @property {boolean} block 块级宽度
	 * @property {string} label 文案；也可用默认插槽扩展
	 * @property {string} customClass 根节点扩展 class
	 * @event click 点击（disabled / loading 时不触发）
	 * @slot default 自定义内容
	 * @slot icon 前缀图标区域
	 */
	const props = defineProps({
		type: {
			type: String,
			default: 'default'
		},
		variant: {
			type: String,
			default: 'solid'
		},
		size: {
			type: String,
			default: 'md'
		},
		shape: {
			type: String,
			default: 'square'
		},
		disabled: {
			type: Boolean,
			default: false
		},
		loading: {
			type: Boolean,
			default: false
		},
		block: {
			type: Boolean,
			default: false
		},
		label: {
			type: String,
			default: ''
		},
		customClass: {
			type: String,
			default: ''
		}
	})

	const emit = defineEmits(['click'])

	const tone = computed((): string => {
		const typeName = normalizeType(props.type)
		const variantName = normalizeVariant(props.variant)
		return typeName + '-' + variantName
	})

	const rootClass = computed((): string => {
		const sizeName = normalizeSize(props.size)
		const shapeName = normalizeShape(props.shape)
		let cls = 'nax-button--' + tone.value
		cls += ' nax-button--' + sizeName
		cls += ' nax-button--shape-' + shapeName
		if (shapeName == 'circle') {
			cls += ' nax-button--circle-' + sizeName
		}
		if (props.block) {
			cls += ' nax-button--block'
		}
		if (props.disabled) {
			cls += ' nax-button--disabled'
		}
		if (props.loading) {
			cls += ' nax-button--loading'
		}
		if (props.customClass.length > 0) {
			cls += ' ' + props.customClass
		}
		return cls
	})

	const textClass = computed((): string => {
		const sizeName = normalizeSize(props.size)
		let cls = 'nax-button__text--' + tone.value
		cls += ' nax-button__text--' + sizeName
		if (props.disabled) {
			cls += ' nax-button__text--disabled'
		}
		return cls
	})

	const hoverClassName = computed((): string => {
		if (props.disabled || props.loading) {
			return 'none'
		}
		return 'nax-button--hover'
	})

	function normalizeType(value : string) : string {
		// danger 兼容为 error
		if (value == 'danger') {
			return 'error'
		}
		if (
			value == 'tertiary' ||
			value == 'primary' ||
			value == 'info' ||
			value == 'success' ||
			value == 'warning' ||
			value == 'error'
		) {
			return value
		}
		return 'default'
	}

	function normalizeVariant(value : string) : string {
		if (value == 'outline' || value == 'text' || value == 'light') {
			return value
		}
		return 'solid'
	}

	function normalizeSize(value : string) : string {
		if (value == 'sm' || value == 'lg') {
			return value
		}
		return 'md'
	}

	function normalizeShape(value : string) : string {
		if (value == 'round' || value == 'circle') {
			return value
		}
		return 'square'
	}

	function onClick() {
		if (props.disabled || props.loading) {
			return
		}
		emit('click')
	}
</script>

<style>
	.nax-button {
		flex-direction: row;
		align-items: center;
		justify-content: center;
		height: var(--nax-button-height, 36px);
		padding-left: var(--nax-button-padding-x, 16px);
		padding-right: var(--nax-button-padding-x, 16px);
		border-radius: var(--nax-button-radius, 3px);
		border-width: var(--nax-border-width, 1px);
		border-style: solid;
		border-color: transparent;
		background-color: var(--nax-color-bg, #ffffff);
		opacity: 1;
	}

	.nax-button--sm {
		height: 28px;
		padding-left: 12px;
		padding-right: 12px;
	}

	.nax-button--md {
		height: 36px;
		padding-left: 16px;
		padding-right: 16px;
	}

	.nax-button--lg {
		height: 44px;
		padding-left: 20px;
		padding-right: 20px;
	}

	.nax-button--shape-square {
		border-radius: var(--nax-button-radius, 3px);
	}

	.nax-button--shape-round {
		border-radius: var(--nax-radius-full, 999px);
	}

	.nax-button--shape-circle {
		border-radius: var(--nax-radius-full, 999px);
		padding-left: 0;
		padding-right: 0;
	}

	.nax-button--circle-sm {
		width: 28px;
		height: 28px;
	}

	.nax-button--circle-md {
		width: 36px;
		height: 36px;
	}

	.nax-button--circle-lg {
		width: 44px;
		height: 44px;
	}

	.nax-button--block {
		align-self: stretch;
		width: 100%;
	}

	.nax-button--disabled,
	.nax-button--loading {
		opacity: var(--nax-opacity-disabled, 0.45);
	}

	.nax-button--hover {
		opacity: 0.85;
	}

	/* ===== default ===== */
	.nax-button--default-solid,
	.nax-button--default-outline {
		background-color: var(--nax-color-bg, #ffffff);
		border-color: var(--nax-color-border, #e5e6eb);
	}

	.nax-button--default-text {
		background-color: transparent;
		border-color: transparent;
	}

	.nax-button--default-light {
		background-color: var(--nax-color-bg-secondary, #f5f6f8);
		border-color: transparent;
	}

	/* ===== tertiary ===== */
	.nax-button--tertiary-solid,
	.nax-button--tertiary-outline {
		background-color: var(--nax-color-bg, #ffffff);
		border-color: var(--nax-color-border-tertiary, #eff0f2);
	}

	.nax-button--tertiary-text {
		background-color: transparent;
		border-color: transparent;
	}

	.nax-button--tertiary-light {
		background-color: var(--nax-color-bg-secondary, #f5f6f8);
		border-color: transparent;
	}

	/* ===== primary ===== */
	.nax-button--primary-solid {
		background-color: var(--nax-color-primary, #1677ff);
		border-color: var(--nax-color-primary, #1677ff);
	}

	.nax-button--primary-outline {
		background-color: transparent;
		border-color: var(--nax-color-primary, #1677ff);
	}

	.nax-button--primary-text {
		background-color: transparent;
		border-color: transparent;
	}

	.nax-button--primary-light {
		background-color: rgba(22, 119, 255, 0.12);
		border-color: transparent;
	}

	/* ===== info ===== */
	.nax-button--info-solid {
		background-color: var(--nax-color-info, #3491fa);
		border-color: var(--nax-color-info, #3491fa);
	}

	.nax-button--info-outline {
		background-color: transparent;
		border-color: var(--nax-color-info, #3491fa);
	}

	.nax-button--info-text {
		background-color: transparent;
		border-color: transparent;
	}

	.nax-button--info-light {
		background-color: rgba(52, 145, 250, 0.12);
		border-color: transparent;
	}

	/* ===== success ===== */
	.nax-button--success-solid {
		background-color: var(--nax-color-success, #00b578);
		border-color: var(--nax-color-success, #00b578);
	}

	.nax-button--success-outline {
		background-color: transparent;
		border-color: var(--nax-color-success, #00b578);
	}

	.nax-button--success-text {
		background-color: transparent;
		border-color: transparent;
	}

	.nax-button--success-light {
		background-color: rgba(0, 181, 120, 0.12);
		border-color: transparent;
	}

	/* ===== warning ===== */
	.nax-button--warning-solid {
		background-color: var(--nax-color-warning, #ff8f1f);
		border-color: var(--nax-color-warning, #ff8f1f);
	}

	.nax-button--warning-outline {
		background-color: transparent;
		border-color: var(--nax-color-warning, #ff8f1f);
	}

	.nax-button--warning-text {
		background-color: transparent;
		border-color: transparent;
	}

	.nax-button--warning-light {
		background-color: rgba(255, 143, 31, 0.12);
		border-color: transparent;
	}

	/* ===== error ===== */
	.nax-button--error-solid {
		background-color: var(--nax-color-error, var(--nax-color-danger, #ff3141));
		border-color: var(--nax-color-error, var(--nax-color-danger, #ff3141));
	}

	.nax-button--error-outline {
		background-color: transparent;
		border-color: var(--nax-color-error, var(--nax-color-danger, #ff3141));
	}

	.nax-button--error-text {
		background-color: transparent;
		border-color: transparent;
	}

	.nax-button--error-light {
		background-color: rgba(255, 49, 65, 0.12);
		border-color: transparent;
	}

	.nax-button__text,
	.nax-button__loading {
		text-align: center;
		font-weight: var(--nax-font-weight-medium, 500);
		text-overflow: ellipsis;
	}

	.nax-button__loading {
		margin-right: 6px;
	}

	.nax-button__text--sm {
		font-size: var(--nax-font-size-sm, 13px);
	}

	.nax-button__text--md {
		font-size: var(--nax-font-size-md, 14px);
	}

	.nax-button__text--lg {
		font-size: var(--nax-font-size-lg, 16px);
	}

	/* text colors: default */
	.nax-button__text--default-solid,
	.nax-button__text--default-outline,
	.nax-button__text--default-text,
	.nax-button__text--default-light {
		color: var(--nax-color-text, #1f1f1f);
	}

	/* text / border colors: tertiary 更淡 */
	.nax-button__text--tertiary-solid,
	.nax-button__text--tertiary-outline,
	.nax-button__text--tertiary-text,
	.nax-button__text--tertiary-light {
		color: var(--nax-color-text-secondary, #666666);
	}

	/* solid inverse text */
	.nax-button__text--primary-solid,
	.nax-button__text--info-solid,
	.nax-button__text--success-solid,
	.nax-button__text--warning-solid,
	.nax-button__text--error-solid {
		color: var(--nax-color-text-inverse, #ffffff);
	}

	.nax-button__text--primary-outline,
	.nax-button__text--primary-text,
	.nax-button__text--primary-light {
		color: var(--nax-color-primary, #1677ff);
	}

	.nax-button__text--info-outline,
	.nax-button__text--info-text,
	.nax-button__text--info-light {
		color: var(--nax-color-info, #3491fa);
	}

	.nax-button__text--success-outline,
	.nax-button__text--success-text,
	.nax-button__text--success-light {
		color: var(--nax-color-success, #00b578);
	}

	.nax-button__text--warning-outline,
	.nax-button__text--warning-text,
	.nax-button__text--warning-light {
		color: var(--nax-color-warning, #ff8f1f);
	}

	.nax-button__text--error-outline,
	.nax-button__text--error-text,
	.nax-button__text--error-light {
		color: var(--nax-color-error, var(--nax-color-danger, #ff3141));
	}

	.nax-button__text--disabled {
		color: var(--nax-color-text-disabled, #c0c0c0);
	}
</style>