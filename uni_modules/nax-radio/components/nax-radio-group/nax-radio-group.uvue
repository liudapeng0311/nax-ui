<template>
	<view class="nax-radio-group" :class="rootClass">
		<slot></slot>
	</view>
</template>

<script setup lang="uts">
	/**
	 * nax-radio-group
	 * @description 单选框组。管理多个 nax-radio 的唯一选中值。
	 * @property {string} modelValue 当前选中项 name/value（v-model）
	 * @property {boolean} disabled 整组禁用
	 * @property {string} shape circle | square（默认 circle）
	 * @property {string} size sm | md | lg
	 * @property {string} activeColor 选中色；空则主题 primary
	 * @property {string} iconSize 勾选图标字号（数字字符串 px）
	 * @property {string} labelSize 文案字号（数字字符串 px）
	 * @property {boolean} labelDisabled 为 true 时点击文案不切换
	 * @property {boolean} wrap 是否每个选项独占一行
	 * @property {string} width 子项宽度（如 50% / 120px）
	 * @property {string} customClass 根节点扩展 class
	 * @event update:modelValue v-model
	 * @event change 选中值变化（string）
	 * @slot default 放置 nax-radio
	 */
	const props = defineProps({
		modelValue: {
			type: String,
			default: ''
		},
		disabled: {
			type: Boolean,
			default: false
		},
		shape: {
			type: String,
			default: 'circle'
		},
		size: {
			type: String,
			default: 'md'
		},
		activeColor: {
			type: String,
			default: ''
		},
		iconSize: {
			type: String,
			default: ''
		},
		labelSize: {
			type: String,
			default: ''
		},
		labelDisabled: {
			type: Boolean,
			default: false
		},
		wrap: {
			type: Boolean,
			default: false
		},
		width: {
			type: String,
			default: ''
		},
		customClass: {
			type: String,
			default: ''
		}
	})

	const emit = defineEmits(['update:modelValue', 'change'])

	// 位于 nax-form-item 内时由表单项注入：值变化 / 失焦时回调，驱动规则 trigger 校验
	function fallbackItemValidate(_event: string, _value: any | null) {
	}
	const formItemValidateRaw = inject('naxFormItemValidate', fallbackItemValidate) as (event: string, value: any | null) => void

	function notifyFormItem(event: string, value: any | null) {
		formItemValidateRaw(event, value)
	}

	const selected = ref('')
	// Android inject 会按默认值推断具体运行时类型，需与子组件的 RefImpl 默认值保持一致。
	// #ifdef APP-ANDROID
	const disabledState = ref(props.disabled)
	const shapeState = ref(props.shape)
	const sizeState = ref(props.size)
	const activeColorState = ref(props.activeColor)
	const iconSizeState = ref(props.iconSize)
	const labelSizeState = ref(props.labelSize)
	const labelDisabledState = ref(props.labelDisabled)
	const widthState = ref(props.width)
	const wrapState = ref(props.wrap)
	// #endif

	function syncFromProps() {
		selected.value = props.modelValue
	}

	syncFromProps()

	watch((): string => {
		return props.modelValue
	}, (_ : string) => {
		syncFromProps()
	})
	// #ifdef APP-ANDROID
	watch((): boolean => props.disabled, (value : boolean) => { disabledState.value = value })
	watch((): string => props.shape, (value : string) => { shapeState.value = value })
	watch((): string => props.size, (value : string) => { sizeState.value = value })
	watch((): string => props.activeColor, (value : string) => { activeColorState.value = value })
	watch((): string => props.iconSize, (value : string) => { iconSizeState.value = value })
	watch((): string => props.labelSize, (value : string) => { labelSizeState.value = value })
	watch((): boolean => props.labelDisabled, (value : boolean) => { labelDisabledState.value = value })
	watch((): string => props.width, (value : string) => { widthState.value = value })
	watch((): boolean => props.wrap, (value : boolean) => { wrapState.value = value })
	// #endif

	/**
	 * 选中某项
	 * @return 是否发生变更
	 */
	function selectItem(name : string) : boolean {
		if (props.disabled) {
			return false
		}
		if (name.length == 0) {
			return false
		}
		if (selected.value == name) {
			return false
		}
		selected.value = name
		emit('update:modelValue', name)
		emit('change', name)
		notifyFormItem('change', name)
		return true
	}

	// 向子 radio 注入上下文（字符串 key，避免跨端符号问题）
	provide('naxRdInGroup', true)
	provide('naxRdSelected', selected)
	provide('naxRdSelect', selectItem)
	// #ifdef APP-ANDROID
	provide('naxRdDisabled', disabledState)
	provide('naxRdShape', shapeState)
	provide('naxRdSize', sizeState)
	provide('naxRdActiveColor', activeColorState)
	provide('naxRdIconSize', iconSizeState)
	provide('naxRdLabelSize', labelSizeState)
	provide('naxRdLabelDisabled', labelDisabledState)
	provide('naxRdWidth', widthState)
	provide('naxRdWrap', wrapState)
	// #endif
	// #ifndef APP-ANDROID
	provide('naxRdDisabled', computed((): boolean => {
		return props.disabled
	}))
	provide('naxRdShape', computed((): string => {
		return props.shape
	}))
	provide('naxRdSize', computed((): string => {
		return props.size
	}))
	provide('naxRdActiveColor', computed((): string => {
		return props.activeColor
	}))
	provide('naxRdIconSize', computed((): string => {
		return props.iconSize
	}))
	provide('naxRdLabelSize', computed((): string => {
		return props.labelSize
	}))
	provide('naxRdLabelDisabled', computed((): boolean => {
		return props.labelDisabled
	}))
	provide('naxRdWidth', computed((): string => {
		return props.width
	}))
	provide('naxRdWrap', computed((): boolean => {
		return props.wrap
	}))
	// #endif

	const rootClass = computed((): string => {
		var cls = ''
		if (props.wrap) {
			cls += ' nax-radio-group--wrap'
		} else {
			cls += ' nax-radio-group--row'
		}
		if (props.customClass.length > 0) {
			cls += ' ' + props.customClass
		}
		return cls.trim()
	})
</script>

<style>
	.nax-radio-group--row {
		flex-direction: row;
		flex-wrap: wrap;
		align-items: center;
	}

	.nax-radio-group--wrap {
		flex-direction: column;
		align-items: flex-start;
	}
</style>
