<template>
	<view class="nax-radio" :class="rootClass" :style="rootStyle">
		<view
			class="nax-radio__box"
			:class="boxClass"
			:style="boxStyle"
			@click.stop="onBoxClick"
		>
			<nax-icon
				v-if="checked"
				name="check"
				:size="iconSizePx"
				:color="checkIconColor"
			></nax-icon>
		</view>

		<text
			v-if="hasLabel"
			class="nax-radio__label"
			:max-lines="1"
			:class="labelClass"
			:style="labelStyle"
			@click.stop="onLabelClick"
		>{{ labelText }}</text>

		<view class="nax-radio__slot" @click.stop="onLabelClick">
			<slot></slot>
		</view>
	</view>
</template>

<script setup lang="uts">
	/**
	 * nax-radio
	 * @description 单选框。可单独使用（v-model 布尔）或置于 nax-radio-group 内。
	 * @property {boolean} modelValue 单独使用时的选中态（v-model）
	 * @property {string} name 选项标识（组内）；value 优先
	 * @property {string} value 选项标识，优先级高于 name
	 * @property {string} label 右侧文案
	 * @property {string} shape circle | square（默认 circle）
	 * @property {boolean} disabled 禁用
	 * @property {boolean} labelDisabled 为 true 时点击文案不切换
	 * @property {string} activeColor 选中色
	 * @property {string} iconSize 勾选图标字号（数字字符串 px）
	 * @property {string} labelSize 文案字号（数字字符串 px）
	 * @property {string} size sm | md | lg
	 * @property {string} customClass 根节点扩展 class
	 * @event update:modelValue 单独使用时的 v-model
	 * @event change 选中态变化；组内为选项 name，单独为 boolean
	 * @slot default 自定义标签内容
	 */
	const props = defineProps({
		modelValue: {
			type: Boolean,
			default: false
		},
		name: {
			type: String,
			default: ''
		},
		value: {
			type: String,
			default: ''
		},
		label: {
			type: String,
			default: ''
		},
		shape: {
			type: String,
			default: 'circle'
		},
		disabled: {
			type: Boolean,
			default: false
		},
		labelDisabled: {
			type: Boolean,
			default: false
		},
		activeColor: {
			type: String,
			default: ''
		},
		iconSize: {
			type: String,
			default: ''
		},
		labelSize: {
			type: String,
			default: ''
		},
		size: {
			type: String,
			default: 'md'
		},
		customClass: {
			type: String,
			default: ''
		}
	})

	const emit = defineEmits(['update:modelValue', 'change'])

	// Android inject 不能用 null 作为 Ref/函数默认值，否则 UTS 会推断为 Void。
	// #ifdef APP-ANDROID
	function fallbackSelect(_name : string) : boolean {
		return false
	}
	// #endif

	const inGroup = inject('naxRdInGroup', false) as boolean
	// #ifdef APP-ANDROID
	const selectedRef = inject('naxRdSelected', ref('')) as Ref<string>
	const selectRaw = inject('naxRdSelect', fallbackSelect) as (name : string) => boolean
	const groupDisabledRef = inject('naxRdDisabled', ref(false)) as Ref<boolean>
	const groupShapeRef = inject('naxRdShape', ref('circle')) as Ref<string>
	const groupSizeRef = inject('naxRdSize', ref('md')) as Ref<string>
	const groupActiveColorRef = inject('naxRdActiveColor', ref('')) as Ref<string>
	const groupIconSizeRef = inject('naxRdIconSize', ref('')) as Ref<string>
	const groupLabelSizeRef = inject('naxRdLabelSize', ref('')) as Ref<string>
	const groupLabelDisabledRef = inject('naxRdLabelDisabled', ref(false)) as Ref<boolean>
	const groupWidthRef = inject('naxRdWidth', ref('')) as Ref<string>
	const groupWrapRef = inject('naxRdWrap', ref(false)) as Ref<boolean>
	// #endif
	// #ifndef APP-ANDROID
	const selectedRef = inject('naxRdSelected', null)
	const selectRaw = inject('naxRdSelect', null)
	const groupDisabledRef = inject('naxRdDisabled', null)
	const groupShapeRef = inject('naxRdShape', null)
	const groupSizeRef = inject('naxRdSize', null)
	const groupActiveColorRef = inject('naxRdActiveColor', null)
	const groupIconSizeRef = inject('naxRdIconSize', null)
	const groupLabelSizeRef = inject('naxRdLabelSize', null)
	const groupLabelDisabledRef = inject('naxRdLabelDisabled', null)
	const groupWidthRef = inject('naxRdWidth', null)
	const groupWrapRef = inject('naxRdWrap', null)
	// #endif

	function readRefBool(r : any | null, fallback : boolean) : boolean {
		if (r == null) {
			return fallback
		}
		return (r as Ref<boolean>).value
	}

	function readRefString(r : any | null, fallback : string) : string {
		if (r == null) {
			return fallback
		}
		return (r as Ref<string>).value
	}

	function readSelected() : string {
		if (selectedRef == null) {
			return ''
		}
		return (selectedRef as Ref<string>).value
	}

	function callSelect(name : string) : boolean {
		if (selectRaw == null) {
			return false
		}
		const fn = selectRaw as (n : string) => boolean
		return fn(name)
	}

	const itemName = computed((): string => {
		if (props.value.length > 0) {
			return props.value
		}
		return props.name
	})

	const checked = computed((): boolean => {
		if (inGroup && selectedRef != null) {
			const name = itemName.value
			if (name.length == 0) {
				return false
			}
			return readSelected() == name
		}
		return props.modelValue
	})

	const isDisabled = computed((): boolean => {
		if (props.disabled) {
			return true
		}
		if (inGroup && readRefBool(groupDisabledRef, false)) {
			return true
		}
		return false
	})

	const mergedShape = computed((): string => {
		if (inGroup) {
			const g = readRefString(groupShapeRef, '')
			if (g == 'circle' || g == 'square') {
				return g
			}
		}
		if (props.shape == 'square') {
			return 'square'
		}
		return 'circle'
	})

	const mergedSize = computed((): string => {
		if (inGroup) {
			const g = readRefString(groupSizeRef, '')
			if (g == 'sm' || g == 'md' || g == 'lg') {
				return g
			}
		}
		if (props.size == 'sm' || props.size == 'lg') {
			return props.size
		}
		return 'md'
	})

	const mergedActiveColor = computed((): string => {
		if (props.activeColor.length > 0) {
			return props.activeColor
		}
		if (inGroup) {
			return readRefString(groupActiveColorRef, '')
		}
		return ''
	})

	const mergedIconSize = computed((): string => {
		if (props.iconSize.length > 0) {
			return props.iconSize
		}
		if (inGroup) {
			return readRefString(groupIconSizeRef, '')
		}
		return ''
	})

	const mergedLabelSize = computed((): string => {
		if (props.labelSize.length > 0) {
			return props.labelSize
		}
		if (inGroup) {
			return readRefString(groupLabelSizeRef, '')
		}
		return ''
	})

	const mergedLabelDisabled = computed((): boolean => {
		if (props.labelDisabled) {
			return true
		}
		if (inGroup) {
			return readRefBool(groupLabelDisabledRef, false)
		}
		return false
	})

	const itemWidth = computed((): string => {
		if (inGroup) {
			return readRefString(groupWidthRef, '')
		}
		return ''
	})

	const groupWrap = computed((): boolean => {
		if (inGroup) {
			return readRefBool(groupWrapRef, false)
		}
		return false
	})

	function sizeBoxPx() : number {
		const s = mergedSize.value
		if (s == 'sm') {
			return 16
		}
		if (s == 'lg') {
			return 22
		}
		return 18
	}

	function sizeLabelPx() : number {
		const s = mergedSize.value
		if (s == 'sm') {
			return 14
		}
		if (s == 'lg') {
			return 18
		}
		return 16
	}

	function sizeIconDefaultPx() : number {
		const s = mergedSize.value
		if (s == 'sm') {
			return 12
		}
		if (s == 'lg') {
			return 16
		}
		return 14
	}

	function parsePx(value : string, fallback : number) : number {
		if (value.length == 0) {
			return fallback
		}
		const n = parseFloat(value)
		if (isNaN(n) || n <= 0) {
			return fallback
		}
		return n
	}

	const iconSizePx = computed((): string => {
		const px = parsePx(mergedIconSize.value, sizeIconDefaultPx())
		return '' + Math.floor(px)
	})

	const labelFontPx = computed((): number => {
		return parsePx(mergedLabelSize.value, sizeLabelPx())
	})

	const activeColorValue = computed((): string => {
		if (mergedActiveColor.value.length > 0) {
			return mergedActiveColor.value
		}
		return 'var(--nax-color-primary, #18a058)'
	})

	const checkIconColor = computed((): string => {
		return 'var(--nax-color-text-inverse, #ffffff)'
	})

	const hasLabel = computed((): boolean => {
		return props.label.length > 0
	})

	const labelText = computed((): string => {
		return props.label
	})

	const rootClass = computed((): string => {
		var cls = 'nax-radio--' + mergedSize.value
		if (checked.value) {
			cls += ' nax-radio--checked'
		}
		if (isDisabled.value) {
			cls += ' nax-radio--disabled'
		}
		if (mergedShape.value == 'square') {
			cls += ' nax-radio--square'
		} else {
			cls += ' nax-radio--circle'
		}
		if (groupWrap.value) {
			cls += ' nax-radio--block'
		}
		if (props.customClass.length > 0) {
			cls += ' ' + props.customClass
		}
		return cls.trim()
	})

	const rootStyle = computed((): string => {
		var style = ''
		const w = itemWidth.value
		if (w.length > 0) {
			style += 'width:' + w + ';'
			// 指定宽度时去掉右外边距，避免 50% + margin 换行错位
			style += 'margin-right:0;'
			style += 'padding-right:8px;'
		}
		return style
	})

	const boxClass = computed((): string => {
		var cls = ''
		if (checked.value) {
			cls += ' nax-radio__box--checked'
		}
		if (mergedShape.value == 'square') {
			cls += ' nax-radio__box--square'
		} else {
			cls += ' nax-radio__box--circle'
		}
		return cls.trim()
	})

	const boxStyle = computed((): string => {
		const box = sizeBoxPx()
		var style = ''
		style += 'width:' + box + 'px;'
		style += 'height:' + box + 'px;'
		if (checked.value) {
			style += 'background-color:' + activeColorValue.value + ';'
			style += 'border-color:' + activeColorValue.value + ';'
		}
		return style
	})

	const labelClass = computed((): string => {
		var cls = ''
		if (isDisabled.value) {
			cls += ' nax-radio__label--disabled'
		}
		return cls.trim()
	})

	const labelStyle = computed((): string => {
		return 'font-size:' + labelFontPx.value + 'px;'
	})

	function select() {
		if (isDisabled.value) {
			return
		}
		if (inGroup) {
			const name = itemName.value
			if (name.length == 0) {
				return
			}
			// 已选中时不重复触发（对齐 ）
			if (checked.value) {
				return
			}
			const ok = callSelect(name)
			if (!ok) {
				return
			}
			emit('change', name)
			return
		}
		// 单独使用：布尔切换；再次点击可取消
		const next = !props.modelValue
		emit('update:modelValue', next)
		emit('change', next)
	}

	function onBoxClick() {
		select()
	}

	function onLabelClick() {
		if (mergedLabelDisabled.value) {
			return
		}
		select()
	}
</script>

<style>
	.nax-radio {
		flex-direction: row;
		align-items: center;
		margin-right: 16px;
		/* 行内不留底边距，避免 form-item 内相对标签偏高/不居中 */
		margin-bottom: 0;
	}

	.nax-radio--block {
		margin-right: 0;
		margin-bottom: 8px;
		width: 100%;
	}

	.nax-radio__box {
		flex-direction: row;
		align-items: center;
		justify-content: center;
		border-width: 1px;
		border-style: solid;
		border-color: var(--nax-color-border-strong, #e5e5ea);
		background-color: var(--nax-color-bg, #ffffff);
		border-radius: var(--nax-radius-full, 999px);
		flex-shrink: 0;
	}

	.nax-radio__box--circle {
		border-radius: var(--nax-radius-full, 999px);
	}

	.nax-radio__box--square {
		border-radius: var(--nax-radius-sm, 3px);
	}

	.nax-radio--disabled {
		opacity: var(--nax-opacity-disabled, 0.45);
	}

	.nax-radio__label {
		margin-left: 8px;
		color: var(--nax-color-text, #333639);
	}

	.nax-radio__label--disabled {
		color: var(--nax-color-text-disabled, #e5e5ea);
	}

	.nax-radio__slot {
		flex-direction: row;
		align-items: center;
	}
</style>
