<template>
	<!-- dialogPage 内置宿主：透明全屏；鸿蒙遮罩动画对齐 nax-picker 三阶段 -->
	<view class="nax-popup-host nax-theme" :class="themeClass">
		<view
			v-if="maskEnabled"
			class="nax-popup-host__mask"
			:class="maskClass"
			:style="maskStyle"
			@click="onMaskClick"
		></view>
		<view
			class="nax-popup-host__layer"
			:class="layerClass"
			:style="layerStyle"
			@click.stop="onPanelClick"
		>
			<view class="nax-popup-host__panel" :class="panelClass" :style="panelStyle">
				<!-- 头部：标题 + 右上角关闭 -->
				<view v-if="headerVisible" class="nax-popup-host__header">
					<text v-if="titleText.length > 0" class="nax-popup-host__title" :max-lines="1">{{ titleText }}</text>
					<view
						v-if="showCloseOn"
						class="nax-popup-host__close"
						hover-class="nax-popup-host__close--hover"
						:hover-start-time="20"
						:hover-stay-time="70"
						@click="onCloseClick"
					>
						<text class="nax-popup-host__close-icon" :max-lines="1">✕</text>
					</view>
				</view>
				<text v-if="contentText.length > 0" class="nax-popup-host__content" :max-lines="20">{{ contentText }}</text>
				<view v-if="showFooterBtn" class="nax-popup-host__actions">
					<view
						class="nax-popup-host__btn"
						hover-class="nax-popup-host__btn--hover"
						:hover-start-time="20"
						:hover-stay-time="70"
						@click="onCloseClick"
					>
						<text class="nax-popup-host__btn-text" :max-lines="1">关闭</text>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	/**
	 * nax-popup 内置 dialogPage 宿主
	 * 鸿蒙：遮罩三阶段（先落透明起始态 → 开 transition → 与面板同帧点亮），对齐 nax-picker / nax-dialog
	 */
	import {
		getNaxPopupSession,
		notifyNaxPopupAction
	} from '../../index.uts'

	const titleText = ref('')
	const contentText = ref('')
	const position = ref('center')
	/** 是否渲染遮罩（会话配置） */
	const maskEnabled = ref(true)
	const maskClosable = ref(true)
	const roundOn = ref(true)
	const widthText = ref('')
	const heightText = ref('')
	const animDuration = ref(280)
	const themeClass = ref('')
	const showHeaderOn = ref(true)
	const showCloseOn = ref(true)
	/** 左右抽屉顶部安全距离（px）：App 预留状态栏；微信小程序右侧抽屉预留到胶囊下方 */
	const drawerSafeTopPx = ref(0)
	/** 面板是否处于结束态 */
	const panelShow = ref(false)
	/** 鸿蒙：遮罩是否点亮（opacity 0→0.4） */
	const hmMaskOn = ref(false)
	/** 鸿蒙：是否已启用 transition（阶段2 后才 true） */
	const hmAnimReady = ref(false)
	/** 关闭中，避免重复 */
	const closing = ref(false)

	let openDelayTimer: number = -1
	let enterReadyTimer: number = -1
	let enterToTimer: number = -1
	let leaveTimer: number = -1

	function clearOpenTimers() {
		if (openDelayTimer >= 0) {
			clearTimeout(openDelayTimer)
			openDelayTimer = -1
		}
		if (enterReadyTimer >= 0) {
			clearTimeout(enterReadyTimer)
			enterReadyTimer = -1
		}
		if (enterToTimer >= 0) {
			clearTimeout(enterToTimer)
			enterToTimer = -1
		}
	}

	function clearLeaveTimer() {
		if (leaveTimer >= 0) {
			clearTimeout(leaveTimer)
			leaveTimer = -1
		}
	}

	function resolveDuration(): number {
		const d = animDuration.value
		if (d > 0) {
			return d
		}
		return 280
	}

	const maskClass = computed((): string => {
		// #ifdef APP-HARMONY
		if (hmMaskOn.value) {
			return 'nax-popup-host__mask--show'
		}
		return ''
		// #endif
		// #ifndef APP-HARMONY
		if (panelShow.value) {
			return 'nax-popup-host__mask--show'
		}
		return ''
		// #endif
	})

	const maskStyle = computed((): string => {
		const d = resolveDuration()
		// #ifdef APP-HARMONY
		// 实色黑 + opacity；阶段1 无 transition，避免首帧闪黑
		var ms = 'background-color:#000000;'
		if (hmAnimReady.value && d > 0) {
			ms += 'transition-property:opacity;'
			ms += 'transition-timing-function:ease-out;'
			ms += 'transition-duration:' + d.toString() + 'ms;'
		} else {
			ms += 'transition-property:none;'
			ms += 'transition-duration:0ms;'
		}
		if (hmMaskOn.value) {
			ms += 'opacity:0.4;'
		} else {
			ms += 'opacity:0;'
		}
		return ms
		// #endif
		// #ifndef APP-HARMONY
		return 'transition-duration:' + d.toString() + 'ms;'
		// #endif
	})

	const layerClass = computed((): string => {
		var cls = 'nax-popup-host__layer--' + position.value
		if (panelShow.value) {
			cls = cls + ' nax-popup-host__layer--show'
		}
		return cls
	})

	const layerStyle = computed((): string => {
		const d = resolveDuration()
		// #ifdef APP-HARMONY
		var ls = ''
		if (hmAnimReady.value && d > 0) {
			ls += 'transition-property:opacity,transform;'
			ls += 'transition-timing-function:ease-out;'
			ls += 'transition-duration:' + d.toString() + 'ms;'
		} else {
			// 阶段1：无 transition，先钉死起始态
			ls += 'transition-property:none;'
			ls += 'transition-duration:0ms;'
		}
		return ls
		// #endif
		// #ifndef APP-HARMONY
		return 'transition-duration:' + d.toString() + 'ms;'
		// #endif
	})

	const panelClass = computed((): string => {
		var cls = 'nax-popup-host__panel--' + position.value
		if (roundOn.value) {
			cls = cls + ' nax-popup-host__panel--round-' + position.value
		}
		return cls
	})

	const panelStyle = computed((): string => {
		var s = ''
		if (widthText.value.length > 0) {
			s = s + 'width:' + widthText.value + ';'
		}
		if (heightText.value.length > 0) {
			s = s + 'height:' + heightText.value + ';'
		}
		// 左右抽屉顶部安全距离：App 预留状态栏；微信小程序右侧抽屉避开胶囊
		if (drawerSafeTopPx.value > 0) {
			s = s + 'padding-top:' + drawerSafeTopPx.value.toString() + 'px;'
		}
		return s
	})

	const headerVisible = computed((): boolean => {
		return showHeaderOn.value && (titleText.value.length > 0 || showCloseOn.value)
	})

	/** 无右上角关闭按钮时，保留底部「关闭」按钮作为关闭渠道 */
	const showFooterBtn = computed((): boolean => {
		return !showCloseOn.value
	})

	function loadSession() {
		const s = getNaxPopupSession()
		const t = s.getString('title')
		if (t != null) {
			titleText.value = t as string
		}
		const c = s.getString('content')
		if (c != null) {
			contentText.value = c as string
		}
		const p = s.getString('position')
		if (p != null && (p as string).length > 0) {
			position.value = p as string
		}
		const m = s.getBoolean('mask')
		if (m != null) {
			maskEnabled.value = m as boolean
		}
		const mc = s.getBoolean('maskClosable')
		if (mc != null) {
			maskClosable.value = mc as boolean
		}
		const r = s.getBoolean('round')
		if (r != null) {
			roundOn.value = r as boolean
		}
		const w = s.getString('width')
		if (w != null) {
			widthText.value = w as string
		}
		const h = s.getString('height')
		if (h != null) {
			heightText.value = h as string
		}
		const d = s.getNumber('duration')
		if (d != null) {
			const dv = d as number
			if (dv > 0) {
				animDuration.value = dv
			}
		}
		const tc = s.getString('themeClass')
		if (tc != null) {
			themeClass.value = tc as string
		}
		const sh = s.getBoolean('showHeader')
		if (sh != null) {
			showHeaderOn.value = sh as boolean
		}
		const sc = s.getBoolean('showClose')
		if (sc != null) {
			showCloseOn.value = sc as boolean
		}
	}

	/**
	 * 微信小程序：按 width 文本折算抽屉面板宽度（px），用于判断是否横向覆盖胶囊区域。
	 * 空值按默认 78% 屏宽；纯数字按 px；纯数字百分比按屏宽折算；其它/无法解析返回 -1（按覆盖处理）
	 */
	function drawerWidthPxForCapsule(widthStr: string, windowW: number): number {
		if (windowW <= 0) {
			return -1
		}
		if (widthStr.length == 0) {
			return Math.floor(windowW * 0.78)
		}
		var i = 0
		var digits = true
		while (i < widthStr.length) {
			const c = widthStr.charAt(i)
			if (c < '0' || c > '9') {
				digits = false
				break
			}
			i++
		}
		if (digits) {
			return parseFloat(widthStr)
		}
		if (widthStr.indexOf('%') >= 0) {
			const numStr = widthStr.substring(0, widthStr.indexOf('%'))
			var numDigits = numStr.length > 0
			var j = 0
			while (j < numStr.length) {
				const c2 = numStr.charAt(j)
				if (c2 < '0' || c2 > '9') {
					numDigits = false
					break
				}
				j++
			}
			if (numDigits) {
				return Math.floor(windowW * (parseFloat(numStr) / 100.0))
			}
		}
		return -1
	}

	/**
	 * 左右抽屉顶部安全距离（仅左右抽屉生效）：
	 * - App：预留状态栏高度（dialogPage 自绘内容会顶到状态栏）
	 * - 微信小程序：面板横向覆盖胶囊区域时，预留到胶囊下沿，避免内容与胶囊重叠
	 */
	function refreshDrawerSafeTop() {
		const pos = position.value
		if (pos != 'left' && pos != 'right') {
			drawerSafeTopPx.value = 0
			return
		}
		// #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
		const info = uni.getWindowInfo()
		let top = 0
		if (info.statusBarHeight != null) {
			top = info.statusBarHeight as number
		}
		drawerSafeTopPx.value = top > 0 ? top : 0
		// #endif
		// #ifdef MP-WEIXIN
		let topMp = 0
		const win = uni.getWindowInfo()
		if (win.statusBarHeight != null) {
			topMp = win.statusBarHeight as number
		}
		const screenW = win.windowWidth > 0 ? win.windowWidth : 0
		// 胶囊固定在屏幕右上角：按面板横向范围判断是否与胶囊区域重叠
		// （左抽屉默认 78% 宽已轻微覆盖胶囊，width=100% 完全覆盖；右抽屉则始终覆盖）
		const wPx = drawerWidthPxForCapsule(widthText.value, screenW)
		var capsuleCovered = true
		if (wPx >= 0 && screenW > 0) {
			const panelRight = pos == 'left' ? wPx : screenW
			const rect0 = uni.getMenuButtonBoundingClientRect()
			const capsuleLeft = rect0 != null && rect0.left != null ? rect0.left as number : 0
			capsuleCovered = panelRight > capsuleLeft
		}
		if (capsuleCovered) {
			const rect = uni.getMenuButtonBoundingClientRect()
			if (rect != null && rect.bottom != null && (rect.bottom as number) > topMp) {
				topMp = rect.bottom as number
			}
		}
		drawerSafeTopPx.value = topMp > 0 ? topMp + 4 : 0
		// #endif
		// #ifndef APP-ANDROID || APP-IOS || APP-HARMONY || MP-WEIXIN
		drawerSafeTopPx.value = 0
		// #endif
	}

	function startOpenAnim() {
		clearOpenTimers()
		panelShow.value = false
		// #ifdef APP-HARMONY
		// 三阶段：挂载起始态(无 transition) → 开 transition → 遮罩+面板同帧结束态
		// 遮罩绝不能比面板更早点亮，否则先闪黑
		hmMaskOn.value = false
		hmAnimReady.value = false
		openDelayTimer = setTimeout(() => {
			openDelayTimer = -1
			enterReadyTimer = setTimeout(() => {
				enterReadyTimer = -1
				hmAnimReady.value = true
				enterToTimer = setTimeout(() => {
					enterToTimer = -1
					hmMaskOn.value = true
					panelShow.value = true
				}, 32)
			}, 48)
		}, 32)
		// #endif
		// #ifndef APP-HARMONY
		openDelayTimer = setTimeout(() => {
			openDelayTimer = -1
			panelShow.value = true
		}, 30)
		// #endif
	}

	function finishClose(action: string) {
		notifyNaxPopupAction(action)
		// #ifdef APP-ANDROID || APP-IOS || APP-HARMONY || WEB || H5
		uni.closeDialogPage({})
		// #endif
	}

	function startClose(action: string) {
		if (closing.value) {
			return
		}
		closing.value = true
		clearOpenTimers()
		clearLeaveTimer()
		// 先退场再关 dialogPage
		panelShow.value = false
		// #ifdef APP-HARMONY
		hmMaskOn.value = false
		// #endif
		const d = resolveDuration()
		leaveTimer = setTimeout(() => {
			leaveTimer = -1
			finishClose(action)
		}, d)
	}

	function onMaskClick() {
		if (!maskClosable.value) {
			return
		}
		if (closing.value) {
			return
		}
		startClose('mask')
	}

	function onCloseClick() {
		if (closing.value) {
			return
		}
		startClose('close')
	}

	function onPanelClick() {
		// stop bubble
	}

	onLoad(() => {
		loadSession()
		refreshDrawerSafeTop()
		startOpenAnim()
	})

	onUnload(() => {
		clearOpenTimers()
		clearLeaveTimer()
		notifyNaxPopupAction('dismiss')
	})
</script>

<style>
	.nax-popup-host {
		position: absolute;
		left: 0;
		top: 0;
		right: 0;
		bottom: 0;
		flex-direction: column;
	}

	.nax-popup-host__mask {
		position: absolute;
		left: 0;
		top: 0;
		right: 0;
		bottom: 0;
		z-index: 1;
		/* #ifndef APP-HARMONY */
		background-color: var(--nax-color-mask, rgba(0, 0, 0, 0.4));
		opacity: 0;
		transition-property: opacity;
		transition-duration: 280ms;
		transition-timing-function: ease-out;
		/* #endif */
		/* #ifdef APP-HARMONY */
		/* 实色黑 + opacity；时长/开关由 inline style 控制（对齐 nax-picker） */
		background-color: #000000;
		opacity: 0;
		/* #endif */
	}

	/* #ifndef APP-HARMONY */
	.nax-popup-host__mask--show {
		opacity: 1;
	}
	/* #endif */

	/* #ifdef APP-HARMONY */
	.nax-popup-host__mask--show {
		opacity: 0.4;
	}
	/* #endif */

	.nax-popup-host__layer {
		position: absolute;
		left: 0;
		top: 0;
		right: 0;
		bottom: 0;
		z-index: 2;
		flex-direction: column;
		opacity: 0;
		/* #ifndef APP-HARMONY */
		transition-property: opacity, transform;
		transition-duration: 280ms;
		transition-timing-function: ease-out;
		/* #endif */
	}

	.nax-popup-host__layer--center {
		justify-content: center;
		align-items: center;
		transform: scale(0.92);
	}

	.nax-popup-host__layer--bottom {
		justify-content: flex-end;
		align-items: stretch;
		transform: translateY(24px);
	}

	.nax-popup-host__layer--left {
		justify-content: flex-start;
		align-items: flex-start;
		transform: translateX(-24px);
	}

	.nax-popup-host__layer--right {
		justify-content: flex-start;
		align-items: flex-end;
		transform: translateX(24px);
	}

	.nax-popup-host__layer--show {
		opacity: 1;
		transform: scale(1) translateX(0) translateY(0);
	}

	.nax-popup-host__panel {
		flex-direction: column;
		background-color: var(--nax-color-bg, #ffffff);
		padding-top: 0px;
		padding-bottom: 16px;
		padding-left: 0px;
		padding-right: 0px;
		overflow: hidden;
	}

	.nax-popup-host__panel--center {
		width: 300px;
	}

	.nax-popup-host__panel--bottom {
		width: 100%;
	}

	.nax-popup-host__panel--left {
		width: 78%;
		height: 100%;
	}

	.nax-popup-host__panel--right {
		width: 78%;
		height: 100%;
	}

	.nax-popup-host__panel--round-center {
		border-top-left-radius: var(--nax-radius-lg, 8px);
		border-top-right-radius: var(--nax-radius-lg, 8px);
		border-bottom-left-radius: var(--nax-radius-lg, 8px);
		border-bottom-right-radius: var(--nax-radius-lg, 8px);
	}

	.nax-popup-host__panel--round-bottom {
		border-top-left-radius: var(--nax-radius-xl, 12px);
		border-top-right-radius: var(--nax-radius-xl, 12px);
	}

	.nax-popup-host__panel--round-left {
		border-top-right-radius: var(--nax-radius-xl, 12px);
		border-bottom-right-radius: var(--nax-radius-xl, 12px);
	}

	.nax-popup-host__panel--round-right {
		border-top-left-radius: var(--nax-radius-xl, 12px);
		border-bottom-left-radius: var(--nax-radius-xl, 12px);
	}

	.nax-popup-host__header {
		flex-direction: row;
		align-items: center;
		/* 无 title 时 header 内只剩关闭按钮，需固定靠右 */
		justify-content: flex-end;
		height: 45px;
		padding-left: 13px;
		padding-right: 12px;
	}

	.nax-popup-host__title {
		flex: 1;
		font-size: 16px;
		font-weight: 600;
		color: var(--nax-color-text, #333639);
		text-align: left;
	}

	.nax-popup-host__close {
		flex-direction: row;
		align-items: center;
		justify-content: center;
		width: 26px;
		height: 26px;
		margin-left: 8px;
	}

	.nax-popup-host__close--hover {
		opacity: 0.6;
	}

	.nax-popup-host__close-icon {
		font-size: 17px;
		line-height: 22px;
		color: var(--nax-color-text-secondary, #767c82);
		text-align: center;
	}

	.nax-popup-host__content {
		font-size: 14px;
		line-height: 21px;
		color: var(--nax-color-text-secondary, #767c82);
		text-align: center;
		margin-top: 14px;
		margin-bottom: 16px;
		margin-left: 20px;
		margin-right: 20px;
	}

	.nax-popup-host__actions {
		flex-direction: row;
		justify-content: center;
		align-items: center;
	}

	.nax-popup-host__btn {
		flex-direction: row;
		align-items: center;
		justify-content: center;
		height: 40px;
		padding-left: 20px;
		padding-right: 20px;
		border-radius: var(--nax-radius-md, 3px);
		background-color: var(--nax-color-primary, #18a058);
	}

	.nax-popup-host__btn--hover {
		opacity: 0.88;
	}

	.nax-popup-host__btn-text {
		font-size: 15px;
		font-weight: 500;
		color: var(--nax-color-text-inverse, #ffffff);
		text-align: center;
	}
</style>
