<template>
	<text
		class="nax-icon"
		:class="rootClass"
		:style="rootStyle"
		@click="onClick"
	>{{ glyph }}</text>
</template>

<script setup lang="uts">
	/**
	 * nax-icon
	 * @description 字体图标。默认图标集来自 Lucide（ISC）语义子集。
	 * @property {string} name 图标名，如 close / search / arrow-right
	 * @property {string} size sm | md | lg | 数字字符串（如 20）
	 * @property {string} color 可选颜色；默认走 --nax-icon-color / --nax-color-text
	 * @property {boolean} disabled 禁用点击
	 * @property {string} customClass 根节点扩展 class
	 * @event click 点击；disabled 时不触发
	 */
	import { getNaxIconGlyph } from '../../icons/glyphs.uts'

	const props = defineProps({
		name: {
			type: String,
			default: ''
		},
		size: {
			type: String,
			default: 'md'
		},
		color: {
			type: String,
			default: ''
		},
		disabled: {
			type: Boolean,
			default: false
		},
		customClass: {
			type: String,
			default: ''
		}
	})

	const emit = defineEmits(['click'])

	const glyph = computed((): string => {
		if (props.name.length == 0) {
			return ''
		}
		return getNaxIconGlyph(props.name)
	})

	const sizePx = computed((): number => {
		const value = props.size
		if (value == 'sm') {
			return 16
		}
		if (value == 'lg') {
			return 20
		}
		if (value == 'md') {
			return 18
		}
		const n = parseInt(value)
		if (n > 0) {
			return n
		}
		return 18
	})

	const rootClass = computed((): string => {
		let cls = ''
		if (props.disabled) {
			cls += ' nax-icon--disabled'
		}
		if (props.customClass.length > 0) {
			cls += ' ' + props.customClass
		}
		return cls.trim()
	})

	/**
	 * 尺寸全部走 inline style，避免 web/小程序 class 字号被继承或折算
	 * （曾出现 width/height=18px 但 font-size 变成 17px 导致视觉偏移）
	 */
	const rootStyle = computed((): string => {
		const px = sizePx.value.toString() + 'px'
		let style = ''
		style += 'width:' + px + ';'
		style += 'height:' + px + ';'
		style += 'font-size:' + px + ';'
		style += 'line-height:' + px + ';'
		// #ifdef APP-ANDROID
		// Android remove TextView extra padding; inline avoids uvue-css WARNING
		style += 'include-font-padding:false;'
		// #endif
		if (props.color.length > 0) {
			style += 'color:' + props.color + ';'
		}
		return style
	})

	function onClick() {
		if (props.disabled) {
			return
		}
		emit('click')
	}
</script>

<style>
	/*
	 * base64 内联字体：兼容微信小程序（禁止本地字体路径）
	 * uvue/Harmony: @font-face 仅支持 font-family + src
	 */
	@font-face {
		font-family: nax-icon;
		src: url('data:font/truetype;charset=utf-8;base64,') format('truetype');
	}

	/* 单节点 text：避免 view>text>span 多层导致基线偏移 */
	.nax-icon {
		font-family: nax-icon;
		color: var(--nax-icon-color, var(--nax-color-text, #333639));
		text-align: center;
		lines: 1;
		font-weight: normal;
		font-style: normal;
		overflow: hidden;
	}

	.nax-icon--disabled {
		opacity: var(--nax-opacity-disabled, 0.45);
	}
</style>
