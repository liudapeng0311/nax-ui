/**
 * 从任意对象读字段。
 * - 小程序 / Web：普通 object 无 getString，必须点字段访问
 * - App（Android/iOS/鸿蒙）：any 点属性会编译失败（找不到名称），此函数在 App 上不编译字段分支
 */
function demoReadAnyField(item : any, key : string) : any | null {
	// #ifndef APP-ANDROID || APP-IOS || APP-HARMONY
	const o = item as any
	if (key == 'name') {
		return o.name
	}
	if (key == 'tag') {
		return o.tag
	}
	if (key == 'path') {
		return o.path
	}
	if (key == 'icon') {
		return o.icon
	}
	if (key == 'group') {
		return o.group
	}
	if (key == 'hot') {
		return o.hot
	}
	if (key == 'text') {
		return o.text
	}
	if (key == 'desc') {
		return o.desc
	}
	if (key == 'tab') {
		return o.tab
	}
	if (key == 'url') {
		return o.url
	}
	if (key == 'title') {
		return o.title
	}
	if (key == 'label') {
		return o.label
	}
	// #endif
	return null
}

export function demoReadString(item : any | null, key : string) : string {
	if (item == null) {
		return ''
	}
	if (typeof item == 'string' || typeof item == 'number' || typeof item == 'boolean') {
		return ''
	}
	// #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
	// App：对象字面量 / query 多为 UTSJSONObject，用 API 读字段
	const obj = item as UTSJSONObject
	const s = obj.getString(key)
	if (s != null && s.length > 0) {
		return s
	}
	// #endif
	// #ifndef APP-ANDROID || APP-IOS || APP-HARMONY
	// 小程序 / Web：普通对象字段访问
	const field = demoReadAnyField(item, key)
	if (field != null) {
		if (typeof field == 'string') {
			return field as string
		}
		if (typeof field == 'number' || typeof field == 'boolean') {
			return '' + field
		}
	}
	// #endif
	return ''
}

export function demoReadBool(item : any | null, key : string) : boolean {
	if (item == null) {
		return false
	}
	if (typeof item == 'boolean') {
		return item as boolean
	}
	if (typeof item == 'string' || typeof item == 'number') {
		return false
	}
	// #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
	const obj = item as UTSJSONObject
	const b = obj.getBoolean(key)
	if (b != null) {
		return b as boolean
	}
	// #endif
	// #ifndef APP-ANDROID || APP-IOS || APP-HARMONY
	const field = demoReadAnyField(item, key)
	if (field != null) {
		if (typeof field == 'boolean') {
			return field as boolean
		}
		if (typeof field == 'string') {
			const fs = field as string
			return fs == 'true' || fs == '1'
		}
		if (typeof field == 'number') {
			return (field as number) != 0
		}
	}
	// #endif
	return false
}

/** onLoad query 读参：小程序为普通对象，App 多为 UTSJSONObject */
export function demoReadQueryString(query : any | null, key : string) : string {
	return demoReadString(query, key)
}

export function demoFilterComponents(group : string, keyword : string) : any[] {
	const all = demoComponentList()
	const kw = keyword.trim().toLowerCase()
	const out = [] as any[]
	for (let i = 0; i < all.length; i++) {
		const item = all[i]
		const g = demoReadString(item, 'group')
		if (group != 'all' && g != group) {
			continue
		}
		if (kw.length > 0) {
			const name = demoReadString(item, 'name').toLowerCase()
			const tag = demoReadString(item, 'tag').toLowerCase()
			if (name.indexOf(kw) < 0 && tag.indexOf(kw) < 0) {
				continue
			}
		}
		out.push(item)
	}
	return out
}

export function demoHotComponents() : any[] {
	const all = demoComponentList()
	const out = [] as any[]
	for (let i = 0; i < all.length; i++) {
		const item = all[i]
		if (demoReadBool(item, 'hot')) {
			out.push(item)
		}
	}
	return out
}

export function demoCountByGroup(group : string) : number {
	const all = demoComponentList()
	if (group == 'all') {
		return all.length
	}
	let n = 0
	for (let i = 0; i < all.length; i++) {
		if (demoReadString(all[i], 'group') == group) {
			n++
		}
	}
	return n
}

