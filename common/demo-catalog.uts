/**
 * 演示工程：组件目录（分组 + 路由）
 * 仅宿主使用，不进入 nax-ui 组件包。
 * 图标名需落在 nax-icon 当前子集内。
 */

export function demoTabPaths() : string[] {
	return [
		'/pages/index/index',
		'/pages/catalog/index',
		'/pages/scenes/index',
		'/pages/mine/index'
	] as string[]
}

export function demoTabList() : any[] {
	return [
		{ text: '首页', icon: 'home' },
		{ text: '组件', icon: 'category' },
		{ text: '场景', icon: 'star' },
		{ text: '我的', icon: 'user' }
	] as any[]
}

/**
 * 演示宿主 Tab 路由（多页 + 自定义 nax-tabbar）
 *
 * 性能关键：四个主 Tab 已注册为 pages.json 原生 tabBar 页，互切用 switchTab，
 * 系统保活页面实例，鸿蒙/App 上接近原生秒切。切勿对 Tab 页 reLaunch/redirectTo。
 *
 * 视觉：原生 tabBar 仅作路由容器，业务 UI 用 nax-tabbar；各 Tab 页 onShow 调 hideDemoNativeTabBar。
 * 方案说明见 docs/tabbar-routing.md
 */

/** switchTab 不带 query：跨页打开组件分类时用模块暂存，catalog onShow 消费 */
var pendingCatalogTab = -1

export function setPendingCatalogTab(index : number) {
	if (index < 0 || index > 4) {
		pendingCatalogTab = -1
		return
	}
	pendingCatalogTab = index
}

/** 取出并清空 pending 分类下标；无则 -1 */
export function takePendingCatalogTab() : number {
	const v = pendingCatalogTab
	pendingCatalogTab = -1
	return v
}

/** 隐藏原生 tabBar（仅 Tab 页可调；失败忽略，避免非 Tab 页报错刷屏） */
export function hideDemoNativeTabBar() {
	// VDOM 模式（web/部分 App 端）页面结构未就绪时 hideTabBar 可能查不到页面 body；
	// 失败不影响业务（原生 tabBar 为透明占位图，nax-tabbar 负责视觉）
	try {
		uni.hideTabBar({
			animation: false
		})
	} catch (e : any) {
		console.log('[nax-demo-catalog] hideTabBar failed: ' + (e as Error).message)
	}
}

export function switchDemoTab(index : number) {
	const paths = demoTabPaths()
	if (index < 0 || index >= paths.length) {
		return
	}
	uni.switchTab({
		url: paths[index]
	})
}

export function openDemoPage(path : string) {
	if (path.length == 0) {
		return
	}
	uni.navigateTo({
		url: path
	})
}

/** 分类：全部 / 基础 / 表单 / 布局 / 反馈 */
export function demoCategoryTabs() : any[] {
	return [
		{ name: '全部' },
		{ name: '基础' },
		{ name: '表单' },
		{ name: '布局' },
		{ name: '反馈' }
	] as any[]
}

export function demoCategoryKey(index : number) : string {
	if (index == 1) {
		return 'base'
	}
	if (index == 2) {
		return 'form'
	}
	if (index == 3) {
		return 'layout'
	}
	if (index == 4) {
		return 'feedback'
	}
	return 'all'
}

