<template>
  <view class="demo-form">
    <nax-form ref="formRef" :model="formModel" :rules="rules" :label-width="80" error-type="message">
      <nax-form-item label="姓名" prop="name" required>
        <nax-input v-model="nameField" border placeholder="请输入姓名"></nax-input>
      </nax-form-item>
      <nax-form-item label="简介" prop="intro">
        <nax-textarea v-model="introField" border height="80" placeholder="选填，至少 5 个字"></nax-textarea>
      </nax-form-item>
    </nax-form>
    <view class="demo-form__submit">
      <nax-button type="primary" label="提交校验" @click="onSubmit"></nax-button>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue'

// App UTS：组件 ref 不能按 any 调方法，需声明 expose 类型
type NaxFormExpose = {
  validate: () => Promise<boolean>
  resetFields: () => void
  clearValidate: () => void
}

const nameField = ref('')
const introField = ref('')
const formModel = ref({ name: '', intro: '' } as UTSJSONObject)

const rules = {
  name: [
    { required: true, message: '请输入姓名' } as UTSJSONObject,
    { min: 2, max: 10, message: '姓名长度 2-10 个字' } as UTSJSONObject
  ] as any[]
} as UTSJSONObject

const formRef = ref(null as NaxFormExpose | null)

function onSubmit() {
  formModel.value = { name: nameField.value, intro: introField.value } as UTSJSONObject
  const target = formRef.value
  if (target == null) return
  const ret = target.validate()
  const p = ret as Promise<boolean>
  p.then((ok: boolean) => {
    uni.showToast({ title: ok ? '校验通过' : '请检查表单', icon: 'none' })
  })
}
</script>

<style>
.demo-form {
  flex-direction: column;
}

.demo-form__submit {
  margin-top: 16px;
}
</style>
