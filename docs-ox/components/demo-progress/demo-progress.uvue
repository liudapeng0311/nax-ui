<template>
  <view class="demo-progress">
    <text class="dsec">基础线形</text>
    <nax-progress :percent="30"></nax-progress>
    <nax-progress :percent="60"></nax-progress>
    <nax-progress :percent="100"></nax-progress>

    <text class="dsec">动态 percent</text>
    <nax-progress :percent="dynamicPercent" type="primary" class="mb"></nax-progress>
    <view class="row mb">
      <nax-button size="sm" label="-10" @click="dec"></nax-button>
      <nax-button size="sm" type="primary" label="+10" @click="inc"></nax-button>
      <nax-button size="sm" variant="secondary" label="随机" @click="rand"></nax-button>
    </view>
    <nax-progress shape="circle" :percent="dynamicPercent" type="info" :width="112" :stroke-width="8"></nax-progress>

    <text class="dsec">类型 type</text>
    <nax-progress type="primary" :percent="70" class="mb"></nax-progress>
    <nax-progress type="info" :percent="70" class="mb"></nax-progress>
    <nax-progress type="success" :percent="70" class="mb"></nax-progress>
    <nax-progress type="warning" :percent="70" class="mb"></nax-progress>
    <nax-progress type="error" :percent="70"></nax-progress>

    <text class="dsec">尺寸 size</text>
    <nax-progress size="sm" :percent="50" class="mb"></nax-progress>
    <nax-progress size="md" :percent="50" class="mb"></nax-progress>
    <nax-progress size="lg" :percent="50"></nax-progress>

    <text class="dsec">条内文案 textInside</text>
    <nax-progress :percent="55" text-inside class="mb"></nax-progress>
    <nax-progress :percent="88" text-inside type="success"></nax-progress>

    <text class="dsec">隐藏文案 / 自定义 pivotText</text>
    <nax-progress :percent="40" :show-info="false" class="mb"></nax-progress>
    <nax-progress :percent="40" pivot-text="上传中"></nax-progress>

    <text class="dsec">status 覆盖色</text>
    <nax-progress :percent="100" status="success" class="mb"></nax-progress>
    <nax-progress :percent="60" status="warning" class="mb"></nax-progress>
    <nax-progress :percent="30" status="error"></nax-progress>

    <text class="dsec">圆形 shape=circle</text>
    <view class="row">
      <nax-progress shape="circle" :percent="25" size="sm"></nax-progress>
      <nax-progress shape="circle" :percent="60"></nax-progress>
      <nax-progress shape="circle" :percent="100" type="success" size="lg"></nax-progress>
    </view>

    <text class="dsec">插槽 useSlot</text>
    <nax-progress :percent="50" use-slot class="mb">
      <text class="stxt">一半啦</text>
    </nax-progress>
    <nax-progress shape="circle" :percent="75" use-slot size="md">
      <text class="stxt">3/4</text>
    </nax-progress>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue'

const dynamicPercent = ref(40)

function inc() {
  dynamicPercent.value = dynamicPercent.value >= 100 ? 100 : dynamicPercent.value + 10
}

function dec() {
  dynamicPercent.value = dynamicPercent.value <= 0 ? 0 : dynamicPercent.value - 10
}

function rand() {
  dynamicPercent.value = Math.round(Math.random() * 100)
}
</script>

<style>
.demo-progress {
  flex-direction: column;
}

.row {
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 12px;
}

.mb {
  margin-bottom: 12px;
}

.stxt {
  font-size: 12px;
  color: var(--nax-color-text, #333333);
}

.dsec {
  font-size: 12px;
  color: var(--nax-color-text-secondary, #666666);
  margin-top: 16px;
  margin-bottom: 8px;
}
</style>
