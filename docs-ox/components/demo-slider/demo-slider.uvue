<template>
  <view class="demo-slider">
    <text class="dsec">基础用法</text>
    <nax-slider v-model="basic"></nax-slider>

    <text class="dsec">尺寸 size</text>
    <nax-slider v-model="sizeSm" size="sm" class="mb"></nax-slider>
    <nax-slider v-model="sizeMd" size="md" class="mb"></nax-slider>
    <nax-slider v-model="sizeLg" size="lg"></nax-slider>

    <text class="dsec">范围 min / max</text>
    <nax-slider v-model="rangeVal" :min="30" :max="80" show-edge-value class="mb"></nax-slider>

    <text class="dsec">步长 step</text>
    <nax-slider v-model="stepVal" :step="10" class="mb"></nax-slider>

    <text class="dsec">小数步长</text>
    <nax-slider v-model="stepFloat" :step="0.1" :start="0" :end="1" class="mb"></nax-slider>

    <text class="dsec">自定义颜色</text>
    <nax-slider v-model="colorVal" active-color="#2080f0" inactive-color="#d6e4ff" block-color="#ffffff" class="mb"></nax-slider>

    <text class="dsec">显示起止值</text>
    <nax-slider v-model="edgeVal" :start="0" :end="100" show-edge-value edge-value-position="bottom" class="mb"></nax-slider>

    <text class="dsec">自定义滑块 useSlot</text>
    <nax-slider v-model="slotVal" use-slot :block-width="28"></nax-slider>

    <text class="dsec">禁用 disabled</text>
    <nax-slider v-model="disabledVal" disabled></nax-slider>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue'

const basic = ref(40)
const sizeSm = ref(30)
const sizeMd = ref(50)
const sizeLg = ref(70)
const rangeVal = ref(50)
const stepVal = ref(40)
const stepFloat = ref(0.5)
const colorVal = ref(60)
const edgeVal = ref(30)
const slotVal = ref(50)
const disabledVal = ref(45)
</script>

