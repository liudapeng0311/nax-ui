ottom\" @click=\"openAt('bottom')\"></nax-button>\n<nax-button label=\"中间 center\" @click=\"openAt('center')\"></nax-button>\n<nax-button label=\"左侧 left\" @click=\"openAt('left')\"></nax-button>\n<nax-button label=\"右侧 right\" @click=\"openAt('right')\"></nax-button>\n\n<nax-picker v-model:show=\"mainShow\" :position=\"mainPosition\">\n    <view class=\"panel\">\n        <text class=\"panel__title\">{{ positionTitle }}</text>\n        <text class=\"panel__desc\">position = {{ mainPosition }}</text>\n        <nax-button type=\"primary\" label=\"完成\" @click=\"mainShow = false\"></nax-button>\n    </view>\n</nax-picker>","attrs":{"lang":"uvue"},"source":{"start":{"line":28,"column":1},"end":{"line":40,"column":1}},"tokens":[{"t":"<nax-button","c":"kw"},{"t":" "},{"t":"type","c":"fn"},{"t":"="},{"t":"\"primary\"","c":"str"},{"t":" "},{"t":"label","c":"fn"},{"t":"="},{"t":"\"底部 bottom\"","c":"str"},{"t":" @"},{"t":"click","c":"fn"},{"t":"="},{"t":"\"openAt('bottom')\"","c":"str"},{"t":"></nax-button>","c":"kw"},{"t":"\n"},{"t":"<nax-button","c":"kw"},{"t":" "},{"t":"label","c":"fn"},{"t":"="},{"t":"\"中间 center\"","c":"str"},{"t":" @"},{"t":"click","c":"fn"},{"t":"="},{"t":"\"openAt('center')\"","c":"str"},{"t":"></nax-button>","c":"kw"},{"t":"\n"},{"t":"<nax-button","c":"kw"},{"t":" "},{"t":"label","c":"fn"},{"t":"="},{"t":"\"左侧 left\"","c":"str"},{"t":" @"},{"t":"click","c":"fn"},{"t":"="},{"t":"\"openAt('left')\"","c":"str"},{"t":"></nax-button>","c":"kw"},{"t":"\n"},{"t":"<nax-button","c":"kw"},{"t":" "},{"t":"label","c":"fn"},{"t":"="},{"t":"\"右侧 right\"","c":"str"},{"t":" @"},{"t":"click","c":"fn"},{"t":"="},{"t":"\"openAt('right')\"","c":"str"},{"t":"></nax-button>","c":"kw"},{"t":"\n\n"},{"t":"<nax-picker","c":"kw"},{"t":" "},{"t":"v-model:show","c":"fn"},{"t":"="},{"t":"\"mainShow\"","c":"str"},{"t":" :"},{"t":"position","c":"fn"},{"t":"="},{"t":"\"mainPosition\"","c":"str"},{"t":">","c":"kw"},{"t":"\n    "},{"t":"<view","c":"kw"},{"t":" "},{"t":"class","c":"fn"