,\n        width: 88\n    },\n    {\n        text: '删除',\n        type: 'error',\n        name: 'delete',\n        width: 72\n    }\n]\n\nfunction groupTitleAt(index: number): string {\n    if (index < 0 || index >= groupTitles.value.length) {\n        return ''\n    }\n    return groupTitles.value[index]\n}\n\nfunction groupLabelAt(index: number): string {\n    if (index < 0 || index >= groupLabels.value.length) {\n        return ''\n    }\n    return groupLabels.value[index]\n}\n\nfunction onGroupClick(e: any) {\n    // 处理点击\n}","attrs":{"lang":"uts"},"source":{"start":{"line":130,"column":1},"end":{"line":166,"column":1}},"tokens":[{"t":"// key / name 用稳定 id，同时只展开一项","c":"com"},{"t":"\n"},{"t":"const","c":"kw"},{"t":" groupIds = "},{"t":"ref","c":"fn"},{"t":"(["},{"t":"'g1'","c":"str"},{"t":", "},{"t":"'g2'","c":"str"},{"t":", "},{"t":"'g3'","c":"str"},{"t":"] "},{"t":"as","c":"kw"},{"t":" "},{"t":"string","c":"kw"},{"t":"[])\n"},{"t":"const","c":"kw"},{"t":" groupTitles = "},{"t":"ref","c":"fn"},{"t":"(["},{"t":"'张三'","c":"str"},{"t":", "},{"t":"'李四'","c":"str"},{"t":", "},{"t":"'王五'","c":"str"},{"t":"] "},{"t":"as","c":"kw"},{"t":" "},{"t":"string","c":"kw"},{"t":"[])\n"},{"t":"const","c":"kw"},{"t":" groupLabels = "},{"t":"ref","c":"fn"},{"t":"(["},{"t":"'今天 10:20'","c":"str"},{"t":", "},{"t":"'昨天'","c":"str"},{"t":", "},{"t":"'周一'","c":"str"},{"t":"] "},{"t":"as","c":"kw"},{"t":" "},{"t":"string","c":"kw"},{"t":"[])\n"},{"t":"const","c":"kw"},{"t":" groupOptions = [\n    {\n        text: "},{"t":"'标为已读'","c":"str"},{"t":",\n        "},{"t":"type","c":"kw"},{"t":": "},{"t":"'primary'","c":"str"},{"t":",\n        name: "},{"t":"'read'","c":"str"},{"t":",\n        width: "},{"t":"88","c":"num"},{"t":"\n    },\n    {\n        text: "},{"t":"'删除'","c":"str"},{"t":",\n        "},{"t":"type","c":"kw"},{"t":": "},{"t":"'error'","c":"str"},{"t":",\n        name: "},{"t":"'delete'","c":"str"},{"t":",\n        width: "},{"t":"72","c":"num"},{"t":"\n    }\n]\n\n"},{"t":"