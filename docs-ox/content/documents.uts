lumn":1},"end":{"line":13,"column":1}}}],"attrs":{"href":"/guide/theme"},"source":{"start":{"line":13,"column":62},"end":{"line":13,"column":62}}},{"type":"text","value":"。","source":{"start":{"line":13,"column":82},"end":{"line":13,"column":82}}}],"source":{"start":{"line":1,"column":1},"end":{"line":0,"column":1}}}],"source":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}}},{"type":"heading","attrs":{"level":2,"id":"代码示例"},"children":[{"type":"text","value":"代码示例","source":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}}}],"source":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}}},{"type":"heading","attrs":{"level":3,"id":"基础用法"},"children":[{"type":"text","value":"基础用法","source":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}}}],"source":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}}},{"type":"demo","value":"<template>\n  <nax-form ref=\"formRef\" :model=\"form\" :rules=\"rules\" label-width=\"80\" error-type=\"message\">\n    <nax-form-item label=\"姓名\" prop=\"name\" required>\n      <nax-input v-model=\"form.name\" border placeholder=\"请输入姓名\"></nax-input>\n    </nax-form-item>\n    <nax-form-item label=\"简介\" prop=\"intro\">\n      <nax-input v-model=\"form.intro\" border placeholder=\"请输入简介\"></nax-input>\n    </nax-form-item>\n  </nax-form>\n  <nax-button type=\"primary\" label=\"提交\" @click=\"onSubmit\"></nax-button>\n</template>\n\n<script setup lang=\"uts\">\nconst formRef = ref(null)\nconst form = reactive({\n  name: '',\n  intro: ''\n} as UTSJSONObject)\n\nconst rules = {\n  name: [\n    { required: true, message: '请输入姓名', trigger: ['blur', 'change'] }\n  ],\n  intro: [\n    { min: 3, max: 50, message: '简介 3-50 字' }\n  ]\n} as UTSJSONObject\n\nfunction onSubmit() {\n  const comp = formRef.value\n  if (comp == null) {\n    return\n  }\n  // 通过 defineExpose 暴露的 validate\n  comp.validate().then((_ok: boolean) => {\n    uni.showToast({ title: '校验通过', icon: 'none' })\n  }).catch((_err: any) => {\n    // 字段错误已展示\n  })\n}\n</script>","attrs":{"name":"demo-form"},"source":{"start":{"line":18,"column":1},"end":{"line":59,"column":1}}},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"小程序端若对象里的函数规则被过滤，请在 ","source":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}}},{"type":"inline-code","value":"onReady","source":{"start":{"line":62,"column":21},"end":{"line":62,"column":21}}},{"type":"text","value":" 中调用 ","source":{"start":{"line":62,"column":30},"end":{"line":62,"column":30}}},{"type":"inline-code","value":"setRules(rules)","source":{"start":{"line":62,"column":35},"end":{"line":62,"column":35}}},{"type":"text","value":"。","source":{"start":{"line":62,"column":52},"end":{"line":62,"column":52}}}],"source":{"start":{"line":1,"column":1},"end":{"line":0,"column":1}}}],"source":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}}},{"type":"heading","attrs":{"level":3,"id":"基础校验"},"children":[{"type":"text","value":"基础校验","source":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}}}],"source":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}}},{"type":"code-block","value":"<nax-form\n    ref=\"formRef\"\n    :model=\"formModel\"\n    :rules=\"rules\"\n    label-position=\"left\"\n    :label-width=\"80\"\n    label-align=\"left\"\n    error-type=\"message\"\n    :border-bottom=\"true\"\n>\n    <nax-form-item label=\"姓名\" prop=\"name\" required>\n        <nax-input v-model=\"name\" placeholder=\"请输入姓名\" :clearable=\"true\" @change=\"syncFormModel\" @blur=\"syncFormModel\"></nax-input>\n    </nax-form-item>\n    <nax-form-item label=\"手机\" prop=\"phone\" required>\n        <nax-input v-model=\"phone\" type=\"number\" placeholder=\"请输入手机号\" :clearable=\"true\" @change=\"syncFormModel\" @blur=\"syncFormModel\"></nax-input>\n    </nax-form-item>\n    <nax-form-item label=\"邮箱\" prop=\"email\">\n        <nax-input v-model=\"email\" placeholder=\"选填，校验邮箱格式\" :clearable=\"true\" @change=\"syncFormModel\" @blur=\"syncFormModel\"></nax-input>\n    </nax-form-item>\n    <nax-form-item label=\"密码\" prop=\"password\" required>\n        <nax-input v-model=\"password\" type=\"password\" placeholder=\"6-20 位\" :clearable=\"true\" @change=\"syncFormModel\" @blur=\"syncFormModel\"></nax-input>\n    </nax-form-item>\n    <nax-form-item label=\"简介\" prop=\"intro\" label-position=\"top\">\n        <nax-textarea v-model=\"intro\" placeholder=\"至少 5 个字\" height=\"80\" @change=\"syncFormModel\" @blur=\"syncFormModel\"></nax-textarea>\n    </nax-form-item>\n    <nax-form-item label=\"性别\" prop=\"sex\" required>\n        <nax-radio-group v-model=\"sex\" @change=\"syncFormModel\">\n            <nax-radio name=\"1\" label=\"男\"></nax-radio>\n            <nax-radio name=\"2\" label=\"女\"></nax-radio>\n        </nax-radio-group>\n    </nax-form-item>\n    <nax-form-item label=\"协议\" prop=\"agree\" required>\n        <nax-checkbox v-model=\"agree\" label=\"我已阅读并同意用户协议\" @change=\"syncFormModel\"></nax-checkbox>\n    </nax-form-item>\n</nax-form>\n\n<nax-button type=\"primary\" label=\"提交校验\" @click=\"onSubmit\"></nax-button>\n<nax-button label=\"重置\" @click=\"onReset\"></nax-button>\n<nax-button variant=\"secondary\" label=\"清空错误\" @click=\"onClear\"></nax-button>","attrs":{"lang":"uvue"},"source":{"start":{"line":65,"column":1},"end":{"line":104,"column":1}},"tokens":[{"t":"<nax-form","c":"kw"},{"t":"\n    "},{"t":"ref","c":"fn"},{"t":"="},{"t":"\"formRef\"","c":"str"},{"t":"\n    :"},{"t":"model","c":"fn"},{"t":"="},{"t":"\"formModel\"","c":"str"},{"t":"\n    :"},{"t":"rules","c":"fn"},{"t":"="},{"t":"\"rules\"","c":"str"},{"t":"\n    "},{"t":"label-position","c":"fn"},{"t":"="},{"t":"\"left\"","c":"str"},{"t":"\n    :"},{"t":"label-width","c":"fn"},{"t":"="},{"t":"\"80\"","c":"str"},{"t":"\n    "},{"t":"label-align","c":"fn"},{"t":"="},{"t":"\"left\"","c":"str"},{"t":"\n    "},{"t":"error-type","c":"fn"},{"t":"="},{"t":"\"message\"","c":"str"},{"t":"\n    :"},{"t":"bor