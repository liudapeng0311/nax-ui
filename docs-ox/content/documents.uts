<nax-upload\n    :file-list=\"fileList\"\n    :max-count=\"6\"\n    name=\"photos\"\n    @after-read=\"onAfterRead\"\n    @delete=\"onDelete\"\n  ></nax-upload>\n</template>\n\n<script setup lang=\"uts\">\n  const fileList = ref([] as any[])\n\n  function onAfterRead(e: UTSJSONObject) {\n    const files = e.getArray('files')\n    // 可在此调用 uni.uploadFile，并更新 fileList 的 status / url\n    const next = [] as any[]\n    var i = 0\n    while (i < fileList.value.length) {\n      next.push(fileList.value[i])\n      i++\n    }\n    if (files != null) {\n      var j = 0\n      while (j < files.length) {\n        next.push(files[j])\n        j++\n      }\n    }\n    fileList.value = next\n  }\n\n  function onDelete(e: UTSJSONObject) {\n    // 组件已 emit update:fileList；也可自行处理\n  }\n</script>","attrs":{"name":"demo-upload"},"source":{"start":{"line":18,"column":1},"end":{"line":54,"column":1}}},{"type":"heading","attrs":{"level":3,"id":"自动上传"},"children":[{"type":"text","value":"自动上传","source":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}}}],"source":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}}},{"type":"paragraph","children":[{"type":"text","value":"开启 ","source":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}}},{"type":"inline-code","value":"autoUpload","source":{"start":{"line":58,"column":4},"end":{"line":58,"column":4}}},{"type":"text","value":" 并配置 ","source":{"start":{"line":58,"column":16},"end":{"line":58,"column":16}}},{"type":"inline-code","value":"action","source":{"start":{"line":58,"column":21},"end":{"line":58,"column":21}}},{"type":"text","value":" 后，组件在 ","source":{"start":{"line":58,"column":29},"end":{"line":58,"column":29}}},{"type":"inline-code","value":"afterRead","source":{"start":{"line":58,"column":36},"end":{"line":58,"column":36}}},{"type":"text","value":" 之后自动调用 ","source":{"start":{"line":58,"column":47},"end":{"line":58,"column":47}}},{"type":"inline-code","value":"uni.uploadFile","source":{"start":{"line"