    }\n    pageLoading.value = true\n    pageError.value = false\n    // 模拟接口：450ms 后追加一页\n    setTimeout(() => {\n        const next = [] as UTSJSONObject[]\n        var n = 0\n        while (n < PAGE_SIZE) {\n            const id = pageSeed\n            pageSeed++\n            next.push(makeItem(id, 'Page'))\n            n++\n        }\n        const merged = [] as UTSJSONObject[]\n        var j = 0\n        const cur = pageList.value\n        while (j < cur.length) {\n            merged.push(cur[j])\n            j++\n        }\n        var k = 0\n        while (k < next.length) {\n            merged.push(next[k])\n            k++\n        }\n        pageList.value = merged\n        pageLoading.value = false\n        if (pageList.value.length >= PAGE_MAX) {\n            pageFinished.value = true\n        }\n    }, 450)\n}\n\nfunction onPageErrorClick() {\n    pageError.value = false\n}","attrs":{"lang":"uts"},"source":{"start":{"line":194,"column":1},"end":{"line":242,"column":1}},"tokens":[{"t":"const","c":"kw"},{"t":" pageList = "},{"t":"ref","c":"fn"},{"t":"([] "},{"t":"as","c":"kw"},{"t":" "},{"t":"UTSJSONObject","c":"type"},{"t":"[])\n"},{"t":"const","c":"kw"},{"t":" pageLoading = "},{"t":"ref","c":"fn"},{"t":"("},{"t":"false","c":"kw"},{"t":")\n"},{"t":"const","c":"kw"},{"t":" pageFinished = "},{"t":"ref","c":"fn"},{"t":"("},{"t":"false","c":"kw"},{"t":")\n"},{"t":"const","c":"kw"},{"t":" pageError = "},{"t":"ref","c":"fn"},{"t":"("},{"t":"false","c":"kw"},{"t":")\n"},{"t":"const","c":"kw"},{"t":" "},{"t":"PAGE_SIZE","c":"type"},{"t":" = "},{"t":"30","c":"num"},{"t":"\n"},{"t":"const","c":"kw"},{"t":" "},{"t":"PAGE_MAX","c":"type"},{"t":" = "},{"t":"300","c":"num"},{"t":"\n"},{"t":"let","c":"kw"},{"t":" pageSeed = "},{"t":"0","c":"num"},{"t":"\n\n"},{"t":"// 初始自动 load · 每次滚到底部 +30 · 追加后保持当前位置","c":"com"},{"t":"\n"},{"t":"function","c":"kw"},{"t":" "},{"t":"onPageLoad","c":"fn"},{"t":"() {\n    "},{"t":"if","c":"kw"},{"t":" (pageLoading.value || pageFinished.