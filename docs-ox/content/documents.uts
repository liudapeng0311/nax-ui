ce":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}}},{"type":"table-row","children":[{"type":"table-cell","attrs":{"align":"left"},"children":[{"type":"text","value":"三态切换","source":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}}}],"source":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}}},{"type":"table-cell","attrs":{"align":"left"},"children":[{"type":"text","value":"跟随系统 / 浅色 / 深色，随意来回切","source":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}}}],"source":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}}}],"source":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}}},{"type":"table-row","children":[{"type":"table-cell","attrs":{"align":"left"},"children":[{"type":"text","value":"全端一致","source":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}}}],"source":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}}},{"type":"table-cell","attrs":{"align":"left"},"children":[{"type":"text","value":"鸿蒙、Android、iOS、Web、小程序都能用","source":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}}}],"source":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}}}],"source":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}}}],"source":{"start":{"line":7,"column":1},"end":{"line":11,"column":1}}},{"type":"heading","attrs":{"level":2,"id":"先完成主题基础l1"},"children":[{"type":"text","value":"先完成主题基础（L1）","source":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}}}],"source":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}}},{"type":"paragraph","children":[{"type":"text","value":"暗黑模式建立在 CSS 变量主题之上，请先按","source":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}}},{"type":"link","children":[{"type":"text","value":"主题接入","source":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}}}],"attrs":{"href":"./theme"},"source":{"start":{"line":16,"column":23},"end":{"line":16,"column":23}}},{"type":"text","value":"完成 L1：","source":{"start":{"line":16,"column":38},"end":{"line":16,"column":38}}}],"source":{"start":{"line":16,"column":1},"end":{"line":15,"column":1}}},{"type":"list","attrs":{"ordered":true},"children":[{"type":"list-item","children":[{"type":"list-item-text","children":[{"type":"inline-code","value":"App.uvue","source":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}}},{"type":"text","value":" 引入 ","source":{"start":{"line":18,"column":11},"end":{"line":18,"column":11}}},{"type":"inline-code","value":"default.css","source":{"start":{"line":18,"column":15},"end":{"line":18,"column":15}}},{"type":"text","value":" 和 ","source":{"start":{"line":18,"column":28},"end":{"line":18,"column":28}}},{"type":"inline-code","value":"dark.css","source":{"start":{"line":18,"column":31},"end":{"line":18,"column":31}}}],"source":{"start":{"line":1,"column":1},"end":{"line":0,"column":1}}}],"source":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}}},{"type":"list-item","children":[{"type":"list-item-text","children":[{"type":"text","value":"应用根节点挂载 ","source":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}}},{"type":"inline-code","value":"class=\"nax-theme\"","source":{"start":{"line":19,"column":9},"end":{"line":19,"column":9}}}],"source":{"start":{"line":1,"column":1},"end":{"line":0,"column":1}}}],"source":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}}}],"source":{"start":{"line":18,"column":1},"end":{"line":19,"column":1}}},{"type":"heading","attrs":{"level":2,"id":"核心原理一句话版"},"children":[{"type":"text","value":"核心原理（一句话版）","source":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}}}],"source":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}}},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"用一个","source":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}}},{"type":"strong","children":[{"type":"text","value":"全局状态","source":{"start":{"line":23,"column":6},"end":{"line":23,"column":6}}}]},{"type":"text","value":"记录\"当前是不是暗黑\"，页面根节点的 ","source":{"start":{"line":23,"column":12},"end":{"line":23,"column":12}}},{"type":"inline-code","value":"nax-theme-dark","source":{"start":{"line":23,"column":31},"end":{"line":23,"column":31}}},{"type":"text","value":" class 由它驱动。 系统主题变了 → 全局状态更新 → 所有页面自动换肤。","source":{"start":{"line":23,"column":47},"end":{"line":23,"column":47}}}],"source":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}}}],"source":{"start":{"line":23,"column":1},"end":{"line":24,"column":1}}},{"type":"paragraph","children":[{"type":"text","value":"全局状态用 Vue 的 ","source":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}}},{"type":"inline-code","value":"ref","source":{"start":{"line":26,"column":13},"end":{"line":26,"column":13}}},{"type":"text","value":" 实现（模块级共享），","source":{"start":{"line":26,"column":18},"end":{"line":26,"column":18}}},{"type":"strong","children":[{"type":"text","value":"不需要引入 Pinia 等状态库","source":{"start":{"line":26,"column":31},"end":{"line":26,"column":31}}}]},{"type":"text","value":"——uni-app x 蒸汽模式也不建议引入。","source":{"start":{"line":26,"column":49},"end":{"line":26,"column":49}}}],"source":{"start":{"line":26,"column":1},"end":{"line":25,"column":1}}},{"type":"heading","attrs":{"level":2,"id":"第-1-步创建全局主题状态模块"},"children":[{"type":"text","value":"第 1 步：创建全局主题状态模块","source":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}}}],"source":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}}},{"type":"paragraph","children":[{"type":"text","value":"新建 ","source":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}}},{"type":"inline-code","value":"common/theme-manager.uts","source":{"start":{"line":30,"column":4},"end":{"line":30,"column":4}}},{"type":"text","value":"，内容如下（可直接复制）：","source":{"start":{"line":30,"column":30},"end":{"line":30,"column":30}}}],"source":{"start":{"line":30,"column":1},"end":{"line":29,"column":1}}},{"type":"code-block","value":"/**\n * 全局主题状态（三态）：followSystem 跟随系统 / light 浅色 / dark 深色\n * 手动选择后不再跟随系统；切回 followSystem 恢复联动。\n */\nconst STORAGE_KEY = 'app_theme_mode'\n\nvar themeMode = 'followSystem'\nvar systemDark = false\nvar themeInited = false\n\n/** 页面共享的暗黑状态：页面 computed 依赖它即可自动换肤 */\nexport const darkRef = ref(false)\n\nfunction syncDark() {\n    darkRef.value = isDark()\n}\n\nfunction readStorage(): string {\n    const raw = uni.getStorageSync(STORAGE_KEY)\n    if (raw != null) {\n        const s = '' + raw\n        if (s == 'followSystem' || s == 'light' || s == 'dark') {\n            return s\n        }\n    }\n    return 'followSystem'\n}\n\nfunction writeStorage(mode: string) {\n    uni.setStorageSync(STORAGE_KEY, mode)\n}\n\n/** 当前系统主题是不是暗色（各平台读取方式不同，见文末\"平台差异\"） */\nfunction readSystemDark(): boolean {\n    // 鸿蒙：uni API 拿不到系统主题，用原生能力（无需 import）\n    // \u0023ifdef APP-HARMONY\n    const osTheme = UTSHarmony.getOsTheme()\n    if ((osTheme as string) == 'dark') {\n        return true\n    } else if ((osTheme as string) == 'light') {\n        return false\n    }\n    // \u0023endif\n    // Android：uni API 没有可用字段，用原生能力（无需 import）\n    // 注意：蒸汽模式（Vapor）下 Android 的 uvue 页面里 UTSAndroid 不可用，需改用下方 osTheme 字段\n    // \u0023ifdef APP-ANDROID\n    // \u0023ifndef VUE3-VAPOR\n    const osThemeAndroid = UTSAndroid.getOsTheme()\n    if ((osThemeAndroid as string) == 'dark') {\n        return true\n    } else if ((osThemeAndroid as string) == 'light') {\n        return false\n    }\n    // \u0023endif\n    // \u0023endif\n    // iOS / Web / 小程序：osTheme 是系统主题字段（全端可用）\n    const info = uni.getSystemInfoSync()\n    if (info.osTheme == 'dark') {\n        return true\n    }\n    return false\n}\n\n/** 切换 App 原生层主题（避免页面转场闪白/闪黑） */\nfunction applyAppTheme(mode: string) {\n    // \u0023ifdef APP-ANDROID || APP-IOS || APP-HARMONY\n    var theme = 'light'\n    if (mode == 'dark') {\n        theme = 'dark'\n    } else if (mode == 'followSystem') {\n        theme = 'auto'\n    }\n    try {\n        uni.setAppTheme({\n            theme: theme as 'light' | 'dark' | 'auto'\n        })\n    } catch (e : any) {\n        // 低版本不支持时保持 manifest 默认配置即可\n    }\n    // \u0023endif\n}\n\n/** 应用启动时调用一次：读取存档 + 注册系统主题监听 */\nexport function initTheme() {\n    if (themeInited) {\n        return\n    }\n    themeMode = readStorage()\n    themeInited = true\n    systemDark = readSystemDark()\n    applyAppTheme(themeMode)\n    syncDark()\n\n    // Android：没有 onOsThemeChange，用 onAppThemeChange 当\"触发信号\"，\n    // 系统主题真值仍用原生 API 读取\n    // \u0023ifdef APP-ANDROID\n    try {\n        uni.onAppThemeChange((res: AppThemeChangeResult) => {\n            // 蒸汽模式：UTSAndroid 不可用，回调 appTheme（4.19+ 仅返回 light/dark）即真实主题\n            // \u0023ifndef VUE3-VAPOR\n            const osTheme = UTSAndroid.getOsTheme()\n            systemDark = (osTheme as string) == 'dark'\n            // \u0023endif\n            // \u0023ifdef VUE3-VAPOR\n            systemDark = res.appTheme == 'dark'\n            // \u0023endif\n            if (themeMode == 'followSystem') {\n                applyAppTheme('followSystem')\n                syncDark()\n            }\n        })\n    } catch (e : any) {\n    }\n    // \u0023endif\n\n    // iOS / 鸿蒙：onOsThemeChange 监听系统主题切换\n    // \u0023ifdef APP-IOS || APP-HARMONY\n    try {\n        uni.onOsThemeChange((res: OnOsThemeChangeCallbackResult) => {\n            // 鸿蒙回调不带主题值，用原生 API；iOS 回调可能为空，用 osTheme 兜底\n            // \u0023ifdef APP-HARMONY\n            const osTheme = UTSHarmony.getOsTheme()\n            systemDark = (osTheme as string) == 'dark'\n            // \u0023endif\n            // \u0023ifndef APP-HARMONY\n            if (res.theme == null || res.theme.length == 0) {\n                const info = uni.getSystemInfoSync()\n                systemDark = info.osTheme == 'dark'\n            } else {\n                systemDark = res.theme == 'dark'\n            }\n            // \u0023endif\n            if (themeMode == 'followSystem') {\n                applyAppTheme('followSystem')\n                syncDark()\n            }\n        })\n    } catch (e : any) {\n    }\n    // \u0023endif\n}\n\n/** 当前三态：followSystem / light / dark */\nexport function getThemeMode(): string {\n    if (!themeInited) {\n        initTheme()\n    }\n    return themeMode\n}\n\n/** 设置三态 */\nexport function setThemeMode(mode: string) {\n    themeMode = mode\n    themeInited = true\n    writeStorage(mode)\n    applyAppTheme(mode)\n    syncDark()\n}\n\n/** 当前实际生效的暗黑状态（followSystem 时取系统主题） */\nexport function isDark(): boolean {\n    if (!themeInited) {\n        initTheme()\n    }\n    if (themeMode == 'followSystem') {\n        return systemDark\n    }\n    return themeMode == 'dark'\n}","attrs":{"lang":"uts"},"source":{"start":{"line":32,"column":1},"end":{"line":201,"column":1}},"tokens":[{"t":"/**\n * 全局主题状态（三态）：followSystem 跟随系统 / light 浅色 / dark 深色\n * 手动选择后不再跟随系统；切回 followSystem 恢复联动。\n */","c":"com"},{"t":"\n"},{"t":"const","c":"kw"},{"t":" "},{"t":"STORAGE_KEY","c":"type"},{"t":" = "},{"t":"'app_theme_mode'","c":"str"},{"t":"\n\n"},{"t":"var","c":"kw"},{"t":" themeMode = "},{"t":"'followSystem'","c":"str"},{"t":"\n"},{"t":"var","c":"kw"},{"t":" systemDark = "},{"t":"false","c":"kw"},{"t":"\n"},{"t":"var","c":"kw"},{"t":" themeInited = "},{"t":"false","c":"kw"},{"t":"\n\n"},{"t":"/** 页面共享的暗黑状态：页面 computed 依赖它即可自动换肤 */","c":"com"},{"t":"\n"},{"t":"export","c":"kw"},{"t":" "},{"t":"const","c":"kw"},{"t":" darkRef = "},{"t":"ref","c":"fn"},{"t":"("},{"t":"false","c":"kw"},{"t":")\n\n"},{"t":"function","c":"kw"},{"t":" "},{"t":"syncDark","c":"fn"},{"t":"() {\n    darkRef.value = "},{"t":"isDark","c":"fn"},{"t":"()\n}\n\n"},{"t":"function","c":"kw"},{"t":" "},{"t":"readStorage","c":"fn"},{"t":"(): "},{"t":"string","c":"kw"},{"t":" {\n    "},{"t":"const","c":"kw"},{"t":" raw = uni."},{"t":"getStorageSync","c":"fn"},{"t":"("},{"t":"STORAGE_KEY","c":"type"},{"t":")\n    "},{"t":"if","c":"kw"},{"t":" (raw != "},{"t":"null","c":"kw"},{"t":") {\n        "},{"t":"const","c":"kw"},{"t":" s = "},{"t":"''","c":"str"},{"t":" + raw\n        "},{"t":"if","c":"kw"},{"t":" (s == "},{"t":"'followSystem'","c":"str"},{"t":" || s == "},{"t":"'light'","c":"str"},{"t":" || s == "},{"t":"'dark'","c":"str"},{"t":") {\n            "},{"t":"return","c":"kw"},{"t":" s\n        }\n    }\n    "},{"t":"return","c":"kw"},{"t":" "},{"t":"'followSystem'","c":"str"},{"t":"\n}\n\n"},{"t":"function","c":"kw"},{"t":" "},{"t":"writeStorage","c":"fn"},{"t":"(mode: "},{"t":"string","c":"kw"},{"t":") {\n    uni."},{"t":"setStorageSync","c":"fn"},{"t":"("},{"t":"STORAGE_KEY","c":"type"},{"t":", mode)\n}\n\n"},{"t":"/** 当前系统主题是不是暗色（各平台读取方式不同，见文末\"平台差异\"） */","c":"com"},{"t":"\n"},{"t":"function","c":"kw"},{"t":" "},{"t":"readSystemDark","c":"fn"},{"t":"(): "},{"t":"boolean","c":"kw"},{"t":" {\n    "},{"t":"// 鸿蒙：uni API 拿不到系统主题，用原生能力（无需 import）","c":"com"},{"t":"\n    "},{"t":"// \u0023ifdef APP-HARMONY","c":"com"},{"t":"\n    "},{"t":"const","c":"kw"},{"t":" osTheme = "},{"t":"UTSHarmony","c":"type"},{"t":"."},{"t":"getOsTheme","c":"fn"},{"t":"()\n    "},{"t":"if","c":"kw"},{"t":" ((osTheme "},{"t":"as","c":"kw"},{"t":" "},{"t":"string","c":"kw"},{"t":") == "},{"t":"'dark'","c":"str"},{"t":") {\n        "},{"t":"return","c":"kw"},{"t":" "},{"t":"true","c":"kw"},{"t":"\n    } "},{"t":"else","c":"kw"},{"t":" "},{"t":"if","c":"kw"},{"t":" ((osTheme "},{"t":"as","c":"kw"},{"t":" "},{"t":"string","c":"kw"},{"t":") == "},{"t":"'light'","c":"str"},{"t":") {\n        "},{"t":"return","c":"kw"},{"t":" "},{"t":"false","c":"kw"},{"t":"\n    }\n    "},{"t":"// \u0023endif","c":"com"},{"t":"\n    "},{"t":"// Android：uni API 没有可用字段，用原生能力（无需 import）","c":"com"},{"t":"\n    "},{"t":"// 注意：蒸汽模式（Vapor）下 Android 的 uvue 页面里 UTSAndroid 不可用，需改用下方 osTheme 字段","c":"com"},{"t":"\n    "},{"t":"// \u0023ifdef APP-ANDROID","c":"com"},{"t":"\n    "},{"t":"// \u0023ifndef VUE3-VAPOR","c":"com"},{"t":"\n    "},{"t":"const","c":"kw"},{"t":" osThemeAndroid = "},{"t":"UTSAndroid","c":"type"},{"t":"."},{"t":"g