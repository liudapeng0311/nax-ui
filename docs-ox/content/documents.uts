":"下拉刷新","source":{"start":{"line":245,"column":1},"end":{"line":245,"column":1}}}],"source":{"start":{"line":245,"column":1},"end":{"line":245,"column":1}}},{"type":"code-block","value":"<nax-virtual-list\n    height=\"320px\"\n    :list=\"rfList\"\n    :item-height=\"48\"\n    :buffer=\"6\"\n    key-field=\"id\"\n    :enable-refresh=\"true\"\n    :refreshing=\"rfRefreshing\"\n    :loading=\"rfLoading\"\n    :finished=\"rfFinished\"\n    @refresh=\"onRfRefresh\"\n    @update:refreshing=\"onRfRefreshing\"\n    @load=\"onRfLoad\"\n>\n    <template #header>\n        <view class=\"list-header\">\n            <text>批次 #{{ rfBatch }} · {{ rfList.length }} 条</text>\n        </view>\n    </template>\n    <template #default=\"{ item, index }\">\n        <nax-cell :title=\"readTitle(item)\" :value=\"indexLabel(index)\"></nax-cell>\n    </template>\n</nax-virtual-list>","attrs":{"lang":"uvue"},"source":{"start":{"line":246,"column":1},"end":{"line":269,"column":1}},"tokens":[{"t":"<nax-virtual-list","c":"kw"},{"t":"\n    "},{"t":"height","c":"fn"},{"t":"="},{"t":"\"320px\"","c":"str"},{"t":"\n    :"},{"t":"list","c":"fn"},{"t":"="},{"t":"\"rfList\"","c":"str"},{"t":"\n    :"},{"t":"item-height","c":"fn"},{"t":"="},{"t":"\"48\"","c":"str"},{"t":"\n    :"},{"t":"buffer","c":"fn"},{"t":"="},{"t":"\"6\"","c":"str"},{"t":"\n    "},{"t":"key-field","c":"fn"},{"t":"="},{"t":"\"id\"","c":"str"},{"t":"\n    :"},{"t":"enable-refresh","c":"fn"},{"t":"="},{"t":"\"true\"","c":"str"},{"t":"\n    :"},{"t":"refreshing","c":"fn"},{"t":"="},{"t":"\"rfRefreshing\"","c":"str"},{"t":"\n    :"},{"t":"loading","c":"fn"},{"t":"="},{"t":"\"rfLoading\"","c":"str"},{"t":"\n    :"},{"t":"finished","c":"fn"},{"t":"="},{"t":"\"rfFinished\"","c":"str"},{"t":"\n    @"},{"t":"refresh","c":"fn"},{"t":"="},{"t":"\"onRfRefresh\"","c":"str"},{"t":"\n    @"},{"t":"update:refreshing","c":"fn"},{"t":"="},{"t":"\"onRfRefreshing\"","c":"str"},{"t":"\n    @"},{"t":"load","c":"fn"},{"t":"="},{"t":"\"onRfLoad\"","c":"st