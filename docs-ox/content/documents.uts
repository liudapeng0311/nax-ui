source":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}}}],"source":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}}},{"type":"code-block","value":"<nax-list\n    :key=\"key\"\n    height=\"360px\"\n    :loading=\"loading\"\n    :finished=\"finished\"\n    :error=\"error\"\n    :empty=\"empty\"\n    @load=\"onLoad\"\n    @click-error=\"resetList\"\n>\n    <template #header>\n        <text class=\"list-header\">已加载 {{ list.length }} 条</text>\n    </template>\n    <nax-cell\n        v-for=\"(title, index) in list\"\n        :key=\"index\"\n        :title=\"title\"\n        :value=\"'' + (index + 1)\"\n        is-link\n    ></nax-cell>\n</nax-list>\n<nax-button size=\"sm\" label=\"重置列表\" @click=\"resetList\"></nax-button>","attrs":{"lang":"uvue"},"source":{"start":{"line":72,"column":1},"end":{"line":94,"column":1}},"tokens":[{"t":"<nax-list","c":"kw"},{"t":"\n    :"},{"t":"key","c":"fn"},{"t":"="},{"t":"\"key\"","c":"str"},{"t":"\n    "},{"t":"height","c":"fn"},{"t":"="},{"t":"\"360px\"","c":"str"},{"t":"\n    :"},{"t":"loading","c":"fn"},{"t":"="},{"t":"\"loading\"","c":"str"},{"t":"\n    :"},{"t":"finished","c":"fn"},{"t":"="},{"t":"\"finished\"","c":"str"},{"t":"\n    :"},{"t":"error","c":"fn"},{"t":"="},{"t":"\"error\"","c":"str"},{"t":"\n    :"},{"t":"empty","c":"fn"},{"t":"="},{"t":"\"empty\"","c":"str"},{"t":"\n    @"},{"t":"load","c":"fn"},{"t":"="},{"t":"\"onLoad\"","c":"str"},{"t":"\n    @"},{"t":"click-error","c":"fn"},{"t":"="},{"t":"\"resetList\"","c":"str"},{"t":"\n"},{"t":">","c":"kw"},{"t":"\n    "},{"t":"<template","c":"kw"},{"t":" #"},{"t":"header","c":"fn"},{"t":">","c":"kw"},{"t":"\n        "},{"t":"<text","c":"kw"},{"t":" "},{"t":"class","c":"fn"},{"t":"="},{"t":"\"list-header\"","c":"str"},{"t":">","c":"kw"},{"t":"已加载 {{ list.length }} 条"},{"t":"</text>","c":"kw"},{"t":"\n    "},{"t":"</template>","c":"kw"},{"t":"\n    "},{"t":"<nax-cell","c":"kw"},{"t":"\n        "},{"t":"v-for","c":"fn"},{"t":"="},{"t":"\"(title, index