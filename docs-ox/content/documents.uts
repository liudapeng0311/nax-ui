\n\nfunction onVisibleChange(e : UTSJSONObject) {\n    // 可视窗口变化：e.start / e.end\n}\n\nfunction onRowClick(e : UTSJSONObject) {\n    // 点击行：e.index\n}\n\nfunction readTitle(item : any | null) : string {\n    if (item == null) {\n        return ''\n    }\n    const t = (item as UTSJSONObject)['title']\n    return t != null ? ('' + t) : ''\n}\n\nfunction readSub(item : any | null) : string {\n    if (item == null) {\n        return ''\n    }\n    const t = (item as UTSJSONObject)['sub']\n    return t != null ? ('' + t) : ''\n}\n\nfunction indexLabel(index : any | null) : string {\n    const i = index as number\n    return (i + 1).toString()\n}","attrs":{"lang":"uts"},"source":{"start":{"line":106,"column":1},"end":{"line":161,"column":1}},"tokens":[{"t":"// 简要 mock：5000 条固定行高数据","c":"com"},{"t":"\n"},{"t":"function","c":"kw"},{"t":" "},{"t":"makeItem","c":"fn"},{"t":"(id : "},{"t":"number","c":"kw"},{"t":", prefix : "},{"t":"string","c":"kw"},{"t":") : "},{"t":"UTSJSONObject","c":"type"},{"t":" {\n    "},{"t":"return","c":"kw"},{"t":" {\n        id: id,\n        title: prefix + "},{"t":"' 行 #'","c":"str"},{"t":" + id."},{"t":"toString","c":"fn"},{"t":"(),\n        sub: "},{"t":"'固定行高虚拟渲染 · id='","c":"str"},{"t":" + id."},{"t":"toString","c":"fn"},{"t":"()\n    } "},{"t":"as","c":"kw"},{"t":" "},{"t":"UTSJSONObject","c":"type"},{"t":"\n}\n\n"},{"t":"const","c":"kw"},{"t":" basicList = "},{"t":"ref","c":"fn"},{"t":"([] "},{"t":"as","c":"kw"},{"t":" "},{"t":"UTSJSONObject","c":"type"},{"t":"[])\n"},{"t":"function","c":"kw"},{"t":" "},{"t":"buildBasic","c":"fn"},{"t":"(count : "},{"t":"number","c":"kw"},{"t":") {\n    "},{"t":"const","c":"kw"},{"t":" rows = [] "},{"t":"as","c":"kw"},{"t":" "},{"t":"UTSJSONObject","c":"type"},{"t":"[]\n    "},{"t":"var","c":"kw"},{"t":" i = "},{"t":"0","c":"num"},{"t":"\n    "},{"t":"while","c":"kw"},{"t":" (i < count) {\n        rows."},{"t":"push","c":"fn"},{"t":"("},{"t":"makeItem","c":"fn"},{"t":"(i, "},{"t":"'Item'","c":"str"},{"t":")