","level":2}],"lastUpdated":"2026-09-06T01:55:47.373Z"},{"id":"guide","path":"/guide/","source":"guide/index.md","title":"快速开始","headings":[{"id":"快速开始","text":"快速开始","level":1},{"id":"环境要求","text":"环境要求","level":2},{"id":"安装组件","text":"安装组件","level":2},{"id":"安装主题包推荐","text":"安装主题包（推荐）","level":2},{"id":"让-ai-帮你写页面","text":"让 AI 帮你写页面","level":2}],"lastUpdated":"2026-09-06T01:55:47.377Z"},{"id":"guide-ai-skill","path":"/guide/ai-skill","source":"guide/ai-skill.md","title":"AI 技能包（Agent Skill）","headings":[{"id":"ai-技能包agent-skill","text":"AI 技能包（Agent Skill）","level":1},{"id":"一键安装推荐","text":"一键安装（推荐）","level":2},{"id":"手动安装","text":"手动安装","level":2},{"id":"技能包含什么","text":"技能包含什么","level":2},{"id":"验证安装","text":"验证安装","level":2},{"id":"相关链接","text":"相关链接","level":2}],"lastUpdated":"2026-09-06T01:55:47.374Z"},{"id":"guide-dark-mode","path":"/guide/dark-mode","source":"guide/dark-mode.md","title":"暗黑模式接入","headings":[{"id":"暗黑模式接入","text":"暗黑模式接入","level":1},{"id":"功能","text":"功能","level":2},{"id":"先完成主题基础l1","text":"先完成主题基础（L1）","level":2},{"id":"核心原理一句话版","text":"核心原理（一句话版）","level":2},{"id":"第-1-步创建全局主题状态模块","text":"第 1 步：创建全局主题状态模块","level":2},{"id":"第-2-步app.uvue-启动时初始化","text":"第 2 步：App.uvue 启动时初始化","level":2},{"id":"第-3-步页面接入每个页面只需-2-行","text":"第 3 步：页面接入（每个页面只需 2 行）","level":2},{"id":"第-4-步可选设置页加三态选择","text":"第 4 步（可选）：设置页加三态选择","level":2},{"id":"平台差异为什么这么写","text":"平台差异（为什么这么写）","level":2},{"id":"常见问题","text":"常见问题","level":2}],"lastUpdated":"2026-09-06T01:55:47.376Z"},{"id":"guide-intro","path":"/guide/intro","source":"guide/intro.md","title":"介绍","headings":[{"id":"介绍","text":"介绍","level":1},{"id":"由来","text":"由来","level":2},{"id":"从-uvue-出发","text":"从 uvue 出发","level":3},{"id":"遵循蒸汽模式","text":"遵循蒸汽模式","level":3},{"id":"样式可控可扩展","text":"样式可控可扩展","level":3},{"id":"特性","text":"特性","level":2},{"id":"组件齐全","text":"组件齐全","level":3},{"id":"零配置接入","text":"零配置接入","level":3},{"id":"多端运行","text":"多端运行","level":3},{"id":"主题-token","text":"主题 token","level":3},{"id":"双模式反馈","text":"双模式反馈","level":3},{"id":"端差异显式处理","text":"端差异显式处理","level":3},{"id":"平台支持","text":"平台支持","level":2},{"id":"与其它框架的区别","text":"与其它框架的区别","level":2},{"id":"相关地址","text":"相关地址","level":2},{"id":"交流群","text":"交流群","level":2},{"id":"赞赏支持","text":"赞赏支持","level":2},{"id":"下一步","text":"下一步","level":2}],"lastUpdated":"2026-09-06T06:56:49.398Z"},{"id":"guide-theme","path":"/guide/theme","source":"guide/theme.md","title":"主题接入","headings":[{"id":"主题接入","text":"主题接入","level":1},{"id":"接入分档","text":"接入分档","level":2},{"id":"安装","text":"安装","level":2},{"id":"l0默认色","text":"L0：默认色","level":2},{"id":"l1启动配置","text":"L1：启动配置","level":2},{"id":"1.-app-全局引入主题","text":"1. App 全局引入主题","level":3},{"id":"2.-挂载主题-class","text":"2. 挂载主题 class","level":3},{"id":"l2运行时切换","text":"L2：运行时切换","level":2},{"id":"dialogpage-主题同步","text":"dialogPage 主题同步","level":2},{"id":"变量清单与自定义","text":"变量清单与自定义","level":2}],"lastUpdated":"2026-09-06T01:55:47.379Z"}]
