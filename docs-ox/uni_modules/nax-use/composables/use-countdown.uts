/**
 * useCountdown — 倒计时组合式函数（无头：只提供状态与控制方法，UI 完全交给业务）
 *
 * 用法（必须在 setup 内同步调用）：
 * ```
 * import { useCountdown, NaxCountdownOptions } from '@/uni_modules/nax-use/composables/use-countdown.uts'
 *
 * const opts : NaxCountdownOptions = { time: 5 * 60 * 1000 }
 * const countdown = useCountdown(opts)
 * // 模板直接读标量：countdown.days / hours / minutes / seconds / total / running / finished
 * // 控制：countdown.start() / countdown.pause() / countdown.reset(10000)
 * ```
 *
 * 实现说明：
 * - 时间基于 Date.now() 与目标时刻差值计算，不随 setInterval 漂移
 * - 状态全部为标量 getter（内部是单个 ref），uts 响应式与 uvue 模板渲染友好
 * - 组件内使用时卸载自动清理定时器；页面级（无组件实例）使用需自行调 dispose()
 */

import { ref, onUnmounted, getCurrentInstance, Ref } from 'vue'

export type NaxCountdownOptions = {
	/** 总时长（毫秒），必须 > 0 */
	time : number,
	/** 毫秒级渲染（milliseconds 粒度跳动）；默认 false */
	millisecond ?: boolean,
	/** 创建后立即开始；默认 true */
	autostart ?: boolean,
	/** 更新间隔（毫秒）；默认 1000（millisecond 为 true 时默认 33） */
	interval ?: number,
	/** 倒计时结束回调 */
	onFinish ?: () => void
}

export class NaxCountdownState {
	private _totalTime : number
	private _remain : Ref<number>
	private _running : Ref<boolean>
	private _endTime : number
	private _timerId : number
	private _interval : number
	private _onFinish : (() => void) | null
	private _started : boolean

	constructor(options : NaxCountdownOptions) {
		this._totalTime = options.time > 0 ? options.time : 0
		this._remain = ref<number>(this._totalTime)
		this._running = ref<boolean>(false)
		this._endTime = 0
		this._timerId = -1
		this._started = false

		const itv = options.interval
		if (itv != null) {
			this._interval = itv > 0 ? itv : 1000
		} else {
			const ms = options.millisecond
			this._interval = ms == true ? 33 : 1000
		}

		const cb = options.onFinish
		if (cb != null) {
			this._onFinish = cb
		} else {
			this._onFinish = null
		}
	}

	/** 剩余总毫秒 */
	get total() : number {
		return this._remain.value
	}
	/**
	 * 整秒显示基准：向上取整（剩余 9.2s 记 10s）。
	 * 渲染间隔 1000ms 且定时器触发必然晚于理论边界若干毫秒，
	 * floor 会导致首个数字占满两秒、中间秒被跳过（10 → 8）；ceil 保证每个数字恰好显示 1 秒。
	 */
	private _displaySeconds() : number {
		const r = this._remain.value
		if (r <= 0) {
			return 0
		}
		return Math.ceil(r / 1000)
	}
	get days() : number {
		return Math.floor(this._displaySeconds() / 86400)
	}
	get hours() : number {
		return Math.floor((this._displaySeconds() % 86400) / 3600)
	}
	get minutes() : number {
		return Math.floor((this._displaySeconds() % 3600) / 60)
	}
	get seconds() : number {
		return this._displaySeconds() % 60
	}
	/** 当前秒内的原始毫秒（0-999，向上取整显示不参与；毫秒级 UI 请与 total 配 floor 使用） */
	get milliseconds() : number {
		return this._remain.value % 1000
	}
	get running() : boolean {
		return this._running.value
	}
	get finished() : boolean {
		return this._remain.value <= 0
	}
	/** 是否已开始过（start 后为 true，reset 后回到 false）；区分"未开始"与"已暂停" */
	get started() : boolean {
		return this._started
	}
	/** 语义状态：idle（未开始）| running（进行中）| paused（已暂停）| finished（已结束） */
	get status() : string {
		if (this._remain.value <= 0) {
			return 'finished'
		}
		if (this._running.value) {
			return 'running'
		}
		return this._started ? 'paused' : 'idle'
	}

	/** 从当前剩余时间继续；已结束后调用将重新开始 */
	start() : void {
		if (this._running.value) {
			return
		}
		let base = this._remain.value
		if (base <= 0) {
			base = this._totalTime
		}
		if (base <= 0) {
			return
		}
		this._endTime = Date.now() + base
		this._remain.value = base
		this._running.value = true
		this._started = true
		this._startTimer()
	}

	/** 暂停并保留剩余时间 */
	pause() : void {
		if (!this._running.value) {
			return
		}
		this._stopTimer()
		this._running.value = false
		let remain = this._endTime - Date.now()
		if (remain < 0) {
			remain = 0
		}
		this._remain.value = remain
	}

	/** 停止并回到 time；可传新总时长（毫秒）。重置后保持停止，需再调 start */
	reset(time : number = -1) : void {
		this._stopTimer()
		this._running.value = false
		this._started = false
		if (time > 0) {
			this._totalTime = time
		}
		this._endTime = 0
		this._remain.value = this._totalTime
	}

	/** 停止计时并释放定时器；组件内使用已由 useCountdown 自动调用 */
	dispose() : void {
		this._stopTimer()
		this._running.value = false
	}

	private _startTimer() : void {
		this._stopTimer()
		this._timerId = setInterval(() => {
			this._render()
		}, this._interval)
	}

	private _stopTimer() : void {
		if (this._timerId != -1) {
			clearInterval(this._timerId)
			this._timerId = -1
		}
	}

	private _render() : void {
		const remain = this._endTime - Date.now()
		if (remain <= 0) {
			this._stopTimer()
			this._running.value = false
			this._remain.value = 0
			const cb = this._onFinish
			if (cb != null) {
				cb()
			}
			return
		}
		this._remain.value = remain
	}
}

/**
 * 创建倒计时。必须在 setup 内同步调用（内部依赖组件实例注册卸载清理）。
 */
export function useCountdown(options : NaxCountdownOptions) : NaxCountdownState {
	const state = new NaxCountdownState(options)
	if (getCurrentInstance() != null) {
		onUnmounted(() => {
			state.dispose()
		})
	}
	const auto = options.autostart
	if (auto == null || auto == true) {
		state.start()
	}
	return state
}
