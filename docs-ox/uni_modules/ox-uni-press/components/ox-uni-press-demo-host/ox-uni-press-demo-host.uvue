    </view>
    <view v-else-if="name === 'demo-toast'" class="ox-demo-stage" :style="stageStyle()">
      <demo-toast />
    </view>
    <view v-else-if="name === 'demo-upload'" class="ox-demo-stage" :style="stageStyle()">
      <demo-upload />
    </view>
    <view v-else-if="name === 'demo-virtual-list'" class="ox-demo-stage" :style="stageStyle()">
      <demo-virtual-list />
    </view>
    <view v-else class="ox-demo-missing" :style="missingStyle()">
      <text class="ox-demo-missing-name" :style="missingNameStyle()">未注册的 Demo 组件：{{ name }}</text>
      <text class="ox-demo-missing-hint" :style="missingHintStyle()">请在 ox-uni-press-demo-host 中注册该组件，或检查组件名拼写</text>
    </view>

  </view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { theme } from '../../utils/theme.uts'

const props = defineProps<{
  /** 注册组件名（demo 围栏第一段） */
  name: string
  /** 标量 props（内容侧传递，仅字符串/数字/布尔） */
  demoProps?: UTSJSONObject
}>()

const emit = defineEmits(['navigate'])


function numProp(key: string, fallback: number): number {
  if (props.demoProps == null) return fallback
  const v = props.demoProps[key]
  if (typeof v === 'number') return v
  return fallback
}

function strProp(key: string, fallback: string): string {
  if (props.demoProps == null) return fallback
  const v = props.demoProps[key]
  if (typeof v === 'string') return v
  return fallback
}


// ---- 样式（颜色走内联，随主题切换）----

function stageStyle(): UTSJSONObject {
  return {
    backgroundColor: theme.state.colors.surface,
    borderWidth: '1px',
    borderColor: theme.state.colors.border,
    borderStyle: 'solid',
    borderRadius: '12px',
    padding: '14px',
  } as UTSJSONObject
}

function missingStyle(): UTSJSONObject {
  return {
    backgroundColor: theme.state.colors.brandSoft,
    borderRadius: '12px',
    padding: '14px',
  } as UTSJSONObject
}

function missingNameStyle(): UTSJSONObject {
  return {
    fontSize: '14px',
    fontWeight: '600',
    color: theme.state.colors.danger,
    marginBottom: '4px',
  } as UTSJSONObject
}

function missingHintStyle(): UTSJSONObject {
  return { fontSize: '12px', color: theme.state.colors.text3 } as UTSJSONObject
}

</script>

<style>
.ox-demo-host {
  flex-direction: column;
  margin-bottom: 16px;
}

.ox-demo-stage {
  flex-direction: column;
}

/* nav-bar 等自带头尾背景的组件演示时抵消 stage 内边距 */
.ox-demo-stage-flush {
  padding-left: 0;
  padding-right: 0;
  overflow: hidden;
}

.ox-demo-missing {
  flex-direction: column;
}

.ox-demo-missing-name {
  flex-direction: column;
}

.ox-demo-missing-hint {
  flex-direction: column;
}


/* 演示排版辅助：颜色取 nax 主题变量，随站点深浅色联动 */
.ox-demo-row {
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
}

.ox-demo-mb {
  margin-bottom: 12px;
}

.ox-demo-mr {
  margin-right: 16px;
}

.ox-demo-panel {
  background-color: var(--nax-color-bg-secondary, #f2f3f5);
  border-radius: 8px;
  padding: 12px;
}

.ox-demo-panel-text {
  font-size: 13px;
  color: var(--nax-color-text, #333333);
}

.ox-demo-badge-box {
  width: 40px;
  height: 40px;
  border-radius: 8px;
  background-color: var(--nax-color-bg-secondary, #f2f3f5);
}

.ox-demo-card-text {
  font-size: 13px;
  color: var(--nax-color-text-secondary, #666666);
}

.ox-demo-grid-text {
  font-size: 12px;
  color: var(--nax-color-text-secondary, #666666);
  margin-top: 6px;
}

/* 按压反馈仅触屏端生效 */
/* #ifndef WEB */
.up-press {
  opacity: 0.7;
}
/* #endif */

</style>
