<template>
  <view class="ox-demo-host">
    <!-- 静态分发链：uni-app x 无动态组件，按名字用 v-if 分发。
         每个组件对应一个完整演示 wrapper（docs-site 演示页的同源分组），宿主可追加分支。 -->
    <view v-if="name === 'counter'" class="ox-demo-stage" :style="stageStyle()">
      <ox-demo-counter :start="numProp('start', 0)" :step="numProp('step', 1)" :title="strProp('title', '')" />
    </view>
    <view v-else-if="name === 'theme-swatch'" class="ox-demo-stage" :style="stageStyle()">
      <ox-demo-theme-swatch />
    </view>
    <view v-else-if="name === 'link-test'" class="ox-demo-stage" :style="stageStyle()">
      <ox-demo-link-test @navigate="emit('navigate', )" />
    </view>
    <view v-else-if="name === 'demo-action-sheet'" class="ox-demo-stage" :style="stageStyle()">
      <demo-action-sheet />
    </view>
    <view v-else-if="name === 'demo-alert'" class="ox-demo-stage" :style="stageStyle()">
      <demo-alert />
    </view>
    <view v-else-if="name === 'demo-avatar'" class="ox-demo-stage" :style="stageStyle()">
      <demo-avatar />
    </view>
    <view v-else-if="name === 'demo-badge'" class="ox-demo-stage" :style="stageStyle()">
      <demo-badge />
    </view>
    <view v-else-if="name === 'demo-button'" class="ox-demo-stage" :style="stageStyle()">
      <demo-button />
    </view>
    <view v-else-if="name === 'demo-calendar'" class="ox-demo-stage" :style="stageStyle()">
      <demo-calendar />
    </view>
