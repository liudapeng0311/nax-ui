    </view>
    <view v-else-if="name === 'demo-tabbar'" class="ox-demo-stage" :style="stageStyle()">
      <demo-tabbar />
    </view>
    <view v-else-if="name === 'demo-tabs'" class="ox-demo-stage" :style="stageStyle()">
      <demo-tabs />
