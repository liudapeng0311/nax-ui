    <view v-else-if="name === 'demo-checkbox'" class="ox-demo-stage" :style="stageStyle()">
      <demo-checkbox />
    </view>
    <view v-else-if="name === 'demo-date-strip'" class="ox-demo-stage" :style="stageStyle()">
      <demo-date-strip />
    </view>
    <view v-else-if="name === 'demo-datetime-picker'" class="ox-demo-stage" :style="stageStyle()">
      <demo-datetime-picker />
    </view>
    <view v-else-if="name === 'demo-dialog'" class="ox-demo-stage" :style="stageStyle()">
      <demo-dialog />
    </view>
    <view v-else-if="name === 'demo-divider'" class="ox-demo-stage" :style="stageStyle()">
      <demo-divider />
    </view>
    <view v-else-if="name === 'demo-dropdown'" class="ox-demo-stage" :style="stageStyle()">
      <demo-dropdown />
    </view>
    <view v-else-if="name === 'demo-empty'" class="ox-demo-stage" :style="stageStyle()">
      <demo-empty />
    </view>
    <view v-else-if="name === 'demo-form'" class="ox-demo-stage" :style="stageStyle()">
      <demo-form />
    </view>
    <view v-else-if="name === 'demo-grid'" class="ox-demo-stage" :style="stageStyle()">
      <demo-grid />
    </view>
    <view v-else-if="name === 'demo-icon'" class="ox-demo-stage" :style="stageStyle()">
      <demo-icon />
    </view>
    <view v-else-if="name === 'demo-image'" class="ox-demo-stage" :style="stageStyle()">
      <demo-image />
    </view>
    <view v-else-if="name === 'demo-input'" class="ox-demo-stage" :style="stageStyle()">
      <demo-input />
    </view>
    <view v-else-if="name === 'demo-keyboard'" class="ox-demo-stage" :style="stageStyle()">
      <demo-keyboard />
    </view>
    <view v-else-if="name === 'demo-line'" class="ox-demo-stage" :style="stageStyle()">
      <demo-line />
    </view>
    <view v-else-if="name === 'demo-list'" class="ox-demo-stage" :style="stageStyle()">
      <demo-list />
    </view>
    <view v-else-if="name === 'demo-loading'" class="ox-demo-stage" :style="stageStyle()">
      <demo-loading />
    </view>
    <view v-else-if="name === 'demo-nav-bar'" class="ox-demo-stage" :style="stageStyle()">
      <demo-nav-bar />
    </view>
    <view v-else-if="name === 'demo-notice-bar'" class="ox-demo-stage" :style="stageStyle()">
      <demo-notice-bar />
    </view>
    <view v-else-if="name === 'demo-number-box'" class="ox-demo-stage" :style="stageStyle()">
      <demo-number-box />
    </view>
    <view v-else-if="name === 'demo-overlay'" class="ox-demo-stage" :style="stageStyle()">
      <demo-overlay />
    </view>
    <view v-else-if="name === 'demo-picker'" class="ox-demo-stage" :style="stageStyle()">
      <demo-picker />
    </view>
    <view v-else-if="name === 'demo-popup'" class="ox-demo-stage" :style="stageStyle()">
      <demo-popup />
    </view>
    <view v-else-if="name === 'demo-progress'" class="ox-demo-stage" :style="stageStyle()">
      <demo-progress />
    </view>
    <view v-else-if="name === 'demo-radio'" class="ox-demo-stage" :style="stageStyle()">
      <demo-radio />
    </view>
    <view v-else-if="name === 'demo-rate'" class="ox-demo-stage" :style="stageStyle()">
      <demo-rate />
    </view>
    <view v-else-if="name === 'demo-rich-text'" class="ox-demo-stage" :style="stageStyle()">
      <demo-rich-text />
