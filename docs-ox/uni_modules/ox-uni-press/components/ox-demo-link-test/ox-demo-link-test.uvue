<template>
  <view class="ox-demo-linktest">
    <view class="ox-linktest-row">
      <input class="ox-linktest-input" :style="inputStyle()" v-model="url" placeholder="输入 / 开头的站内路径或外链" placeholder-style="color:#8b91a3;font-size:13px" />
      <view class="ox-linktest-btn" :style="btnStyle()" hover-class="ox-press" @click="open">
        <text class="ox-linktest-btn-text" :style="btnTextStyle()">打开</text>
      </view>
    </view>
    <text class="ox-linktest-hint" :style="hintStyle()">站内路径跳转文档；外链在 Web 端新窗口打开，App 端复制链接</text>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import { theme } from '../../utils/theme.uts'

const emit = defineEmits(['navigate'])

const url = ref('')

function open(): void {
  const link = url.value.trim()
  if (link === '') return
  if (link.startsWith('/')) {
    emit('navigate', link)
    return
  }
  // #ifdef WEB
  window.open(link, '_blank')
  // #endif
  // #ifndef WEB
  uni.setClipboardData({
    data: link,
    success: () => {
      uni.showToast({ title: '链接已复制', icon: 'none' } as ShowToastOptions)
    },
  } as SetClipboardDataOptions)
  // #endif
}

function inputStyle(): UTSJSONObject {
  return {
    flex: 1,
    height: '38px',
    fontSize: '13px',
    color: theme.state.colors.text1,
    borderWidth: '1px',
    borderColor: theme.state.colors.border,
    borderStyle: 'solid',
    borderRadius: '9px',
    paddingLeft: '12px',
    paddingRight: '12px',
  } as UTSJSONObject
}

function btnStyle(): UTSJSONObject {
  return {
    height: '38px',
    marginLeft: '8px',
    borderRadius: '9px',
    paddingLeft: '18px',
    paddingRight: '18px',
    justifyContent: 'center',
    alignItems: 'center',
    backgroundColor: theme.state.colors.brand,
  } as UTSJSONObject
}

function btnTextStyle(): UTSJSONObject {
  return { fontSize: '13px', fontWeight: '600', color: theme.state.colors.onBrand } as UTSJSONObject
}

function hintStyle(): UTSJSONObject {
  return { fontSize: '12px', color: theme.state.colors.text3, marginTop: '8px' } as UTSJSONObject
}
</script>

<style>
.ox-demo-linktest {
  flex-direction: column;
  padding-top: 4px;
  padding-bottom: 4px;
}

.ox-linktest-row {
  flex-direction: row;
  align-items: center;
}

.ox-linktest-input {
  flex-direction: row;
}

.ox-linktest-btn {
  flex-direction: row;
}

.ox-linktest-btn-text {
  flex-direction: column;
}

.ox-linktest-hint {
  flex-direction: column;
}

/* 按压反馈仅触屏端生效 */
/* #ifndef WEB */
.ox-press {
  opacity: 0.6;
}
/* #endif */

/* #ifdef WEB */
.ox-linktest-btn {
  cursor: pointer;
  user-select: none;
}
/* #endif */
</style>